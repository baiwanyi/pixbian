<!--
    设置页（M2）：管理媒体库扫描源与音乐库目录、执行索引、展开分类规则管理，以及配置主题与幻灯片播放。
    整体布局：内容块撑满外壳可用宽度、上限 960，居中由代码按可用宽度算对称 Margin 实现
    （见 SettingsPage.xaml.cs 的 OnContentViewportSizeChanged）——Stretch + MaxWidth 在超出上限后的
    摆放位置依赖框架的对齐细则，不可依赖；若直接写 Center，StackPanel 会收缩到内容自然宽，
    MaxWidth 形同虚设。
    页头（图标 + 标题）固定在滚动区之外、左对齐到页面（与图库页 HeaderGrid 同构），滚动时始终可见；
    下方内容区为独立的 ScrollViewer。注：内容块为 960 居中而页头贴页面左缘，二者左缘本就不对齐。
    分区由「标题 + 卡片」构成，两者包在一层 Spacing=8 的 StackPanel 内就近成组（组内紧），
    分区之间由外层 Spacing=20 叠加标题上边距 4 承担（组间松）；不逐分区调数值，
    避免 StackPanel 对「卡片到标题」与「标题到卡片」一视同仁、标题两侧等距而失去分组感。
    分区标题为 14 号无图标文字（BodyStrongTextBlockStyle），与 28 号的页头标题形成主次层级。
    分区内为 Win11 风格的行级卡片：每行由「图标 + 标题 + 副标题 + 右侧控件」构成，行间以分隔线断开；
    行内图标照常保留，无图标的行以等宽占位列保持文字左缘与标题行对齐。媒体库分区将图库与音乐库
    合并为单卡片：两个「位置」行以 Expander 承载、展开后内嵌路径列表，末行「刷新库」统一负责索引。
    视图模式与缩略图尺寸不在本页提供，改由图库页工具栏的「显示和大小」菜单调整，
    避免同一偏好存在两处入口、两处状态需要互相同步。
    分区卡片底色取 ThemeResource 的 CardBackgroundFillColorDefaultBrush：必须随主题反转，
    否则深色主题下白色正文会压在浅色卡片上不可读；页头为透明，直接压在窗口背景图上。
    局域网访问由开关即时启停，不设「保存」按钮：开关打开时直接显示端口与密码，
    输入框失焦时应用；端口未变且未输入新密码则跳过，避免无谓重建服务断开已连接客户端。
    开关的「开启 / 关闭」文字由开关**左侧**的独立 TextBlock 承载，而非行内副标题，
    也不用 ToggleSwitch 的 OffContent / OnContent——后者在模板内固定显示于开关右侧，
    主题资源无法改变列序。
    扫描源路径由用户在系统文件夹选择器中选取，不提供手工文本框输入，避免路径注入与拼写错误。
    分类管理以 Expander 卡片承载，展开时才装载分类页（DI 单例），避免启动即构建大列表。
-->
<Page
    x:Class="Pixbian.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Pixbian.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Pixbian.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- 设置页行级样式（SettingsRowStyle 等）已提升至 App.xaml 共享，跨页面复用。 -->
    </Page.Resources>

    <!-- 固定页头 + 可滚动内容两行：页头留在滚动区之外，滚动时标题始终可见。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ① 头部：图标 + 标题，左对齐到页面，与图库页的 HeaderGrid 同构。 -->
        <Grid
            Grid.Row="0"
            Margin="16"
            Padding="32,16"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1">
            <StackPanel
                MinHeight="32"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <FontIcon
                    Glyph="&#xE713;"
                    Style="{StaticResource PageHeaderIconStyle}"/>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="设置"/>
            </StackPanel>
        </Grid>

        <!-- 顶部内边距取 4：与页头的下外边距 16 相加，凑回原页头与首组之间 20 的间距。 -->
        <ScrollViewer
            Grid.Row="1"
            Padding="24,4,24,16"
            SizeChanged="OnContentViewportSizeChanged"
            VerticalScrollBarVisibility="Auto">
            <!-- 限宽居中由代码后置按视口宽计算对称 Margin（见 OnContentViewportSizeChanged），
                 不依赖框架对齐行为；MaxWidth 保留作为声明意图。 -->
            <StackPanel x:Name="ContentRoot"
                        MaxWidth="960"
                        Spacing="20">

                <!-- ② 媒体库：图库扫描源与音乐库目录合并进同一张卡片，行结构参照 Windows
                     照片应用的「库」设置——「位置」行以 Expander 承载、展开后内嵌路径列表，
                     末行统一负责刷新。两者数据通路相互独立：图库扫描源入库 media_items
                     并参与索引；音乐目录只落 music_tracks 表而不进 media_items，
                     仅作为短片页在视频无音轨时的背景音乐候选池。 -->
                <StackPanel Spacing="8">
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="媒体库"/>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>

                            <!-- 行：图库位置。默认收起，展开后内嵌扫描源列表。
                                 Expander 融入外层卡片的资源覆盖与「端口与密码」展开区同构：
                                 边框归零、底色透明，展开箭头是唯一的可展开视觉提示。
                                 列表禁用自身滚动，交给外层 ScrollViewer 统一滚动，
                                 避免嵌套滚动容器在列表边缘抢走滚轮事件。 -->
                            <!-- Padding 本地值归零：样式 Setter 的内容 Padding 是 StaticResource
                                 （generic.xaml 加载时一次性解析），实例级资源覆盖无法穿透，只能本地值压过；
                                 Header 的 ToggleButton 内边距在 Loaded 后经视觉树归零（见代码后置）。
                                 箭头区 Margin 是 ThemeResource（可穿透覆盖）：左距默认 20 收窄为 8，
                                 即「添加文件夹」按钮与展开箭头的间距。 -->
                            <Expander
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0"
                                Loaded="OnLibraryExpanderLoaded">
                                <Expander.Resources>
                                    <Thickness x:Key="ExpanderBorderThickness">0</Thickness>
                                    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                    <Thickness x:Key="ExpanderChevronMargin">8,0,8,0</Thickness>
                                    <StaticResource x:Key="ExpanderBorderBrush"
                                                    ResourceKey="SubtleFillColorTransparentBrush"/>
                                    <StaticResource x:Key="ExpanderHeaderBorderBrush"
                                                    ResourceKey="SubtleFillColorTransparentBrush"/>
                                    <StaticResource x:Key="ExpanderContentBorderBrush"
                                                    ResourceKey="SubtleFillColorTransparentBrush"/>
                                    <StaticResource x:Key="ExpanderHeaderBackground"
                                                    ResourceKey="SubtleFillColorTransparentBrush"/>
                                    <StaticResource x:Key="ExpanderContentBackground"
                                                    ResourceKey="SubtleFillColorTransparentBrush"/>
                                </Expander.Resources>
                                <Expander.Header>
                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 空心文件夹 ED25 -->
                                        <FontIcon
                                            Grid.Column="0"
                                            Glyph="&#xED25;"
                                            Style="{StaticResource SettingsRowIconStyle}"/>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="图库位置"/>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.FolderCountText, Mode=OneWay}"/>
                                        </StackPanel>

                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="添加文件夹"
                                            Click="OnAddFolderClick"
                                            Content="添加文件夹"/>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                    <ListView
                                        MinHeight="60"
                                        ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        SelectionMode="None">
                                        <ListView.ItemContainerStyle>
                                            <!-- 默认容器 Padding 16,0,12,0（字面量，经模板 ContentMargin 生效）
                                                 会让条目内容比 Header 缩进一倍，归零后左缘对齐；
                                                 MinHeight 同步覆盖为 24（默认 44），压缩条目行距。 -->
                                            <Style TargetType="ListViewItem"
                                                    BasedOn="{StaticResource DefaultListViewItemStyle}">
                                                <Setter Property="Padding"
                                                        Value="0"/>
                                                <Setter Property="MinHeight"
                                                        Value="24"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:LibraryFolderRow">
                                                <Grid
                                                    Padding="24,12"
                                                    ColumnSpacing="12"
                                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                    BorderThickness="0,1,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 目录路径入库后不再变化，OneTime 即可。 -->
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource BodyTextBlockStyle}"
                                                        Text="{x:Bind Path, Mode=OneTime}"
                                                        TextTrimming="CharacterEllipsis"/>

                                                    <!-- × 移除：与原「移除」按钮同一事件通路，二次确认后生效。 -->
                                                    <Button
                                                        Grid.Column="1"
                                                        Padding="6"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="移除"
                                                        Click="OnRemoveFolderClick"
                                                        Tag="{x:Bind}">
                                                        <FontIcon
                                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                            FontSize="12"
                                                            Glyph="&#xE711;"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Expander>

                            <Border
                                Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- 行：音乐库位置。副标题直接承载动态状态文字（扫描结果 / 目录计数）。
                                 Padding、ChevronMargin 与 Loaded 的处理同上图库位置行。 -->
                            <Expander
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0"
                                Loaded="OnLibraryExpanderLoaded">
                                <Expander.Resources>
                                    <Thickness x:Key="ExpanderBorderThickness">0</Thickness>
                                    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                    <Thickness x:Key="ExpanderChevronMargin">8,0,8,0</Thickness>
                                    <StaticResource x:Key="ExpanderBorderBrush"
                                                    ResourceKey="SubtleFillColorTransparentBrush"/>
                                    <StaticResource x:Key="ExpanderHeaderBorderBrush"
                                                    ResourceKey="SubtleFillColorTransparentBrush"/>
                                    <StaticResource x:Key="ExpanderContentBorderBrush"
                                                    ResourceKey="SubtleFillColorTransparentBrush"/>
                                    <StaticResource x:Key="ExpanderHeaderBackground"
                                                    ResourceKey="SubtleFillColorTransparentBrush"/>
                                    <StaticResource x:Key="ExpanderContentBackground"
                                                    ResourceKey="SubtleFillColorTransparentBrush"/>
                                </Expander.Resources>
                                <Expander.Header>
                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 空心文件夹 ED25：与图库位置行统一。 -->
                                        <FontIcon
                                            Grid.Column="0"
                                            Glyph="&#xED25;"
                                            Style="{StaticResource SettingsRowIconStyle}"/>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="音乐库位置"/>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.MusicStatusText, Mode=OneWay}"/>
                                        </StackPanel>

                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="添加音乐文件夹"
                                            Click="OnAddMusicFolderClick"
                                            Content="添加文件夹"/>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                    <ListView
                                        MinHeight="60"
                                        ItemsSource="{x:Bind ViewModel.MusicFolders, Mode=OneWay}"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        SelectionMode="None">
                                        <ListView.ItemContainerStyle>
                                            <!-- 同图库列表：归零默认容器 Padding，条目左缘与 Header 对齐；
                                                 MinHeight 同步覆盖为 24（默认 44），压缩条目行距。 -->
                                            <Style TargetType="ListViewItem"
                                                    BasedOn="{StaticResource DefaultListViewItemStyle}">
                                                <Setter Property="Padding"
                                                        Value="0"/>
                                                <Setter Property="MinHeight"
                                                        Value="24"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:MusicFolderRow">
                                                <Grid
                                                    Padding="24,12"
                                                    ColumnSpacing="12"
                                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                    BorderThickness="0,1,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!--
                                                        目录路径入库后不再变化，OneTime 即可。
                                                        MusicFolderRow 未实现属性通知（图库行的 LibraryFolderRow 有），
                                                        此处写 OneWay 会触发 WMC1506：OneWay 要求绑定链上至少一步可发通知。
                                                    -->
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource BodyTextBlockStyle}"
                                                        Text="{x:Bind Path, Mode=OneTime}"
                                                        TextTrimming="CharacterEllipsis"/>

                                                    <Button
                                                        Grid.Column="1"
                                                        Padding="6"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="移除"
                                                        Click="OnRemoveMusicFolderClick"
                                                        Tag="{x:Bind}">
                                                        <FontIcon
                                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                            FontSize="12"
                                                            Glyph="&#xE711;"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Expander>

                            <Border
                                Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- 行：刷新库。对全部启用的图库扫描源执行索引；
                                 副标题默认显示上次建立索引的时间，索引进行中跟随进度文字。 -->
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 刷新 E72C -->
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE72C;"
                                    Style="{StaticResource SettingsRowIconStyle}"/>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="刷新库"/>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <ProgressRing
                                            Width="16"
                                            Height="16"
                                            IsActive="{x:Bind ViewModel.IsIndexing, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.IsIndexing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.IndexLineText, Mode=OneWay}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Click="OnStartIndexingClick"
                                    Content="立即索引"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ④ 分类：组标题 + 分类页卡片，与媒体库组同构；分类页自带三行卡片
                     （分类管理 / 规则管理 / 重新匹配），装载时机与普通组一致。 -->
                <StackPanel Spacing="8">
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="分类"/>

                    <ContentControl
                        x:Name="CategoryHost"
                        HorizontalContentAlignment="Stretch"/>
                </StackPanel>

                <!-- ⑤ 个性化 -->
                <StackPanel Spacing="8">
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="个性化"/>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>

                            <!-- 行：应用主题。选项顺序与 AppTheme 枚举一致（跟随系统 / 浅色 / 深色）。 -->
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 亮度 E790 -->
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE790;"
                                    Style="{StaticResource SettingsRowIconStyle}"/>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="应用主题"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="选择要显示的应用主题"/>
                                </StackPanel>

                                <ComboBox
                                    x:Name="ThemeSelector"
                                    Grid.Column="2"
                                    MinWidth="140"
                                    VerticalAlignment="Center"
                                    SelectedIndex="{x:Bind ThemeIndex, Mode=TwoWay}"
                                    SelectionChanged="OnThemeSelectionChanged">
                                    <ComboBoxItem Content="跟随系统"/>
                                    <ComboBoxItem Content="浅色"/>
                                    <ComboBoxItem Content="深色"/>
                                </ComboBox>
                            </Grid>

                            <Border
                                Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- 行：鼠标滚轮。选项顺序与 ViewerWheelMode 枚举一致（放大或缩小 / 查看上一项或下一项）。 -->
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 鼠标 E962 -->
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE962;"
                                    Style="{StaticResource SettingsRowIconStyle}"/>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="鼠标滚轮"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="查看单个文件时选择滚轮行为（注意：Ctrl + 鼠标滚轮始终放大或缩小）"
                                        TextWrapping="Wrap"/>
                                </StackPanel>

                                <ComboBox
                                    x:Name="WheelModeSelector"
                                    Grid.Column="2"
                                    MinWidth="140"
                                    VerticalAlignment="Center"
                                    SelectedIndex="{x:Bind WheelModeIndex, Mode=TwoWay}"
                                    SelectionChanged="OnWheelModeSelectionChanged">
                                    <ComboBoxItem Content="放大或缩小"/>
                                    <ComboBoxItem Content="查看上一项或下一项"/>
                                </ComboBox>
                            </Grid>

                            <Border
                                Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- 行：缩放首选项。选项顺序与 ViewerInitialZoom 枚举一致（缩放以适应窗口 / 按实际大小查看）。 -->
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 图片 E8B9 -->
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE8B9;"
                                    Style="{StaticResource SettingsRowIconStyle}"/>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="缩放首选项"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="打开图片时的初始缩放方式（适应窗口 / 100% 实际像素）"/>
                                </StackPanel>

                                <ComboBox
                                    x:Name="InitialZoomSelector"
                                    Grid.Column="2"
                                    MinWidth="140"
                                    VerticalAlignment="Center"
                                    SelectedIndex="{x:Bind InitialZoomIndex, Mode=TwoWay}"
                                    SelectionChanged="OnInitialZoomSelectionChanged">
                                    <ComboBoxItem Content="缩放以适应窗口"/>
                                    <ComboBoxItem Content="按实际大小查看"/>
                                </ComboBox>
                            </Grid>

                            <Border
                                Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- 行：背景音乐。选项顺序与 BackgroundMusicMode 枚举一致（静音 / 混合 / 音乐库）。
                                 仅在幻灯片放映开启「静音播放」时生效。 -->
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 音乐 E8D6 -->
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE8D6;"
                                    Style="{StaticResource SettingsRowIconStyle}"/>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="背景音乐"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="放映时音乐库曲目的使用方式；需先在幻灯片区开启「音乐播放」"
                                        TextWrapping="Wrap"/>
                                </StackPanel>

                                <ComboBox
                                    x:Name="BackgroundMusicSelector"
                                    Grid.Column="2"
                                    MinWidth="140"
                                    VerticalAlignment="Center"
                                    SelectedIndex="{x:Bind BackgroundMusicIndex, Mode=TwoWay}"
                                    SelectionChanged="OnBackgroundMusicSelectionChanged">
                                    <ComboBoxItem Content="静音"/>
                                    <ComboBoxItem Content="混合"/>
                                    <ComboBoxItem Content="音乐库"/>
                                </ComboBox>
                            </Grid>

                            <Border
                                Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- 行：背景音乐音量。0–100 百分比呈现，落盘为 0–1。 -->
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 音量 E767 -->
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE767;"
                                    Style="{StaticResource SettingsRowIconStyle}"/>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="背景音乐音量"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="背景音乐的播放响度（0–100）"/>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Slider
                                        x:Name="BgmVolumeSlider"
                                        Width="160"
                                        Maximum="100"
                                        Minimum="0"
                                        SmallChange="5"
                                        StepFrequency="5"
                                        ValueChanged="OnBgmVolumeValueChanged"/>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind BgmVolumeText, Mode=OneWay}"/>
                                </StackPanel>
                            </Grid>

                            <Border
                                Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- 行：片段区间。仅幻灯片「完整视频」关闭时生效；
                                 两个输入框互相钳制（最小 ≤ 最大），最小下限 10、最大上限 120。 -->
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 时长 E823 -->
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE823;"
                                    Style="{StaticResource SettingsRowIconStyle}"/>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="片段区间"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="视频片段的时长上限：片段长度在更小档位与该值间随机，起点随机；超过 1 分钟的视频从 20 秒后起播，视频不够长时整段播放"
                                        TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <ComboBox
                                        x:Name="ClipPresetSelector"
                                        MinWidth="140"
                                        SelectedIndex="{x:Bind ClipPresetIndex, Mode=TwoWay}"
                                        SelectionChanged="OnClipPresetSelectionChanged">
                                        <ComboBoxItem Content="10 秒"/>
                                        <ComboBoxItem Content="30 秒"/>
                                        <ComboBoxItem Content="60 秒"/>
                                        <ComboBoxItem Content="90 秒"/>
                                        <ComboBoxItem Content="120 秒"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ⑥ 幻灯片：独立成区，与「个性化」的主题设置分开，便于集中调整放映行为。 -->
                <StackPanel Spacing="8">
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="幻灯片"/>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>

                            <!-- 行：幻灯片间隔。单位并入标题（NumberBox 无单位后缀属性）。 -->
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 时钟 E916 -->
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE916;"
                                    Style="{StaticResource SettingsRowIconStyle}"/>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="幻灯片间隔"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="每张图片显示的时长，到点自动切换到下一张"/>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <ComboBox
                                        x:Name="SlideIntervalSelector"
                                        MinWidth="140"
                                        SelectedIndex="{x:Bind SlideIntervalIndex, Mode=TwoWay}"
                                        SelectionChanged="OnSlideIntervalSelectionChanged">
                                        <ComboBoxItem Content="1 秒"/>
                                        <ComboBoxItem Content="3 秒"/>
                                        <ComboBoxItem Content="5 秒"/>
                                        <ComboBoxItem Content="10 秒"/>
                                        <ComboBoxItem Content="20 秒"/>
                                        <ComboBoxItem Content="30 秒"/>
                                        <ComboBoxItem Content="60 秒"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Border
                                Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- 行：播放顺序。选项顺序与 SlideShowPlayOrder 枚举一致（列表 / 随机）。 -->
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 随机播放 E8B1 -->
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE8B1;"
                                    Style="{StaticResource SettingsRowIconStyle}"/>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="播放顺序"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="列表：按序播放，播完退出；随机：随机不重复，无限循环；循环：按序播放，无限循环"/>
                                </StackPanel>

                                <ComboBox
                                    x:Name="PlayOrderSelector"
                                    Grid.Column="2"
                                    MinWidth="140"
                                    VerticalAlignment="Center"
                                    SelectedIndex="{x:Bind PlayOrderIndex, Mode=TwoWay}"
                                    SelectionChanged="OnPlayOrderSelectionChanged">
                                    <ComboBoxItem Content="列表"/>
                                    <ComboBoxItem Content="随机"/>
                                    <ComboBoxItem Content="循环"/>
                                </ComboBox>
                            </Grid>

                            <Border
                                Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- 行：切换模式。选项顺序与 SlideShowTransitionMode 枚举一致（滑动 / 淡出 / 溶解）。 -->
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 幻灯片 E786：与图库页工具栏播放按钮同源。 -->
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE786;"
                                    Style="{StaticResource SettingsRowIconStyle}"/>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="切换模式"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="切换到下一张时的过渡效果（滑动 / 淡出 / 溶解）"/>
                                </StackPanel>

                                <ComboBox
                                    x:Name="TransitionSelector"
                                    Grid.Column="2"
                                    MinWidth="140"
                                    VerticalAlignment="Center"
                                    SelectedIndex="{x:Bind TransitionIndex, Mode=TwoWay}"
                                    SelectionChanged="OnTransitionSelectionChanged">
                                    <ComboBoxItem Content="滑动"/>
                                    <ComboBoxItem Content="淡出"/>
                                    <ComboBoxItem Content="溶解"/>
                                </ComboBox>
                            </Grid>

                            <Border
                                Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- 行：动画效果。开启动画后每张照片随机一种缓慢的 Ken Burns 运动。 -->
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 缩放 E71F -->
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE71F;"
                                    Style="{StaticResource SettingsRowIconStyle}"/>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="动画效果"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="开启后每张照片随机应用缓慢的放大、缩小或左右平移；视频不生效"
                                        TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <!--  状态文字由代码后置直接赋值：x:Bind 通知在开关交互路径上不可靠  -->
                                    <TextBlock
                                        x:Name="AnimationStateLabel"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <ToggleSwitch
                                        x:Name="AnimationToggle"
                                        MinWidth="0"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="OnAnimationToggled"/>
                                </StackPanel>
                            </Grid>

                            <Border
                                Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- 行：背景虚化。开启时以当前照片的缩略图放大铺满作舞台背景，视频条目退化为纯黑。 -->
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 照片 E8B9 -->
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE8B9;"
                                    Style="{StaticResource SettingsRowIconStyle}"/>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="背景虚化"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="以当前照片的虚化放大图填充画面外的区域；关闭则为纯黑背景"
                                        TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <!--  状态文字由代码后置直接赋值：x:Bind 通知在开关交互路径上不可靠  -->
                                    <TextBlock
                                        x:Name="BlurBackdropStateLabel"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <ToggleSwitch
                                        x:Name="BlurBackdropToggle"
                                        MinWidth="0"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="OnBlurBackdropToggled"/>
                                </StackPanel>
                            </Grid>

                            <Border
                                Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- 行：完整视频。开启时视频播放完整内容后切换；关闭时按「片段区间」截取播放。 -->
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 视频 E8B2 -->
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE8B2;"
                                    Style="{StaticResource SettingsRowIconStyle}"/>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="完整视频"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="开启：播放完整视频；关闭：按「个性化-片段区间」截取片段播放"/>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <!--  状态文字由代码后置直接赋值：x:Bind 通知在开关交互路径上不可靠  -->
                                    <TextBlock
                                        x:Name="FullVideoStateLabel"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <ToggleSwitch
                                        x:Name="IncludeVideosToggle"
                                        MinWidth="0"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="OnFullVideoToggled"/>
                                </StackPanel>
                            </Grid>

                            <Border
                                Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- 行：音乐播放。开启后按「个性化-背景音乐」的模式处理放映音频；
                                 关闭时放映完全无声（含视频原声）。 -->
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 音量 E767 -->
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE767;"
                                    Style="{StaticResource SettingsRowIconStyle}"/>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="音乐播放"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="开启：按「个性化-背景音乐」的模式播放；关闭：放映完全无声（含视频原声）"
                                        TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <!--  状态文字由代码后置直接赋值：x:Bind 通知在开关交互路径上不可靠  -->
                                    <TextBlock
                                        x:Name="SilentPlaybackStateLabel"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <ToggleSwitch
                                        x:Name="VideoMutedToggle"
                                        MinWidth="0"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="OnVideoMutedToggled"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ⑦ 局域网访问 -->
                <StackPanel Spacing="8">
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="局域网访问"/>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>

                            <!-- 行：总开关。与其他行完全同构（三列 + SettingsRowStyle 统一内边距 16,12）。
                                 ToggleSwitch 必须保留 MinWidth="0"：默认 MinWidth=154px 会在控件
                                 右侧留 ~114px 模板空白，开关视觉永远偏左且挤压同行文字。
                                 OffContent/OnContent 显式清空杜绝默认占位文本；
                                 状态文字（开/关）置于开关左侧——模板自带标签位固定在开关右侧故不用。 -->
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 网络 E968 -->
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE968;"
                                    Style="{StaticResource SettingsRowIconStyle}"/>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="允许局域网访问"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="局域网内设备可通过浏览器浏览与播放"/>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind WebSharingStateText, Mode=OneWay}"/>
                                    <ToggleSwitch
                                        x:Name="WebSharingToggle"
                                        MinWidth="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="OnWebSharingToggled"/>
                                </StackPanel>
                            </Grid>
                            <!-- 分隔线：仅在局域网开关打开时出现，避免关闭状态下卡片底部残留一条孤立的线。 -->
                            <Border
                                Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Visibility="{x:Bind IsWebSharingOn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>

                            <!-- 端口与访问密码：仅在开关打开时直接显示（无展开区），与开关行共用同一张卡片。
                                 Border 只能有一个 Child，故开关行 / 分隔线 / 本区块必须一并封在外层
                                 StackPanel 内，不可直接并列在 Border 下。
                                 输入框失焦即应用（替代「保存」按钮），端口未变且未输入新密码则跳过；
                                 端口与密码各占一行且不带图标。 -->
                            <StackPanel
                                Visibility="{x:Bind IsWebSharingOn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

                                <!-- 行：端口 -->
                                <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1"
                                      Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="端口"/>

                                    <TextBox
                                        x:Name="WebPortBox"
                                        Grid.Column="1"
                                        PlaceholderText="1024 至 65535"
                                        Width="160"
                                        LostFocus="OnWebSettingLostFocus"/>
                                </Grid>

                                <!-- 行：访问密码 -->
                                <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1"
                                      Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="访问密码"/>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="留空则沿用旧密码"/>
                                    </StackPanel>

                                    <PasswordBox
                                        x:Name="WebPasswordBox"
                                        Grid.Column="1"
                                        PlaceholderText="输入新密码"
                                        Width="180"
                                        LostFocus="OnWebSettingLostFocus"/>
                                </Grid>

                                <!-- 服务状态与访问地址同行：地址渲染为链接，点击用默认浏览器打开。
                                     显式走 Click + ShellExecute，不依赖 NavigateUri 的桌面行为。 -->
                                <StackPanel
                                    Margin="16"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.WebStatusText, Mode=OneWay}"/>
                                    <ItemsControl
                                        VerticalAlignment="Center"
                                        ItemsSource="{x:Bind ViewModel.WebAccessUrls, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                        Spacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <HyperlinkButton
                                                    Padding="4,2"
                                                    Click="OnWebAccessUrlClick"
                                                    Content="{x:Bind}"
                                                    Tag="{x:Bind}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ⑧ 关于 -->
                <StackPanel Spacing="8">
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="关于"/>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>

                            <!-- 行：应用 -->
                            <Grid Style="{StaticResource SettingsRowStyle}">
