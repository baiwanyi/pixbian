<!--
    图片查看器（Lightbox）：由独立无边框窗口（ImageViewerWindow）承载，主窗口保持原样；
    窗口铺满所在显示器完整分辨率，背景为 DesktopAcrylic 毛玻璃（近似透出桌面）。
    根层保持透明以露出亚克力；图像铺满视口并 Stretch=Uniform 自适应，
    缩放（以光标为锚）、旋转与拖动平移由 ImageHost 的 TransformGroup 承担
    （声明顺序必须为 Translate→Rotate→Scale，平移才是屏幕空间语义；
    RenderTransformOrigin 让缩放与旋转绕视口中心）。
    图像分「当前图」与「旧图」两层：切换条目时旧图留存到转场动画播完；转场动画
    （滑动 / 淡出）与首图入场动画（渐入 + 90%→100%）均由代码后置现场创建。
    底部浮动工具栏默认隐藏，点击图像显示，3 秒无操作自动淡出；点击空白处关闭查看器，
    关闭前内容整体淡出。
    除工具栏深底外颜色均取自 ThemeResource，深浅主题切换时自动生效。
    窗口根元素不是 FrameworkElement，故一律使用传统 Binding。
-->
<Page
    x:Class="Pixbian.Views.ImageViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        窗口根层：保持透明以露出窗口的 DesktopAcrylic 毛玻璃背景（近似透出桌面）；
        本层不得设不透明背景，否则会完全盖住亚克力使其失效。
        关闭查看器时本层整体淡出（露出纯毛玻璃）后再关闭窗口。
    -->
    <Grid x:Name="RootLayer">

        <!--
            图像交互层：接收滚轮/拖动/双击等指针输入。
            RenderTransformOrigin 使旋转与缩放绕视口中心；TransformGroup 中平移声明在最前，
            经 origin 包装后平移保持屏幕空间语义，zoom-to-cursor 与拖动的坐标公式依赖该顺序。
        -->
        <Grid
            x:Name="ImageHost"
            Background="Transparent"
            DoubleTapped="OnImageHostDoubleTapped"
            PointerCaptureLost="OnImageHostPointerCaptureLost"
            PointerMoved="OnImageHostPointerMoved"
            PointerPressed="OnImageHostPointerPressed"
            PointerReleased="OnImageHostPointerReleased"
            PointerWheelChanged="OnImageHostPointerWheelChanged"
            RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="PanTransform"/>
                    <RotateTransform
                        x:Name="RotationTransform"
                        Angle="{Binding RotationDegrees}"/>
                    <ScaleTransform
                        x:Name="ZoomTransform"
                        ScaleX="{Binding Zoom}"
                        ScaleY="{Binding Zoom}"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!--  首图入场动画（90%→100% + 淡入）的独立缩放层，与交互缩放分层互不干扰  -->
            <Grid x:Name="EntryScaleHost"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="EntryScaleTransform"/>
                </Grid.RenderTransform>

                <!--  双层图像：切换条目时旧图留存到转场动画播完，新图解码期间不闪背景  -->
                <Image
                    x:Name="PreviousImageElement"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Source="{Binding PreviousImage}"
                    Stretch="Uniform">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="PreviousImageTransform"/>
                    </Image.RenderTransform>
                </Image>

                <Image
                    x:Name="DisplayImageElement"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Source="{Binding DisplayImage}"
                    Stretch="Uniform">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="DisplayImageTransform"/>
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </Grid>

        <!--  无法加载时的提示；显隐由代码后置控制，加载期间静默（避免打开时闪现）  -->
        <StackPanel
            x:Name="FailedHint"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="40"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xEB9F;"/>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="无法加载该图片"/>
        </StackPanel>

        <!--
            底部浮动工具栏：深色半透明底在深浅主题下均成立，文字固定白色。
            默认隐藏（Opacity=0 且不可命中），点击图像显示，3 秒无操作自动淡出。
            按钮用普通 Button/ToggleButton + SymbolIcon（本版本 WinUI 的 AppBarButton
            无 DefaultLabelPosition，其 Label 在浮动栏中过高）；主题键在 Border.Resources
            元素级覆盖，统一深底上的白前景与悬停/按下/选中反馈，一处生效于全部按钮。
        -->
        <Border
            x:Name="ToolbarRoot"
            Margin="0,0,0,28"
            Padding="12,4"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#AA000000"
            CornerRadius="8"
            IsHitTestVisible="False"
            Opacity="0"
            PointerEntered="OnToolbarPointerEntered"
            PointerExited="OnToolbarPointerExited">
            <Border.Resources>
                <!--  按钮常态前景：白色（深色半透明工具栏底上保证可读）  -->
                <SolidColorBrush x:Key="ButtonForeground"
                                 Color="#FFFFFF"/>
                <!--  悬停前景：保持白色，反馈由背景薄层承担  -->
                <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                 Color="#FFFFFF"/>
                <!--  按下前景：保持白色  -->
                <SolidColorBrush x:Key="ButtonForegroundPressed"
                                 Color="#FFFFFF"/>
                <!--  悬停背景：15% 白薄层（深底上的提亮反馈）  -->
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                 Color="#26FFFFFF"/>
                <!--  按下背景：与悬停同色（15% 白）  -->
                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                 Color="#26FFFFFF"/>
                <!--  禁用背景：无背景（命令不可用如首张的「上一张」，仅以图标淡出表达）  -->
                <SolidColorBrush x:Key="ButtonBackgroundDisabled"
                                 Color="Transparent"/>
                <!--  禁用前景：15% 白（弱化但不消失，与深底风格一致）  -->
                <SolidColorBrush x:Key="ButtonForegroundDisabled"
                                 Color="#26FFFFFF"/>
            </Border.Resources>
            <StackPanel Orientation="Horizontal"
                        Spacing="2">

                <Button
                    Command="{Binding GoPreviousCommand}"
                    Style="{StaticResource ViewerToolButtonStyle}"
                    ToolTipService.ToolTip="上一张（←）">
                    <SymbolIcon Symbol="Back"/>
                </Button>
                <Button
                    Command="{Binding GoNextCommand}"
                    Style="{StaticResource ViewerToolButtonStyle}"
                    ToolTipService.ToolTip="下一张（→）">
                    <SymbolIcon Symbol="Forward"/>
                </Button>

                <Border
                    Width="1"
                    Height="20"
                    Margin="4,0"
                    Background="#26FFFFFF"/>

                <Button
                    Command="{Binding ZoomOutCommand}"
                    Style="{StaticResource ViewerToolButtonStyle}"
                    ToolTipService.ToolTip="缩小">
                    <SymbolIcon Symbol="ZoomOut"/>
                </Button>
                <Button
                    Command="{Binding ZoomInCommand}"
                    Style="{StaticResource ViewerToolButtonStyle}"
                    ToolTipService.ToolTip="放大">
                    <SymbolIcon Symbol="ZoomIn"/>
                </Button>

                <Border
                    Width="1"
                    Height="20"
                    Margin="4,0"
                    Background="#26FFFFFF"/>

                <Button
                    Command="{Binding RotateLeftCommand}"
                    Style="{StaticResource ViewerToolButtonStyle}"
                    ToolTipService.ToolTip="向左旋转">
                    <FontIcon Glyph="&#xE80C;"/>
                </Button>
                <Button
                    Click="OnRotateRightClick"
                    Style="{StaticResource ViewerToolButtonStyle}"
                    ToolTipService.ToolTip="向右旋转">
                    <FontIcon Glyph="&#xE80D;"/>
                </Button>

                <Border
                    Width="1"
                    Height="20"
                    Margin="4,0"
                    Background="#26FFFFFF"/>

                <Button
                    x:Name="SlideShowHandoffButton"
                    Command="{Binding HandoffSlideShowCommand}"
                    Style="{StaticResource ViewerToolButtonStyle}"
                    ToolTipService.ToolTip="幻灯片放映">
                    <FontIcon Glyph="&#xE786;"/>
                </Button>

                <Border
                    Width="1"
                    Height="20"
                    Margin="4,0"
                    Background="#26FFFFFF"/>

                <TextBlock
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Foreground="#FFFFFF"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding PositionText}"/>
                <TextBlock
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Foreground="#CCFFFFFF"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding ZoomText}"/>

                <Border
                    Width="1"
                    Height="20"
                    Margin="4,0"
                    Background="#26FFFFFF"/>

                <Button
                    Command="{Binding ResetZoomCommand}"
                    Style="{StaticResource ViewerToolButtonStyle}"
                    ToolTipService.ToolTip="适应窗口">
                    <FontIcon Glyph="&#xE9A6;"/>
                </Button>
            </StackPanel>
        </Border>

        <!--
            关闭按钮：常驻屏幕右上角（不随工具栏显隐），48x48，上/右间距 12。
            按钮不在 ToolbarRoot 之内，深底白字的悬停/按下反馈经自身 Resources 覆盖主题键。
        -->
        <Button
            Click="OnCloseClick"
            Width="48"
            Height="48"
            Margin="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            BorderThickness="0"
            Background="Transparent"
            ToolTipService.ToolTip="关闭（Esc）">
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonForeground"
                                 Color="#40FFFFFF"/>
                <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                 Color="#80FFFFFF"/>
                <SolidColorBrush x:Key="ButtonForegroundPressed"
                                 Color="#FFFFFF"/>
                <SolidColorBrush x:Key="ButtonBackground"
                                 Color="Transparent"/>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                 Color="#26FFFFFF"/>
                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                 Color="#40FFFFFF"/>
            </Button.Resources>
            <FontIcon FontSize="16"
                      Glyph="&#xE8BB;"/>
        </Button>
    </Grid>
</Page>
