<!--
    主窗口（M2）：标题栏 + 三栏布局外壳。
    顶栏为自定义标题栏：中央搜索框与右侧导入 / 设置按钮为交互控件，经 InputNonClientPointerSource
    放行指针事件，其余区域作为系统拖拽区；最右侧 140px 预留给窗口控制按钮。
    左侧 NavigationView 负责导航，中间承载各功能页面，右侧为详情面板。
    页面实例由依赖注入在窗口构造时创建并以 Visibility 切换，
    避免 Frame 导航在参数传递时视图模型尚未就绪导致 x:Bind 求值失败。
    所有颜色均取自 ThemeResource，深浅主题切换时自动生效。
-->
<Window
    x:Class="Pixbian.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Pixbian.Converters"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Pixbian">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏行：交互控件之外的区域均为系统拖拽区；背景取自定义栏配色，随深浅主题切换 -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="{ThemeResource PixbianPaneBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <FontIcon FontSize="16" Glyph="&#xEB9F;" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="照片" />
            </StackPanel>

            <!--
                搜索框：宽度随窗口缩放，但不超过 720px；最大化时约 720px。
                无搜索图标、无阴影、四边 1px 边框、圆角 4。
                边框色覆盖默认的 TextControlElevationBorderBrush（底部 45% 黑的竖向渐变），
                统一为纯色描边；静止态用一级描边（极淡），鼠标悬停时加深到二级描边，
                避免悬停无视觉反馈、也避免静止态过重。
            -->
            <Grid
                Grid.Column="1"
                MaxWidth="720"
                Margin="24,0,24,0">
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="{ThemeResource TextControlBackground}"
                    BorderBrush="{ThemeResource TextControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    PlaceholderText="{x:Bind SearchPlaceholder, Mode=OneWay}"
                    QuerySubmitted="OnSearchSubmitted"
                    TextChanged="OnSearchTextChanged">
                    <AutoSuggestBox.Resources>
                        <!--
                            默认的 TextControlBorderBrush 系列均指向 TextControlElevationBorderBrush：
                            2px 高的竖向渐变，翻转后底部为 #72000000（45% 黑）、顶部为 #0F000000（6% 黑）。
                            这里全部覆盖为纯色描边，四边一致且随主题切换。
                            键名与视觉状态的对应关系见 generic.xaml：
                            Normal(16106) 用 TextControlBorderBrush，PointerOver(16108) 用 …PointerOver。
                        -->

                        <!-- 静止态：一级描边，浅色 #0F000000 / 深色 #12FFFFFF。 -->
                        <StaticResource
                            x:Key="TextControlBorderBrush"
                            ResourceKey="ControlStrokeColorDefaultBrush" />

                        <!-- 悬停态：二级描边，浅色 #29000000 / 深色 #18FFFFFF。 -->
                        <StaticResource
                            x:Key="TextControlBorderBrushPointerOver"
                            ResourceKey="ControlStrokeColorSecondaryBrush" />
                    </AutoSuggestBox.Resources>
                </AutoSuggestBox>
            </Grid>

            <StackPanel
                Grid.Column="2"
                Margin="0"
                VerticalAlignment="Stretch"
                Orientation="Horizontal"
                Spacing="0">
                <Button
                    x:Name="ImportButton"
                    Width="48"
                    Height="48"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnImportClick"
                    ToolTipService.ToolTip="导入（添加媒体文件夹）">
                    <FontIcon FontSize="16" Glyph="&#xE8B5;" />
                </Button>
                <Button
                    x:Name="SettingsButton"
                    Width="48"
                    Height="48"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnSettingsClick"
                    ToolTipService.ToolTip="设置">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <controls:NavigationView
            x:Name="NavigationViewControl"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="{Binding NavigationPaneMode}"
            SelectionChanged="OnNavigationSelectionChanged">

            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem
                    Content="全部照片"
                    Icon="Pictures"
                    Tag="AllPhotos" />
                <controls:NavigationViewItem
                    Content="收藏夹"
                    Icon="Favorite"
                    Tag="Favorites" />
                <controls:NavigationViewItem
                    Content="视频"
                    Icon="Video"
                    Tag="Videos" />
                <controls:NavigationViewItem
                    Content="分类"
                    Icon="List"
                    Tag="Categories" />
                <controls:NavigationViewItem
                    Content="发现"
                    Icon="SlideShow"
                    Tag="Discover" />
            </controls:NavigationView.MenuItems>

            <controls:NavigationView.FooterMenuItems>
                <controls:NavigationViewItem
                    Content="设置"
                    Icon="Setting"
                    Tag="Settings" />
            </controls:NavigationView.FooterMenuItems>

            <!-- 中间内容区 + 右侧详情面板 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DetailsColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <!-- 中间：各功能页面，实例由依赖注入创建后交由此处承载 -->
                <ContentControl
                    x:Name="PageHost"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" />

                <!--
                    右侧：详情面板。
                    注意：WinUI 3 的 Window 不是 FrameworkElement，其根元素上无法使用带 Converter 的 x:Bind
                    （生成代码调用 SetConverterLookupRoot 需要 FrameworkElement），
                    故带 Converter 的绑定一律使用传统 Binding，并已在构造函数中把 DataContext 设为窗口自身；
                    不带 Converter 的绑定（如搜索框占位文本）仍可使用 x:Bind。
                -->
                <Border
                    x:Name="DetailsPane"
                    Grid.Column="1"
                    Visibility="Collapsed"
                    Margin="0"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="DetailsPaneTransform" />
                    </Border.RenderTransform>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="详细信息" />
                                <Button
                                    x:Name="DetailsPaneCloseButton"
                                    Grid.Column="1"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnDetailsPaneCloseClick"
                                    ToolTipService.ToolTip="关闭详细信息">
                                    <FontIcon FontSize="14" Glyph="&#xE894;" />
                                </Button>
                            </Grid>

                            <!-- 未选中时的提示 -->
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="在左侧选择一个文件以查看详情。"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}" />

                            <Border
                                Height="180"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="4"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                <Image Source="{Binding SelectedThumbnail}" Stretch="Uniform" />
                            </Border>

                            <StackPanel
                                Spacing="4"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{Binding SelectedFileName}"
                                    TextWrapping="Wrap" />

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="类型" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding SelectedKindText}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="大小" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding SelectedFileSizeText}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="尺寸" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding SelectedDimensionText}" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="拍摄时间" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding SelectedTakenText}" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="位置" />
                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding SelectedPath}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </controls:NavigationView>
    </Grid>
</Window>
