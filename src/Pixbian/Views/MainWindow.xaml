<!--
    主窗口（M2）：标题栏 + 三栏布局外壳。
    顶栏为自定义标题栏：中央搜索框与右侧导入 / 设置按钮为交互控件，经 InputNonClientPointerSource
    放行指针事件，其余区域作为系统拖拽区；最右侧 140px 预留给窗口控制按钮。
    左侧 NavigationView 负责导航，中间承载各功能页面。
    页面实例由依赖注入在窗口构造时创建并以 Visibility 切换，
    避免 Frame 导航在参数传递时视图模型尚未就绪导致 x:Bind 求值失败。
    所有颜色均取自 ThemeResource，深浅主题切换时自动生效。
-->
<Window
    x:Class="Pixbian.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Pixbian.Converters"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Pixbian">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏行：交互控件之外的区域均为系统拖拽区；背景取自定义栏配色，随深浅主题切换 -->
        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Background="{ThemeResource PixbianPaneBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <FontIcon FontSize="16"
                          Glyph="&#xEB9F;"/>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="照片"/>
            </StackPanel>

            <!--
                搜索框：宽度随窗口缩放，但不超过 720px；最大化时约 720px。
                无搜索图标、无阴影、四边 1px 边框、圆角 4。
                边框色覆盖默认的 TextControlElevationBorderBrush（底部 45% 黑的竖向渐变），
                统一为纯色描边；静止态用一级描边（极淡），鼠标悬停时加深到二级描边，
                避免悬停无视觉反馈、也避免静止态过重。
            -->
            <Grid
                Grid.Column="1"
                MaxWidth="720"
                Margin="24,0,24,0">
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="{ThemeResource TextControlBackground}"
                    BorderBrush="{ThemeResource TextControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    PlaceholderText="{x:Bind SearchPlaceholder, Mode=OneWay}"
                    QuerySubmitted="OnSearchSubmitted"
                    TextChanged="OnSearchTextChanged"/>
            </Grid>

            <StackPanel
                Grid.Column="2"
                Margin="0"
                VerticalAlignment="Stretch"
                Orientation="Horizontal"
                Spacing="0">
                <Button
                    x:Name="ImportButton"
                    Width="48"
                    Height="48"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnImportClick"
                    ToolTipService.ToolTip="导入（添加媒体文件夹）">
                    <FontIcon FontSize="16"
                              Glyph="&#xE8B5;"/>
                </Button>
                <Button
                    x:Name="SettingsButton"
                    Width="48"
                    Height="48"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnSettingsClick"
                    ToolTipService.ToolTip="设置">
                    <FontIcon FontSize="16"
                              Glyph="&#xE713;"/>
                </Button>
            </StackPanel>
        </Grid>

        <controls:NavigationView
            x:Name="NavigationViewControl"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="{Binding NavigationPaneMode}"
            SelectionChanged="OnNavigationSelectionChanged">

            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem
                    Content="全部照片"
                    Icon="Pictures"
                    Tag="AllPhotos"/>
                <controls:NavigationViewItem
                    Content="收藏夹"
                    Icon="Favorite"
                    Tag="Favorites"/>
                <controls:NavigationViewItem
                    Content="视频"
                    Icon="Video"
                    Tag="Videos"/>
                <controls:NavigationViewItem
                    Content="分类"
                    Icon="List"
                    Tag="Categories"/>
                <controls:NavigationViewItem
                    Content="发现"
                    Icon="SlideShow"
                    Tag="Discover"/>
            </controls:NavigationView.MenuItems>

            <controls:NavigationView.FooterMenuItems>
                <controls:NavigationViewItem
                    Content="设置"
                    Icon="Setting"
                    Tag="Settings"/>
            </controls:NavigationView.FooterMenuItems>

            <!-- 中间内容区 -->
            <Grid>
                <!-- 中间：各功能页面，实例由依赖注入创建后交由此处承载 -->
                <ContentControl
                    x:Name="PageHost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"/>
            </Grid>
        </controls:NavigationView>
    </Grid>
</Window>
