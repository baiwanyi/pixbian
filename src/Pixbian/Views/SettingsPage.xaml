<!--
    设置页（M2）：管理媒体库扫描源、执行索引、展开分类规则管理，以及配置主题、视图模式与缩略图尺寸。
    所有颜色均取自 ThemeResource，深浅主题切换时自动生效。
    扫描源路径由用户在系统文件夹选择器中选取，不提供手工文本框输入，避免路径注入与拼写错误。
    分类管理以 Expander 卡片承载，展开时才装载分类页（DI 单例），避免启动即构建大列表。
-->
<Page
    x:Class="Pixbian.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Pixbian.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Pixbian.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Page.Resources>

    <ScrollViewer Padding="24,16"
            VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720"
                Spacing="20">

            <!-- 媒体库扫描源 -->
            <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                    Text="媒体库"/>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="扫描源文件夹"/>

                        <Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Click="OnAddFolderClick"
                            Content="添加文件夹"/>

                        <Button
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Click="OnStartIndexingClick"
                            Content="立即索引"
                            Style="{StaticResource AccentButtonStyle}"/>
                    </Grid>

                    <ListView
                        MinHeight="60"
                        ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:LibraryFolderRow">
                                <Grid Padding="8,4"
                                        ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center">
                                        <TextBlock
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind DisplayName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"/>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Path, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind LastScanText, Mode=OneWay}"/>

                                    <Button
                                        Grid.Column="2"
                                        Click="OnRemoveFolderClick"
                                        Content="移除"
                                        Tag="{x:Bind}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="移除扫描源会同时清理其下的索引记录，不会删除磁盘上的原始文件。"
                        TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal"
                            Spacing="8">
                        <ProgressRing
                            Width="16"
                            Height="16"
                            IsActive="{x:Bind ViewModel.IsIndexing, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsIndexing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 分类管理：展开后装载分类规则管理页；页面 Loaded 会自动加载分类与规则列表 -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Expanding="OnCategoryExpanderExpanding">
                <Expander.Header>
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="分类管理"/>
                </Expander.Header>
                <ContentControl
                    x:Name="CategoryHost"
                    HorizontalContentAlignment="Stretch"/>
            </Expander>

            <!-- 外观 -->
            <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                    Text="外观"/>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="主题"/>
                        <RadioButtons
                            x:Name="ThemeSelector"
                            MaxColumns="3"
                            SelectedIndex="{x:Bind ThemeIndex, Mode=TwoWay}"
                            SelectionChanged="OnThemeSelectionChanged">
                            <RadioButton Content="跟随系统"/>
                            <RadioButton Content="浅色"/>
                            <RadioButton Content="深色"/>
                        </RadioButtons>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="视图"/>
                        <RadioButtons
                            x:Name="ViewModeSelector"
                            MaxColumns="2"
                            SelectedIndex="{x:Bind ViewModeIndex, Mode=TwoWay}"
                            SelectionChanged="OnViewModeSelectionChanged">
                            <RadioButton Content="网格"/>
                            <RadioButton Content="自适应"/>
                        </RadioButtons>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="缩略图大小"/>
                        <ComboBox
                            x:Name="ThumbnailSizeSelector"
                            SelectedIndex="{x:Bind ThumbnailSizeIndex, Mode=TwoWay}"
                            SelectionChanged="OnThumbnailSizeChanged"/>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="尺寸越大，单屏显示数量越少，解码耗时越长。"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 局域网访问 -->
            <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                    Text="局域网访问"/>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">

                    <ToggleSwitch
                        x:Name="WebSharingToggle"
                        Header="允许局域网设备通过浏览器访问"
                        OffContent="已关闭"
                        OnContent="已开启"
                        Toggled="OnWebSharingToggled"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="WebPortBox"
                            Grid.Column="0"
                            Header="端口"/>

                        <PasswordBox
                            x:Name="WebPasswordBox"
                            Grid.Column="1"
                            Header="访问密码（留空沿用旧密码）"/>
                    </Grid>

                    <Button
                        Click="OnApplyWebSharingClick"
                        Content="保存并应用"
                        Style="{StaticResource AccentButtonStyle}"/>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="只读模式：局域网内设备只能浏览与播放，不能修改或删除文件。"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.WebStatusText, Mode=OneWay}"
                        TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                    Text="关于"/>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                            Text="Pixbian"/>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="本地媒体库管理工具 · WinUI 3"/>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="索引数据与缩略图缓存全部保存在本机，不会上传。"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
