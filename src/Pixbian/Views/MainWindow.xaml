<!--
    主窗口（M2）：标题栏 + 三栏布局外壳。
    顶栏为自定义标题栏：中央搜索框与右侧设置按钮为交互控件，经 InputNonClientPointerSource
    放行指针事件，其余区域作为系统拖拽区；最右侧 140px 预留给窗口控制按钮。
    左侧 NavigationView 负责导航，中间承载各功能页面；「分类」「图库」为分组标题，
    子项由扫描源与分类动态生成；「分类」标题带内联刷新按钮，「图库」标题经右键菜单提供添加文件夹。
    页面实例由依赖注入在窗口构造时创建，切换时改写内容区 ContentControl 的 Content，
    避免 Frame 导航在参数传递时视图模型尚未就绪导致 x:Bind 求值失败。
    根布局最底层为全窗口背景图，标题栏与导航栏均转透明以透出该图，
    内容区则由一层半透明白卡片承载页面。
-->
<Window
    x:Class="Pixbian.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Pixbian.Converters"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Pixbian">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--
            全窗口背景图：铺在根布局最底层，标题栏行与导航栏均转透明后由此透出。
            RowSpan=2 覆盖标题栏行与内容行；UniformToFill 在任意窗口比例下铺满并居中裁切。
            Source 由代码后置按磁盘路径设置：unpackaged 应用的 PRI 不索引 Content 项，
            ms-appx:// 形式的 URI 无法解析。
        -->
        <Image x:Name="WallpaperImage"
               Grid.RowSpan="2"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Stretch="UniformToFill"/>

        <!-- 自定义标题栏行：交互控件之外的区域均为系统拖拽区；背景透明，透出底层背景图 -->
        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <FontIcon FontSize="16"
                          Glyph="&#xEB9F;"/>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="照片"/>
            </StackPanel>

            <!--
                搜索框：宽度随窗口缩放，但不超过 720px；最大化时约 720px。
                无搜索图标、无阴影、四边 1px 边框、圆角 4。
                边框色覆盖默认的 TextControlElevationBorderBrush（底部 45% 黑的竖向渐变），
                统一为纯色描边；静止态用一级描边（极淡），鼠标悬停时加深到二级描边，
                避免悬停无视觉反馈、也避免静止态过重。
            -->
            <Grid
                Grid.Column="1"
                MaxWidth="720"
                Margin="24,0,24,0">
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="{ThemeResource TextControlBackground}"
                    BorderBrush="{ThemeResource TextControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    PlaceholderText="{x:Bind SearchPlaceholder, Mode=OneWay}"
                    QuerySubmitted="OnSearchSubmitted"
                    TextChanged="OnSearchTextChanged"/>
            </Grid>

            <StackPanel
                Grid.Column="2"
                Margin="0"
                VerticalAlignment="Stretch"
                Orientation="Horizontal"
                Spacing="0">
                <Button
                    x:Name="SettingsButton"
                    AutomationProperties.Name="设置"
                    Width="36"
                    Height="36"
                    Margin="0,6,16,6"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    BorderThickness="0"
                    CornerRadius="4"
                    Click="OnSettingsClick"
                    ToolTipService.ToolTip="设置">
                    <Button.Resources>
                        <!-- 常态透明 + hover/pressed 与左栏 NavigationViewItem 取同一套系统语义键
                             （见 App.xaml 的 NavigationViewItemBackground* 抄录），
                             保证标题栏按钮与菜单项的光标反馈视觉一致。
                             关键约束：常态透明必须经 ButtonBackground 键设置，不能写成元素上的
                             Background="Transparent"——本地值会经 TemplateBinding 传入模板内根 Grid，
                             而 VisualState 的 Setter 优先级低于本地值，hover / pressed 将永远无法生效
                             （这正是此前该按钮毫无光标反馈的根因）。
                             对比：图库页的 ToolBarButtonStyle 用 Style Setter 设透明，优先级低于
                             VisualState 且后者后应用，故其按钮 hover 正常。
                             StaticResource 指回系统键：随主题自动变化，不写死颜色。仅作用于本按钮。 -->
                        <StaticResource x:Key="ButtonBackground"
                                        ResourceKey="SubtleFillColorTransparentBrush"/>
                        <StaticResource x:Key="ButtonBackgroundPointerOver"
                                        ResourceKey="SubtleFillColorSecondaryBrush"/>
                        <StaticResource x:Key="ButtonBackgroundPressed"
                                        ResourceKey="SubtleFillColorTertiaryBrush"/>
                    </Button.Resources>
                    <FontIcon FontSize="16"
                              Glyph="&#xE713;"/>
                </Button>
            </StackPanel>
        </Grid>

        <controls:NavigationView
            x:Name="NavigationViewControl"
            Grid.Row="1"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="{Binding NavigationPaneMode}"
            SelectionChanged="OnNavigationSelectionChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem
                    Content="收藏夹"
                    Tag="Favorites">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB51;"/>
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem
                    Content="片段"
                    Icon="Video"
                    Tag="Videos"/>
                <controls:NavigationViewItemSeparator/>
                <controls:NavigationViewItem
                    x:Name="CategoriesNavItem"
                    Icon="List"
                    SelectsOnInvoked="False"
                    Tag="Categories">
                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="分类"/>
                        <Button
                            x:Name="RefreshCategoriesButton"
                            Grid.Column="1"
                            AutomationProperties.Name="刷新分类（批量重新匹配）"
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnRefreshCategoriesClick"
                            ToolTipService.ToolTip="重新匹配全部分类规则">
                            <FontIcon FontSize="16"
                                      Glyph="&#xE72C;"/>
                        </Button>
                    </Grid>
                </controls:NavigationViewItem>
                <controls:NavigationViewItemSeparator/>
                <controls:NavigationViewItem
                    x:Name="GalleryNavItem"
                    Content="图库"
                    Icon="Pictures"
                    Tag="AllPhotos">
                    <controls:NavigationViewItem.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                AutomationProperties.Name="添加文件夹"
                                Click="OnAddMediaFolderClick"
                                Text="添加文件夹">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B5;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </controls:NavigationViewItem.ContextFlyout>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>

            <!-- 中间内容区 -->
            <Grid>
                <Grid.Resources>
                    <ThemeShadow x:Key="ContentCardShadow"/>
                </Grid.Resources>

                <!--
                    内容区卡片：半透明白底 + 左上角圆角 + 上/左描边，浮在背景图之上。
                    底色 #CCFFFFFF 为 80% 不透明的磨砂白，背景图隐约透出。

                    右与底贴齐应用窗口边缘，故这两边不设间距、不画描边、不带圆角；
                    左贴齐左栏（间距 0），上边取 -1 压住左栏与内容区之间的那道分隔线，
                    圆角与描边只保留左、上两边——贴边的两条边即便给了也会被裁掉。
                    顺序：Margin / BorderThickness 为「左,上,右,下」，CornerRadius 为「左上,右上,右下,左下」。

                    投影（ThemeShadow + Translation z=32）当前已停用，见紧随其后的说明；
                    恢复时两者必须同时给——只设 Shadow 不抬起，投影几乎不可见。
                -->
                <!-- 【临时实验】Shadow 与 Translation 已停用：ThemeShadow 未设 Receiver 时
                     会投影到下方所有兄弟元素（含全窗口背景大图），每帧对全窗做投影采样；
                     与 200 个条目 visual 同帧出现疑似压死合成线程（画面冻结）。待实验定论后恢复。 -->
                <Border x:Name="ContentCard"
                        Margin="0,-1,0,0"
                        Background="{ThemeResource PixbianContentCardBackground}"
                        BorderBrush="{ThemeResource PixbianContentCardBorderBrush}"
                        CornerRadius="12,0,0,0"
                        BorderThickness="1,1,0,0">
                    <Grid>
                        <!-- 各功能页面，实例由依赖注入创建后交由此处承载 -->
                        <ContentControl
                            x:Name="PageHost"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>

                        <!-- 内容区 loading 覆盖层：图库查询期间遮住页面内容，撤除时骨架屏已就位。
                             【必须】放在窗口层（PageHost 兄弟位），不得移回 GalleryPage 内部同格：
                             曾经的 LayoutCycleException 源于「覆盖层与同格 GridView 大重排在同一
                             布局容器内交替失效」，与本层是否播放动画无关——
                             2026-09-03 实测：恢复 indeterminate 滑块动画后反复切换目录十余次，
                             未再现任何 LayoutCycle 或画面冻结，旧注释「indeterminate 动画参与布局
                             测量导致布局循环」的断言不成立（包内模板亦可证：ProgressBar 的
                             indeterminate 动画目标是 RenderTransform.TranslateX，不触发测量）。
                             移出同格后二者彻底解耦；卡片 Border 的圆角裁剪与拉伸填充自动作用于本层。
                             显隐由代码后置同步（OnGalleryPropertyChanged）：Window 非
                             FrameworkElement，x:Bind OneWay 在此不可用；初始 Collapsed，
                             订阅后按图库当前状态对齐。
                             覆盖层仅一块不确定态滑块（无文字）：ProgressBar 声明为 determinate，
                             由代码后置在显示期间切 IsIndeterminate=true，隐藏即复位停掉动画时钟。
                             背景与内容区同款（ThemeResource PixbianContentCardBackground，随主题的
                             磨砂白/磨砂深灰）：覆盖层与内容区视觉无缝，撤层时无色差跳变。
                             该画刷 80% 不透明，下层骨架屏会有极轻微透出（观感可接受）。
                             【约束保留】若日后把覆盖层移回 GalleryPage 内与视图同格，
                             必须同步撤掉滑块动画——同格结构才是那次布局循环的成因。 -->
                        <Border
                            x:Name="LoadingOverlay"
                            Visibility="Collapsed"
                            Background="{ThemeResource PixbianContentCardBackground}">
                            <ProgressBar
                                x:Name="LoadingProgressBar"
                                Width="240"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsIndeterminate="False"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </controls:NavigationView>
    </Grid>
</Window>
