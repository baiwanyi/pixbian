<!--
    主窗口（M2）：标题栏 + 三栏布局外壳。
    顶栏为自定义标题栏：中央搜索框与右侧设置按钮为交互控件，经 InputNonClientPointerSource
    放行指针事件，其余区域作为系统拖拽区；最右侧 140px 预留给窗口控制按钮。
    左侧 NavigationView 负责导航，中间承载各功能页面；「分类」「图库」为分组标题，
    子项由扫描源与分类动态生成；「分类」标题带内联刷新按钮，「图库」标题经右键菜单提供添加文件夹。
    页面实例由依赖注入在窗口构造时创建，切换时改写内容区 ContentControl 的 Content，
    避免 Frame 导航在参数传递时视图模型尚未就绪导致 x:Bind 求值失败。
    根布局最底层为全窗口渐变背景（基调 + 光晕双层），标题栏与导航栏均转透明以透出该层，
    内容区则由一层半透明卡片承载页面。
    视频播放是窗口级独立分支：PlayerRoot 覆盖标题栏行与内容行，播放时隐藏标题栏与导航栏，
    画面顶到窗口最上沿，顶栏由播放器页自绘并与系统窗口按钮同排。
-->
<Window
    x:Class="Pixbian.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Pixbian.Converters"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Pixbian">

    <!--
        不透明底：窗口根若有透明区域，DWM 必须按带 alpha 的窗口处理，全窗每帧都要参与
        alpha 合成，视频也就拿不到「独立翻转 / 硬件覆盖」的直通路径（2K/4K 下代价显著）。
        给一层不透明底即可让合成器走直通；壁纸大图铺满其上，常态视觉不受影响。
    -->
    <Grid x:Name="RootGrid"
          Background="Black">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--
            全窗口背景：基调线性渐变 + 光晕层双层叠加，铺在根布局最底层，
            标题栏行与导航栏均转透明后由此透出。收进同一 Grid 容器统一参与播放态显隐；
            光晕层 IsHitTestVisible=False 不拦截命中测试，浅色为径向光晕、深色为全透明
            （深色只用线性渐变表达光感）。两支画刷均 ThemeResource 引用随主题切换。
        -->
        <Grid x:Name="WallpaperLayer"
              Grid.RowSpan="2">
            <Rectangle Fill="{ThemeResource PixbianWallpaperGradient}"/>
            <Rectangle IsHitTestVisible="False"
                       Fill="{ThemeResource PixbianWallpaperGlow}"/>
        </Grid>

        <!-- 自定义标题栏行：交互控件之外的区域均为系统拖拽区；背景透明，透出底层背景图 -->
        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <FontIcon FontSize="16"
                          Glyph="&#xEB9F;"/>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="PixBian"/>
            </StackPanel>

            <!--
                搜索框：宽度随窗口缩放，但不超过 720px；最大化时约 720px。
                三态均有边框与底色，色值按主题各写一份（见下方主题字典）：
                静默最淡、悬停/聚焦加深，圆角 4。
                覆盖原理：内部 TextBox（AutoSuggestBoxTextBoxStyle，包内 16034-16037 行）对这批键
                均为 ThemeResource 引用，祖先级 Resources 覆盖可穿透生效（StaticResource 则不行）；
                作用域限定在本 Grid，不影响页面其他输入框。
            -->
            <Grid
                Grid.Column="1"
                MaxWidth="720"
                Margin="24,0,24,0">
                <Grid.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <!-- 浅色：边框用系统描边（静默 6% 黑、悬停/聚焦 16% 黑）；
                                 底色取 25%/40% 白半透明，压渐变标题栏呈淡面。 -->
                            <ResourceDictionary x:Key="Default">
                                <StaticResource x:Key="TextControlBorderBrush"
                                                ResourceKey="ControlStrokeColorDefaultBrush"/>
                                <StaticResource x:Key="TextControlBorderBrushPointerOver"
                                                ResourceKey="ControlStrokeColorSecondaryBrush"/>
                                <StaticResource x:Key="TextControlBorderBrushFocused"
                                                ResourceKey="ControlStrokeColorSecondaryBrush"/>
                                <SolidColorBrush x:Key="TextControlBackground"
                                                 Color="#40FFFFFF"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver"
                                                 Color="#66FFFFFF"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused"
                                                 Color="#66FFFFFF"/>
                            </ResourceDictionary>
                            <!-- 深色：系统描边仅 7%~9% 白，在近黑的标题栏上不可见，
                                 边框改用 10%/15% 浅灰；底色 20%/40% 灰半透明。
                                 全部按主题写字面量——跨主题键若经 StaticResource 重定向
                                 到非主题字典会被钉死启动主题，故键必须留在主题字典内。 -->
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="TextControlBorderBrush"
                                                 Color="#1ACCCCCC"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"
                                                 Color="#26CCCCCC"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused"
                                                 Color="#26CCCCCC"/>
                                <SolidColorBrush x:Key="TextControlBackground"
                                                 Color="#33333333"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver"
                                                 Color="#66333333"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused"
                                                 Color="#66333333"/>
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </Grid.Resources>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    BorderThickness="1"
                    CornerRadius="4"
                    PlaceholderText="{x:Bind SearchPlaceholder, Mode=OneWay}"
                    QuerySubmitted="OnSearchSubmitted"
                    TextChanged="OnSearchTextChanged"/>
            </Grid>

            <StackPanel
                Grid.Column="2"
                Margin="0"
                VerticalAlignment="Stretch"
                Orientation="Horizontal"
                Spacing="0">
                <Button
                    x:Name="SettingsButton"
                    AutomationProperties.Name="设置"
                    Width="36"
                    Height="36"
                    Margin="0,6,16,6"
                    VerticalAlignment="Stretch"
                    Click="OnSettingsClick"
                    PointerEntered="OnSettingsButtonPointerEntered"
                    PointerExited="OnSettingsButtonPointerExited"
                    ToolTipService.ToolTip="设置">
                    <Button.Style>
                        <!-- 自定义模板：仅 Border(TemplateBinding Background) + ContentPresenter，
                             不含任何 VisualState——悬停/常态背景完全由代码后置指针事件驱动。
                             此前默认模板下「状态键资源覆盖」与「祖先级资源重定向」均实测无效，
                             浅色下事件设置的画刷也疑似被默认模板状态稀释；自定义模板彻底
                             排除一切系统状态干扰，背景所见即所设。 -->
                        <Style TargetType="Button">
                            <Setter Property="Background"
                                    Value="Transparent"/>
                            <Setter Property="BorderThickness"
                                    Value="0"/>
                            <Setter Property="CornerRadius"
                                    Value="4"/>
                            <Setter Property="Padding"
                                    Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="HoverBackdrop"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="{TemplateBinding CornerRadius}">
                                            <ContentPresenter
                                                Margin="{TemplateBinding Padding}"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <FontIcon FontSize="16"
                              Glyph="&#xE713;"/>
                </Button>
            </StackPanel>
        </Grid>

        <controls:NavigationView
            x:Name="NavigationViewControl"
            Grid.Row="1"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="{Binding NavigationPaneMode}"
            Collapsed="OnNavigationItemCollapsed"
            Expanding="OnNavigationItemExpanding"
            ItemInvoked="OnNavigationItemInvoked"
            SelectionChanged="OnNavigationSelectionChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem
                    Content="收藏夹"
                    Tag="Favorites">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB51;"/>
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem
                    Content="片段"
                    Icon="Video"
                    Tag="Videos"/>
                <controls:NavigationViewItemSeparator/>
                <controls:NavigationViewItem
                    x:Name="CategoriesNavItem"
                    Icon="List"
                    SelectsOnInvoked="False"
                    Tag="Categories">
                    <Grid HorizontalAlignment="Stretch"
                          ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="分类"/>
                        <Button
                            x:Name="RefreshCategoriesButton"
                            Grid.Column="1"
                            AutomationProperties.Name="刷新分类（批量重新匹配）"
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnRefreshCategoriesClick"
                            ToolTipService.ToolTip="重新匹配全部分类规则">
                            <FontIcon FontSize="16"
                                      Glyph="&#xE72C;"/>
                        </Button>
                    </Grid>
                </controls:NavigationViewItem>
                <controls:NavigationViewItemSeparator/>
                <!-- 图库默认展开：扫描源即其主要内容入口，折叠会隐藏全部文件夹。
                     展开状态只由右侧箭头决定——点行本身只导航到图库，控件默认会顺势
                     切换展开，该行为在 OnNavigationItemInvoked 中撤销。 -->
                <controls:NavigationViewItem
                    x:Name="GalleryNavItem"
                    Content="图库"
                    Icon="Pictures"
                    IsExpanded="True"
                    Tag="AllPhotos">
                    <controls:NavigationViewItem.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                AutomationProperties.Name="添加文件夹"
                                Click="OnAddMediaFolderClick"
                                Text="添加文件夹">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B5;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </controls:NavigationViewItem.ContextFlyout>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>

            <!-- 中间内容区 -->
            <Grid>
                <Grid.Resources>
                    <ThemeShadow x:Key="ContentCardShadow"/>
                </Grid.Resources>

                <!--
                    内容区卡片：半透明白底 + 左上角圆角 + 上/左描边，浮在背景图之上。
                    底色 #CCFFFFFF 为 80% 不透明的磨砂白，背景图隐约透出。

                    右与底贴齐应用窗口边缘，故这两边不设间距、不画描边、不带圆角；
                    左贴齐左栏（间距 0），上边取 -1 压住左栏与内容区之间的那道分隔线，
                    圆角与描边只保留左、上两边——贴边的两条边即便给了也会被裁掉。
                    顺序：Margin / BorderThickness 为「左,上,右,下」，CornerRadius 为「左上,右上,右下,左下」。

                    投影（ThemeShadow + Translation z=32）当前已停用，见紧随其后的说明；
                    恢复时两者必须同时给——只设 Shadow 不抬起，投影几乎不可见。
                -->
                <!-- 【临时实验】Shadow 与 Translation 已停用：ThemeShadow 未设 Receiver 时
                     会投影到下方所有兄弟元素（含全窗口背景大图），每帧对全窗做投影采样；
                     与 200 个条目 visual 同帧出现疑似压死合成线程（画面冻结）。待实验定论后恢复。 -->
                <Border x:Name="ContentCard"
                        Margin="0,-1,0,0"
                        Background="{ThemeResource PixbianContentCardBackground}"
                        BorderBrush="{ThemeResource PixbianContentCardBorderBrush}"
                        CornerRadius="12,0,0,0"
                        BorderThickness="1,1,0,0">
                    <Grid>
                        <!-- 各功能页面，实例由依赖注入创建后交由此处承载 -->
                        <ContentControl
                            x:Name="PageHost"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>

                        <!-- 内容区 loading 覆盖层：图库查询期间遮住页面内容，撤除时骨架屏已就位。
                             【必须】放在窗口层（PageHost 兄弟位），不得移回 GalleryPage 内部同格：
                             曾经的 LayoutCycleException 源于「覆盖层与同格 GridView 大重排在同一
                             布局容器内交替失效」，与本层是否播放动画无关——
                             2026-09-03 实测：恢复 indeterminate 滑块动画后反复切换目录十余次，
                             未再现任何 LayoutCycle 或画面冻结，旧注释「indeterminate 动画参与布局
                             测量导致布局循环」的断言不成立（包内模板亦可证：ProgressBar 的
                             indeterminate 动画目标是 RenderTransform.TranslateX，不触发测量）。
                             移出同格后二者彻底解耦；卡片 Border 的圆角裁剪与拉伸填充自动作用于本层。
                             显隐由代码后置同步（OnGalleryPropertyChanged）：Window 非
                             FrameworkElement，x:Bind OneWay 在此不可用；初始 Collapsed，
                             订阅后按图库当前状态对齐。
                             覆盖层仅一块不确定态滑块（无文字）：ProgressBar 声明为 determinate，
                             由代码后置在显示期间切 IsIndeterminate=true，隐藏即复位停掉动画时钟。
                             背景与内容区同款（ThemeResource PixbianContentCardBackground，随主题的
                             磨砂白/磨砂深灰）：覆盖层与内容区视觉无缝，撤层时无色差跳变。
                             该画刷 80% 不透明，下层骨架屏会有极轻微透出（观感可接受）。
                             【约束保留】若日后把覆盖层移回 GalleryPage 内与视图同格，
                             必须同步撤掉滑块动画——同格结构才是那次布局循环的成因。 -->
                        <Border
                            x:Name="LoadingOverlay"
                            Visibility="Collapsed"
                            Background="{ThemeResource PixbianContentCardBackground}">
                            <ProgressBar
                                x:Name="LoadingProgressBar"
                                Width="240"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsIndeterminate="False"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </controls:NavigationView>

        <!--
            播放态独立根：RowSpan=2 覆盖标题栏行与内容行，播放画面顶到窗口最上沿。
            与 TitleBar / NavigationView 平级且声明在其后 → 同格叠放时位于上层；
            播放态由代码后置把前两者切为 Collapsed，只留本层可见，退出时反向切回。
            顶栏（返回 + 文件名）由 VideoPlayerPage 自绘，落在标题栏那 48px 内与系统按钮同排，
            故顶栏内的返回按钮必须经 UpdateTitleBarPassthrough 注册为 Passthrough——
            系统标题栏区域的输入默认被非客户区吞掉，不放行就收不到点击。
            底色纯黑且不随主题（PixbianPlayerCardBackground 定义在主题字典之外）。
            本层只承载播放器页单例（VideoHost），与常态的 PageHost 是两个独立宿主，
            互不争抢父容器；播放器页不再进出 PageHost，避免 Content 变更触发意外卸载。
        -->
        <Grid x:Name="PlayerRoot"
              Grid.Row="0"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Background="{StaticResource PixbianPlayerCardBackground}">
            <ContentControl
                x:Name="VideoHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
