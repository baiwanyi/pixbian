<!--
    应用程序定义（M0 骨架）。
    合并 XamlControlsResources 是 WinUI 3 的必需步骤，用于加载 WinUI 控件样式与主题资源字典。
    M2 里程碑将在此追加应用级主题字典与共享样式。
-->
<Application
    x:Class="Pixbian.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    注意：不可设置 ControlsResourcesVersion 属性。
                    该属性自 Windows App SDK 1.7 起才可用，在 1.6 上会触发 WMC0011「Unknown member」编译错误。
                -->
                <controls:XamlControlsResources/>

                <!-- 自定义控件的默认样式（隐式 Style，作用于全应用）。 -->
                <ResourceDictionary Source="Controls/ThumbnailPresenter.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                全局颜色集中管理（单一入口）。
                分层：
                  ① Pixbian* 自定义语义键：项目专属的固定配色，浅色(Default)/深色(Dark)各一套，主题切换自动生效。
                  ② 抄录式状态键：把 NavigationView / TextControl 等系统控件的状态键在此登记，
                     取值用 StaticResource 指回 WinUI 3 默认语义键，视觉与系统一致、零变化，
                     仅作为“一处可查可改”的集中入口（改色时只需把 ResourceKey 换成 Pixbian* 即可）。
                不抄录未纳入管理诉求的系统键（如 TextFillColorPrimaryBrush），保持其系统默认直接提供。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- ① 自定义：栏（顶部标题栏 + 左侧导航）/ 主内容区 / 列表项蒙版 -->
                    <SolidColorBrush x:Key="PixbianPaneBrush"
                                     Color="#1D2327"/>
                    <SolidColorBrush x:Key="PixbianContentBrush"
                                     Color="#F0F0F1"/>
                    <SolidColorBrush x:Key="PixbianItemHover"
                                     Color="#000000"/>
                    <SolidColorBrush x:Key="PixbianItemPressed"
                                     Color="#000000"/>
                    <!-- 缩略图骨架屏：加载中的占位底色，取接近内容区的浅灰，避免加载完成时对比过强 -->
                    <SolidColorBrush x:Key="PixbianSkeletonBrush"
                                     Color="#F0F0F0"/>
                    <!-- 浮在缩略图之上的时长角标：底色 + 文字色一对，均不随主题变化。
                         压在图片内容之上，且角标底恒为半透明黑，故文字恒为白；
                         若底色随主题反转（浅色主题下变浅灰），白字将不可读。
                         不用系统 TextFillColorInverseBrush——它的语义正是「随主题反转」。
                         两个主题取同值是有意为之，不是漏配。 -->
                    <SolidColorBrush x:Key="PixbianItemOverlayBrush"
                                     Color="#80000000"/>
                    <SolidColorBrush x:Key="PixbianItemOverlayForegroundBrush"
                                     Color="#FFFFFF"/>
                    <!-- 右键菜单只读信息项前景（大小/尺寸/日期/位置） -->
                    <SolidColorBrush x:Key="ContextMenuInfoForeground"
                                     Color="#6B6B6B"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PixbianPaneBrush"
                                     Color="#1D2327"/>
                    <SolidColorBrush x:Key="PixbianContentBrush"
                                     Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="PixbianItemHover"
                                     Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="PixbianItemPressed"
                                     Color="#FFFFFF"/>
                    <!-- 缩略图骨架屏：加载中的占位底色，深色主题下同取更浅的灰以与内容区区分 -->
                    <SolidColorBrush x:Key="PixbianSkeletonBrush"
                                     Color="#333333"/>
                    <!-- 角标底与文字色：与 Default 同值，理由见上方 Default 字典中的同名键注释。 -->
                    <SolidColorBrush x:Key="PixbianItemOverlayBrush"
                                     Color="#80000000"/>
                    <SolidColorBrush x:Key="PixbianItemOverlayForegroundBrush"
                                     Color="#FFFFFF"/>
                    <!-- 右键菜单只读信息项前景（大小/尺寸/日期/位置） -->
                    <SolidColorBrush x:Key="ContextMenuInfoForeground"
                                     Color="#9A9A9A"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 右键菜单只读信息项样式：仅约束最大宽度，避免长路径撑开整个菜单。
                 换行不靠自定义 ControlTemplate（其应用会触发 WinUI 3 的旋转忙碌光标），
                 而由代码在文本中插入硬换行符（TextBlock 对 \n 始终换行，与 TextWrapping 无关）。 -->
            <Style x:Key="ReadOnlyMenuItemStyle"
                   TargetType="MenuFlyoutItem">
                <Setter Property="MaxWidth"
                        Value="320"/>
            </Style>

            <!-- 导航栏背景：引用自定义栏配色（展开/折叠/顶层同色）。
                 按 NavigationView 模板的真实绑定设置，勿凭文档想当然：
                   ① 左栏 Pane 与内容并排时（VisualState PaneNotOverlaying），PaneBackground 被
                      显式改为 NavigationViewExpandedPaneBackground，其 WinUI 3 默认值是
                      SolidBackgroundFillColorTransparent（透明）—— 故只改 DefaultPaneBackground
                      在最常见的并排形态下完全无效，必须一并覆盖 Expanded 版本。
                   ② 内容区底色由 ContentGrid 的 NavigationViewContentBackground 提供；
                      SplitView.Background（TemplateBinding 到 NavigationView 的 Background）
                      则是其下的底层，内容区左上角 8px 圆角处露出的就是这层——设为深色，
                      圆角就以深色圆弧呈现（WinUI 默认观感，用户确认保留）。
                 写 Brush 键一律用 StaticResource 引用画刷本身；写成
                 Color="{ThemeResource Xxx}" 是把 Brush 赋给 Color 属性，类型不匹配。
                 NavigationViewPaneBackground / NavigationViewBackground 是死键，不要登记。 -->
            <StaticResource x:Key="NavigationViewDefaultPaneBackground"
                            ResourceKey="PixbianPaneBrush"/>
            <StaticResource x:Key="NavigationViewExpandedPaneBackground"
                            ResourceKey="PixbianPaneBrush"/>
            <StaticResource x:Key="NavigationViewTopPaneBackground"
                            ResourceKey="PixbianPaneBrush"/>
            <StaticResource x:Key="NavigationViewContentBackground"
                            ResourceKey="PixbianContentBrush"/>

            <!-- 内容区圆角：只保留左上角 8（左上,右上,右下,左下）。
                 必须显式声明——WinUI 3 的 generic.xaml 按主题字典分别定义此键，其 Light 字典中
                 取值为 0；本项目系统是浅色主题，仅依赖默认值会得到直角（实测确认），
                 故在此统一指定，三个主题共用。 -->
            <CornerRadius x:Key="NavigationViewContentGridCornerRadius">8,0,0,0</CornerRadius>

            <!-- 导航栏边框：左栏 Pane 与内容区之间不要任何分割线。
                 两处边框都由 Thickness 承载，归零即可；不要把 NavigationViewItemSeparatorForeground
                 改成透明画刷——那支画笔还被 Top 模式的 SeparatorLine 等元素复用，会误伤。
                   ① NavigationViewBorderThickness：RootSplitView 的外框（默认 1，四边）。
                   ② NavigationViewContentGridBorderThickness：内容区边框，默认 1,1,0,0，
                      其中「左 1」正是 Pane 与内容区之间那条竖线。 -->
            <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>

            <!-- ② 抄录 NavigationView 项状态键（取值=WinUI 3 默认语义键，集中可见、不改色） -->
            <StaticResource x:Key="NavigationViewItemBackground"
                            ResourceKey="SubtleFillColorTransparentBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundPointerOver"
                            ResourceKey="SubtleFillColorSecondaryBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundPressed"
                            ResourceKey="SubtleFillColorTertiaryBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundSelected"
                            ResourceKey="SubtleFillColorSecondaryBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver"
                            ResourceKey="SubtleFillColorTertiaryBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed"
                            ResourceKey="SubtleFillColorSecondaryBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedDisabled"
                            ResourceKey="SubtleFillColorSecondaryBrush"/>

            <!-- ② 抄录 TextControl 边框状态键（取值=WinUI 3 默认语义键） -->
            <StaticResource x:Key="TextControlBorderBrush"
                            ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="TextControlBorderBrushPointerOver"
                            ResourceKey="TextControlElevationBorderBrush"/>
            <StaticResource x:Key="TextControlBorderBrushFocused"
                            ResourceKey="TextControlElevationBorderFocusedBrush"/>
            <StaticResource x:Key="TextControlBorderBrushDisabled"
                            ResourceKey="ControlStrokeColorDefaultBrush"/>
        </ResourceDictionary>
    </Application.Resources>

</Application>
