<!--
    图库页（M2）：页头（图标 + 名称 + 工具栏）/ 统计行 / 内容区三行布局。
    页头行左侧为导航目标图标与名称，右侧为工具栏；普通与选择两种工具栏占同一格、Visibility 互斥。
    工具栏为紧凑图标按钮组：仅「选择」带文本，其余为纯图标（靠 ToolTip 说明），带下拉菜单的按钮
    在图标后附一个小角标；排序菜单为「依据（随机 / 日期 / 大小 / 名字）+ 方向（升序 / 降序）」两组，
    随机时方向两项置灰。
    全选 / 取消选择提供 Ctrl+A、Ctrl+D、Esc 快捷键，以页面级 KeyboardAccelerator 注册。
    工具栏溢出按规范 §2.3 用 AdaptiveTrigger + VisualState 声明（≥1008 宽松 / 640~1007 中等 / <640 紧凑），
    纯图标按钮一律带 AutomationProperties.Name（规范 §10【必须】）。
    统计行反映当前筛选结果的全量规模（非已加载页数），与列表共用 ViewModel 的查询条件。
    内容区左右边距统一为 48px；条目为纯平铺，不按日期分组；两种视图各用一个非分组 GridView，
    自适应视图的 ItemsPanel 为 JustifiedPanel，方形视图用内建 ItemsWrapGrid。
    注：WinUI 3 的 XamlCompiler 不支持 DataTemplate 内 RelativeSource AncestorType 绑定（会静默崩溃），
    故选择遮罩与复选框改由 ItemContainerStyle 的 ControlTemplate 承载，模板内 x:Bind 根即为 Page，
    可安全访问 IsSelectionMode；遮罩 hover 态由 ControlTemplate 的 VisualStateManager 驱动。
-->
<Page
    x:Class="Pixbian.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixbian.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Pixbian.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pixbian.ViewModels"
    xmlns:converters="using:Pixbian.Converters"
    xmlns:winui="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <!-- 快捷键以页面级 KeyboardAccelerator 注册，沿焦点树向上查找，页面内有焦点即生效；
         菜单项上的 KeyboardAcceleratorTextOverride 只负责显示提示文本。 -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Invoked="OnSelectAllAcceleratorInvoked"
            Key="A"
            Modifiers="Control"/>
        <KeyboardAccelerator
            Invoked="OnSelectNoneAcceleratorInvoked"
            Key="D"
            Modifiers="Control"/>
        <KeyboardAccelerator
            Invoked="OnSelectNoneAcceleratorInvoked"
            Key="Escape"/>
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!-- 工具栏按钮的悬停/按下底色：默认的 ButtonBackgroundPointerOver 铺在纯白内容区上
             几乎不可见，换成 Fluent 分层填充色（约 6% / 9% 覆盖）才有明确指向反馈。
             页面内只有工具栏用到 Button，覆盖在此无副作用。 -->
        <StaticResource x:Key="ButtonBackgroundPointerOver"
                        ResourceKey="SubtleFillColorSecondaryBrush"/>
        <StaticResource x:Key="ButtonBackgroundPressed"
                        ResourceKey="SubtleFillColorTertiaryBrush"/>

        <!-- 模板内无法用 x:Bind 触达页面，经代理对象把页面实例作为绑定源暴露给容器模板。 -->
        <local:BindingProxy x:Key="PageProxy"
                            Data="{x:Bind}"/>

        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BoolToVisibilityConverter
            x:Key="InverseBoolToVisibility"
            IsInverted="True"/>

        <Style x:Key="ToolBarButtonStyle"
               TargetType="ButtonBase">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <!-- 取 ControlCornerRadius（4）：按钮属「内嵌控件」档，按界面设计规范 §5 只有 4 / 8 两档，
                 表面层级才用 8，不发明第三档。默认模板本就取 4，此处显式声明只为悬停底色的圆角可见。 -->
            <Setter Property="CornerRadius"
                    Value="4"/>
            <Setter Property="Height"
                    Value="32"/>
            <!-- 8：规范 §2.1【必须】所有边距/间距取 4 的倍数。 -->
            <Setter Property="Padding"
                    Value="8,0"/>
            <Setter Property="HorizontalAlignment"
                    Value="Left"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="DropDownChevronStyle"
               TargetType="FontIcon">
            <Setter Property="FontFamily"
                    Value="{ThemeResource SymbolThemeFontFamily}"/>
            <!-- 12：与 WinUI 官方一致（ExpanderChevronGlyphSize / DropDownButton 内 chevron 实测均 12）。 -->
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="Glyph"
                    Value="&#xE70D;"/>
            <Setter Property="Margin"
                    Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <!-- 网格视图条目模板 -->
        <DataTemplate x:Key="MediaItemTemplate"
                      x:DataType="models:MediaItemViewModel">
            <!-- KeyboardAcceleratorPlacementMode="Hidden"：页面级快捷键（Ctrl+A 等）会按官方设计
                 自动附加到页面内所有控件的 ToolTip 上，条目模板的 Border 不在豁免之列，
                 hover 图片时就会莫名显示按键组合。此处隐藏，仅保留文件名提示。 -->
            <Border
                Margin="0,0,8,8"
                CornerRadius="4"
                KeyboardAcceleratorPlacementMode="Hidden"
                ToolTipService.ToolTip="{x:Bind FileName}">
                <Grid>
                    <!-- 骨架屏 / 缩略图 / 错误占位三态由控件按 ThumbnailState 切换。
                         绑定都必须 OneWay：x:Bind 默认 OneTime 会停在首帧的 null。
                         AspectRatio 供控件把骨架裁成与图片相同的形状，避免淡入时形状跳变。 -->
                    <controls:ThumbnailPresenter
                        AspectRatio="{x:Bind AspectRatio, Mode=OneWay}"
                        Source="{x:Bind Thumbnail, Mode=OneWay}"
                        State="{x:Bind ThumbnailState, Mode=OneWay}"/>

                    <Border
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="4"
                        Padding="4,2"
                        Background="{ThemeResource PixbianItemOverlayBrush}"
                        CornerRadius="4"
                        Visibility="{x:Bind IsVideo, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Foreground="{ThemeResource PixbianItemOverlayForegroundBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind DurationText}"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 自适应视图条目模板（每组内嵌的非分组 GridView 使用） -->
        <DataTemplate x:Key="JustifiedItemTemplate"
                      x:DataType="models:MediaItemViewModel">
            <!-- 不带 Margin：间距由 JustifiedPanel 的 Spacing 承担，
                 否则内容区比分配尺寸少 8px，宽高比与位图失配，缩略图边缘会露出背景色。 -->
            <!-- KeyboardAcceleratorPlacementMode="Hidden"：同上，避免页面级快捷键文本混入文件名提示。 -->
            <Border
                CornerRadius="4"
                KeyboardAcceleratorPlacementMode="Hidden"
                ToolTipService.ToolTip="{x:Bind FileName}">
                <Grid>
                    <!-- 骨架屏 / 缩略图 / 错误占位三态由控件按 ThumbnailState 切换。
                         绑定都必须 OneWay：x:Bind 默认 OneTime 会停在首帧的 null。
                         AspectRatio 供控件把骨架裁成与图片相同的形状，避免淡入时形状跳变。 -->
                    <controls:ThumbnailPresenter
                        AspectRatio="{x:Bind AspectRatio, Mode=OneWay}"
                        Source="{x:Bind Thumbnail, Mode=OneWay}"
                        State="{x:Bind ThumbnailState, Mode=OneWay}"/>

                    <Border
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="4"
                        Padding="4,2"
                        Background="{ThemeResource PixbianItemOverlayBrush}"
                        CornerRadius="4"
                        Visibility="{x:Bind IsVideo, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Foreground="{ThemeResource PixbianItemOverlayForegroundBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind DurationText}"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 页头行 / 统计行 / 内容区 -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头行：图标 + 名称在左，两种工具栏在右（Visibility 互斥，占同一位置） -->
        <Grid
            Grid.Row="0"
            Padding="48,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">
                <SymbolIcon Symbol="{x:Bind ViewModel.PageIcon, Mode=OneWay}"/>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"/>
            </StackPanel>

            <!-- 工具栏宿主：占满剩余宽度。
                 宽度不足时按窗口断点把右侧按钮收进「更多」菜单，用 AdaptiveTrigger + VisualState
                 声明（规范 §2.3【必须】），不在 C# 里监听 SizeChanged 改布局参数。
                 断点取规范档位：≥1008 宽松全显；640~1007 中等收起选择/幻灯片；<640 紧凑再收起排序。 -->
            <Grid
                x:Name="ToolBarHost"
                Grid.Column="1"
                HorizontalAlignment="Stretch">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="ToolBarOverflowStates">
                        <VisualState x:Name="WideToolBar">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1008"/>
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="MediumToolBar">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="640"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SelectButton.Visibility"
                                        Value="Collapsed"/>
                                <Setter Target="SlideShowButton.Visibility"
                                        Value="Collapsed"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="NarrowToolBar">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SelectButton.Visibility"
                                        Value="Collapsed"/>
                                <Setter Target="SlideShowButton.Visibility"
                                        Value="Collapsed"/>
                                <Setter Target="SortButton.Visibility"
                                        Value="Collapsed"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

        <!-- 普通模式工具栏 -->
        <!-- 三个下拉按钮的菜单项在每次 Opening 时按当前状态重建，故勾选态与可用态永远是最新的，
             不必再维护 x:Name 引用去反向同步；「更多」菜单按各按钮当前 Visibility 补齐被收起的命令。 -->
        <StackPanel
            x:Name="NormalToolBar"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="4"
            Visibility="{x:Bind IsSelectionMode, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}">
                <Button
                    x:Name="SelectButton"
                    AutomationProperties.Name="选择"
                    Click="OnSelectClick"
                    Style="{StaticResource ToolBarButtonStyle}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon FontSize="16"
                                  Glyph="&#xE73A;"/>
                        <TextBlock Text="选择"/>
                    </StackPanel>
                </Button>

                <Button
                    x:Name="SlideShowButton"
                    AutomationProperties.Name="幻灯片放映"
                    Click="OnSlideShowClick"
                    IsEnabled="{x:Bind HasItems, Mode=OneWay}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTipService.ToolTip="开始幻灯片放映（F5）">
                    <FontIcon FontSize="16"
                              Glyph="&#xE786;"/>
                </Button>

                <Button
                    x:Name="SortButton"
                    AutomationProperties.Name="排序"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTipService.ToolTip="排序">
                    <Button.Flyout>
                        <MenuFlyout Opening="OnSortMenuOpening"/>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal"
                                Spacing="4">
                        <FontIcon FontSize="16"
                                  Glyph="&#xE174;"/>
                        <FontIcon Style="{StaticResource DropDownChevronStyle}"/>
                    </StackPanel>
                </Button>

                <Button
                    x:Name="FilterButton"
                    AutomationProperties.Name="筛选"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTipService.ToolTip="筛选">
                    <Button.Flyout>
                        <MenuFlyout Opening="OnKindMenuOpening"/>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal"
                                Spacing="4">
                        <FontIcon FontSize="16"
                                  Glyph="&#xE71C;"/>
                        <FontIcon Style="{StaticResource DropDownChevronStyle}"/>
                    </StackPanel>
                </Button>

                <Button
                    x:Name="ViewModeButton"
                    AutomationProperties.Name="显示和大小"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTipService.ToolTip="显示和大小">
                    <Button.Flyout>
                        <MenuFlyout Opening="OnViewMenuOpening"/>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal"
                                Spacing="4">
                        <FontIcon FontSize="16"
                                  Glyph="&#xECA5;"/>
                        <FontIcon Style="{StaticResource DropDownChevronStyle}"/>
                    </StackPanel>
                </Button>

                <Button
                    x:Name="MoreButton"
                    AutomationProperties.Name="更多"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTipService.ToolTip="更多">
                    <Button.Flyout>
                        <MenuFlyout Opening="OnMoreMenuOpening"/>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal"
                                Spacing="4">
                        <FontIcon FontSize="16"
                                  Glyph="&#xE712;"/>
                    </StackPanel>
                </Button>
        </StackPanel>

        <!-- 选择模式工具栏：与普通工具栏占同一格，靠 Visibility 互斥 -->
        <StackPanel
            x:Name="SelectionToolBar"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="4"
            Visibility="{x:Bind IsSelectionMode, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
            <Button
                Click="OnCancelSelectionClick"
                Style="{StaticResource ToolBarButtonStyle}"
                ToolTipService.ToolTip="取消选择">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <FontIcon FontSize="16"
                              Glyph="&#xE711;"/>
                    <TextBlock Text="取消"/>
                </StackPanel>
            </Button>
            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind SelectionCountText, Mode=OneWay}"/>

            <Button
                Click="OnAddFavoriteClick"
                IsEnabled="{x:Bind HasSelection, Mode=OneWay}"
                Style="{StaticResource ToolBarButtonStyle}"
                ToolTipService.ToolTip="收藏">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <FontIcon FontSize="16"
                              Glyph="&#xE734;"/>
                    <TextBlock Text="收藏"/>
                </StackPanel>
            </Button>
            <Button
                Click="OnRemoveFromIndexClick"
                IsEnabled="{x:Bind HasSelection, Mode=OneWay}"
                Style="{StaticResource ToolBarButtonStyle}"
                ToolTipService.ToolTip="从索引移除">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <FontIcon FontSize="16"
                              Glyph="&#xE74D;"/>
                    <TextBlock Text="从索引中删除"/>
                </StackPanel>
            </Button>
            <Button
                Click="OnSlideShowClick"
                IsEnabled="{x:Bind HasSelection, Mode=OneWay}"
                Style="{StaticResource ToolBarButtonStyle}"
                ToolTipService.ToolTip="播放选中项">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <FontIcon FontSize="16"
                              Glyph="&#xE93E;"/>
                    <TextBlock Text="播放"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolBarButtonStyle}"
                    ToolTipService.ToolTip="更多">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Click="OnSelectAllClick"
                            KeyboardAcceleratorTextOverride="Ctrl+A"
                            Text="全选">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8B3;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Click="OnSelectNoneClick"
                            KeyboardAcceleratorTextOverride="Esc, Ctrl+D"
                            Text="不选择任何项目">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE711;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <FontIcon FontSize="16"
                              Glyph="&#xE712;"/>
                    <TextBlock Text="更多"/>
                    <FontIcon Style="{StaticResource DropDownChevronStyle}"/>
                </StackPanel>
            </Button>
        </StackPanel>
            </Grid>
        </Grid>

        <!-- 统计行：反映当前筛选结果（类型 / 收藏 / 搜索）的全量规模，而非已加载页数。
             某一类为 0 时整项不显示，避免出现「0 个视频」这类无信息量的零值。 -->
        <TextBlock
            Grid.Row="1"
            Padding="48,0,48,8"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.StatisticsText, Mode=OneWay}"/>

        <!-- 自适应行式视图 -->
        <ScrollViewer
            x:Name="JustifiedView"
            Grid.Row="2"
            DoubleTapped="OnItemDoubleTapped"
            Padding="48,4,48,16"
            Visibility="{x:Bind IsJustifiedView, Mode=OneWay}"
            ViewChanged="OnScrollViewChanged">
            <GridView
                x:Name="JustifiedGridView"
                ContainerContentChanging="OnContainerContentChanging"
                DoubleTapped="OnItemDoubleTapped"
                IsItemClickEnabled="True"
                ItemClick="OnItemClick"
                ItemTemplate="{StaticResource JustifiedItemTemplate}"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                Loaded="OnJustifiedGridLoaded"
                RightTapped="OnItemRightTapped"
                SelectionChanged="OnSelectionChanged"
                SelectionMode="Extended"
                Unloaded="OnJustifiedGridUnloaded">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin"
                                Value="0"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewItem">
                                    <Grid>
                                        <ContentPresenter/>
                                        <Border
                                            x:Name="MaskBorder"
                                            Background="{ThemeResource PixbianItemHover}"
                                            CornerRadius="4"
                                            Opacity="0"/>
                                        <CheckBox
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,4,4,0"
                                            MinWidth="0"
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                            Visibility="{Binding Data.IsSelectionMode, Source={StaticResource PageProxy}, Converter={StaticResource BoolToVisibility}}"/>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="MaskBorder.Opacity"
                                                                Value="0.05"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="MaskBorder.Opacity"
                                                                Value="0.08"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Spacing 承担全部间距：条目模板不再带 Margin，内容区宽高比才与位图一致。 -->
                        <controls:JustifiedPanel Spacing="12"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>
        </ScrollViewer>

        <!-- 方形网格视图 -->
        <ScrollViewer
            x:Name="GridViewView"
            Grid.Row="2"
            Padding="48,4,48,16"
            Visibility="{x:Bind IsGridView, Mode=OneWay}"
            ViewChanged="OnScrollViewChanged">
            <GridView
                x:Name="GridViewControl"
                ContainerContentChanging="OnContainerContentChanging"
                IsItemClickEnabled="True"
                ItemClick="OnItemClick"
                RightTapped="OnItemRightTapped"
                DoubleTapped="OnItemDoubleTapped"
                ItemTemplate="{StaticResource MediaItemTemplate}"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                SelectionChanged="OnSelectionChanged"
                SelectionMode="Extended">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin"
                                Value="0"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewItem">
                                    <Grid>
                                        <ContentPresenter/>
                                        <Border
                                            x:Name="MaskBorder"
                                            Background="Black"
                                            CornerRadius="4"
                                            Opacity="0"/>
                                        <CheckBox
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,4,4,0"
                                            MinWidth="0"
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                            Visibility="{Binding Data.IsSelectionMode, Source={StaticResource PageProxy}, Converter={StaticResource BoolToVisibility}}"/>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="MaskBorder.Opacity"
                                                                Value="0.05"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="MaskBorder.Opacity"
                                                                Value="0.08"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!--
                            方形网格用内建 ItemsWrapGrid：分组 GridView 配自定义 ItemsPanel 时
                            面板只能拿到 GroupItem 组容器，条目根本不渲染，故网格视图也走整库非分组流。
                            条目边长由 ItemWidth / ItemHeight 决定，传统 Binding 取页面 DataContext。
                        -->
                        <winui:ItemsWrapGrid
                            ItemHeight="{Binding GridItemHeight}"
                            ItemWidth="{Binding GridItemWidth}"
                            Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>
        </ScrollViewer>

        <!-- 空 / 加载状态 -->
        <StackPanel
            Grid.Row="2"
