<!--
    应用程序定义（M0 骨架）。
    合并 XamlControlsResources 是 WinUI 3 的必需步骤，用于加载 WinUI 控件样式与主题资源字典。
    M2 里程碑将在此追加应用级主题字典与共享样式。
-->
<Application
    x:Class="Pixbian.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    注意：不可设置 ControlsResourcesVersion 属性。
                    该属性自 Windows App SDK 1.7 起才可用，在 1.6 上会触发 WMC0011「Unknown member」编译错误。
                -->
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
