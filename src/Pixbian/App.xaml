<!--
    应用程序定义（M0 骨架）。
    合并 XamlControlsResources 是 WinUI 3 的必需步骤，用于加载 WinUI 控件样式与主题资源字典。
    M2 里程碑将在此追加应用级主题字典与共享样式。
-->
<Application
    x:Class="Pixbian.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    注意：不可设置 ControlsResourcesVersion 属性。
                    该属性自 Windows App SDK 1.7 起才可用，在 1.6 上会触发 WMC0011「Unknown member」编译错误。
                -->
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!--
                自定义导航配色：栏（顶部标题栏 + 左侧导航）与主内容区各一套，
                浅色(Default)/深色(Dark)分别定义，主题切换时由框架自动选字典，
                无需 C# 代码。颜色为项目自定义固定值，不依赖 SystemAccentColor。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PixbianPaneBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="PixbianContentBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PixbianPaneBrush" Color="#202020" />
                    <SolidColorBrush x:Key="PixbianContentBrush" Color="#1A1A1A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 覆盖 NavigationView 背景键，引用自定义主题画刷（展开/折叠同色） -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource PixbianPaneBrush}" />
            <SolidColorBrush x:Key="NavigationViewPaneBackground" Color="{ThemeResource PixbianPaneBrush}" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource PixbianContentBrush}" />
        </ResourceDictionary>
    </Application.Resources>

</Application>
