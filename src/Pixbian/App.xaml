<!--
    应用程序定义：集中管理应用级 XAML 资源，分区如下。
      ① 合并字典：WinUI 控件资源（必需项）+ 自定义控件默认样式；
      ② 主题字典：Pixbian* 自定义语义键（浅色 Default / 深色 Dark 各一套，随主题切换自动生效），
        其中含对 TextControl 边框两条系统键的有意覆盖（值随主题，故置于主题字典内）；
      ③ 共享样式：跨页面复用的自定义样式；
      ④ 常量语义键：不随主题反转的固定配色；
      ⑤ 系统键覆盖区：全应用唯一允许覆盖常量型系统键的位置，仅收有意偏离默认的键，
        每条注明包内默认值与偏离理由；与默认同值的键一律不覆盖（先查包内 generic.xaml）。
    关键约束：应用级顶层字典内严禁 StaticResource 重定向系统状态键——StaticResource 只在
    启动主题下解析一次，主题切换后仍钉死旧主题值（曾致深色下菜单项悬停背景不可见）；
    确需覆盖且取值随主题的系统键时，条目必须放入 ThemeDictionaries 对应字典内。
-->
<Application
    x:Class="Pixbian.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Application.Resources>
        <ResourceDictionary>
            <!-- ① 合并字典 -->
            <ResourceDictionary.MergedDictionaries>
                <!--
                    WinUI 3 控件样式与主题资源，必需合并项。
                    注意：不可设置 ControlsResourcesVersion 属性。
                    该属性自 Windows App SDK 1.7 起才可用，在 1.6 上会触发 WMC0011「Unknown member」编译错误。
                -->
                <controls:XamlControlsResources/>

                <!-- 自定义控件的默认样式（隐式 Style，作用于全应用）。 -->
                <ResourceDictionary Source="Controls/ThumbnailPresenter.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                ② 主题字典：Pixbian* 自定义语义键。
                业务引用一律用 ThemeResource——StaticResource 加载时一次性查找、无法随主题切换
                （曾因此被迫把键定义在字典外）。颜色必须写 8 位 #AARRGGBB：只写 6 位没有 alpha 通道，
                等价于完全不透明（曾误写 #CCCCCC，实际并未半透明）。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- 列表项蒙版 -->
                    <SolidColorBrush x:Key="PixbianItemHover"
                                     Color="#000000"/>
                    <SolidColorBrush x:Key="PixbianItemPressed"
                                     Color="#000000"/>
                    <!-- 列表项复选框衬底：两档白色、两主题同值——压在图片内容上，颜色不应随主题反转
                         （未选中时衬出空心框轮廓，选中时形成白边包蓝块）。
                         Subtle 60% 白：hover 图片浮现复选框、但鼠标未在框上的常态；
                         主档 80% 白：鼠标 hover 到框本身（PointerOver/Pressed）时加深提示可交互。 -->
                    <SolidColorBrush x:Key="PixbianItemCheckBackdropSubtle"
                                     Color="#99FFFFFF"/>
                    <SolidColorBrush x:Key="PixbianItemCheckBackdrop"
                                     Color="#CCFFFFFF"/>
                    <!-- 缩略图骨架屏：加载中的占位底色，取接近内容区的浅灰，避免加载完成时对比过强 -->
                    <SolidColorBrush x:Key="PixbianSkeletonBrush"
                                     Color="#F0F0F0"/>
                    <!-- 浮在缩略图之上的时长角标：底色 + 文字色一对，均不随主题变化。
                         压在图片内容之上，且角标底恒为半透明黑，故文字恒为白；
                         若底色随主题反转（浅色主题下变浅灰），白字将不可读。
                         不用系统 TextFillColorInverseBrush——它的语义正是「随主题反转」。
                         两个主题取同值是有意为之，不是漏配。 -->
                    <SolidColorBrush x:Key="PixbianItemOverlayBrush"
                                     Color="#80000000"/>
                    <SolidColorBrush x:Key="PixbianItemOverlayForegroundBrush"
                                     Color="#FFFFFF"/>
                    <!-- 右键菜单只读信息项前景（大小/尺寸/日期/位置） -->
                    <SolidColorBrush x:Key="ContextMenuInfoForeground"
                                     Color="#6B6B6B"/>
                    <!-- 内容区卡片：底色 80% 磨砂白压渐变背景，描边浅灰 35%（#59 ≈ 0x59/255）。 -->
                    <SolidColorBrush x:Key="PixbianContentCardBackground"
                                     Color="#99FFFFFF"/>
                    <SolidColorBrush x:Key="PixbianContentCardBorderBrush"
                                     Color="#59CCCCCC"/>
                    <!-- 窗口背景基调（线性光，实测参考图浅色窗口底色）：顶部冷蓝清透 → 中部过渡 → 底部微暖提亮；
                         光晕层与深色一致转全透明，光感全部由线性渐变表达。 -->
                    <LinearGradientBrush x:Key="PixbianWallpaperGradient"
                                         StartPoint="0,0"
                                         EndPoint="0,1">
                        <GradientStop Offset="0"
                                      Color="#EDF5F9"/>
                        <GradientStop Offset="0.45"
                                      Color="#EEF4F9"/>
                        <GradientStop Offset="1"
                                      Color="#F0F3F9"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="PixbianWallpaperGlow"
                                     Color="#00FFFFFF"/>
                    <!-- 【系统键覆盖·随主题】输入框边框：默认 TextControlElevationBorderBrush
                         是底部 45% 黑的竖向渐变（2.3.6 包内 generic.xaml 880 行），有意改为纯色细描边。
                         条目置于主题字典内（与包内 generic.xaml 同构），随主题切换正确解析。 -->
                    <StaticResource x:Key="TextControlBorderBrush"
                                    ResourceKey="ControlStrokeColorDefaultBrush"/>
                    <StaticResource x:Key="TextControlBorderBrushPointerOver"
                                    ResourceKey="ControlStrokeColorDefaultBrush"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PixbianItemHover"
                                     Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="PixbianItemPressed"
                                     Color="#FFFFFF"/>
                    <!-- 列表项复选框衬底与 Default 同值（压在图片内容上，不随主题反转） -->
                    <SolidColorBrush x:Key="PixbianItemCheckBackdropSubtle"
                                     Color="#99FFFFFF"/>
                    <SolidColorBrush x:Key="PixbianItemCheckBackdrop"
                                     Color="#CCFFFFFF"/>
                    <!-- 缩略图骨架屏：加载中的占位底色，深色主题下同取更浅的灰以与内容区区分 -->
                    <SolidColorBrush x:Key="PixbianSkeletonBrush"
                                     Color="#333333"/>
                    <!-- 角标底与文字色：与 Default 同值，理由见上方 Default 字典中的同名键注释。 -->
                    <SolidColorBrush x:Key="PixbianItemOverlayBrush"
                                     Color="#80000000"/>
                    <SolidColorBrush x:Key="PixbianItemOverlayForegroundBrush"
                                     Color="#FFFFFF"/>
                    <!-- 右键菜单只读信息项前景（大小/尺寸/日期/位置） -->
                    <SolidColorBrush x:Key="ContextMenuInfoForeground"
                                     Color="#9A9A9A"/>
                    <!-- 内容区卡片：60% 磨砂深灰压渐变背景（与浅色磨砂白同一思路），
                         描边用 35% 白，与浅色的 35% 灰取同一 alpha 以保证两主题视觉权重对称
                         （深色下更淡的白描边几乎不可见）。前景文字走主题资源自动反转。 -->
                    <SolidColorBrush x:Key="PixbianContentCardBackground"
                                     Color="#66282828"/>
                    <SolidColorBrush x:Key="PixbianContentCardBorderBrush"
                                     Color="#59191919"/>
                    <!-- 窗口背景基调（线性光，实测参考图深色窗口底色）：顶部冷蓝 → 中部沉黑 → 底部微暖，
                         仅用线性渐变表达纵深感；光晕键保留但全透明——两主题共用同一模板结构，
                         键缺失会致资源解析崩溃。 -->
                    <LinearGradientBrush x:Key="PixbianWallpaperGradient"
                                         StartPoint="0,0"
                                         EndPoint="0,1">
                        <GradientStop Offset="0"
                                      Color="#1B2225"/>
                        <GradientStop Offset="0.45"
                                      Color="#1D2124"/>
                        <GradientStop Offset="1"
                                      Color="#1E2023"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="PixbianWallpaperGlow"
                                     Color="#00FFFFFF"/>
                    <!-- 【系统键覆盖·随主题】同 Default 字典，见上。 -->
                    <StaticResource x:Key="TextControlBorderBrush"
                                    ResourceKey="ControlStrokeColorDefaultBrush"/>
                    <StaticResource x:Key="TextControlBorderBrushPointerOver"
                                    ResourceKey="ControlStrokeColorDefaultBrush"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ③ 共享样式：跨页面复用的自定义样式，集中定义避免逐元素散落（规范 §6）。 -->

            <!-- 右键菜单只读信息项样式：仅约束最大宽度，避免长路径撑开整个菜单。
                 不用自定义 ControlTemplate 做换行（其应用会触发 WinUI 3 的旋转忙碌光标）；
                 信息项当前按单行呈现，内容由代码拼装后经 MaxWidth 截断。 -->
            <Style x:Key="ReadOnlyMenuItemStyle"
                   TargetType="MenuFlyoutItem">
                <Setter Property="MaxWidth"
                        Value="320"/>
            </Style>

            <!-- 页头图标样式：图标与标题文字（TitleTextBlockStyle）视觉大小对齐，故取同档字号；
                 FontFamily 指向主题键，不随主题变的内容走样式本身即可。 -->
            <Style x:Key="PageHeaderIconStyle"
                   TargetType="FontIcon">
                <Setter Property="FontSize"
                        Value="28"/>
                <Setter Property="FontFamily"
                        Value="{ThemeResource SymbolThemeFontFamily}"/>
                <Setter Property="VerticalAlignment"
                        Value="Center"/>
            </Style>

            <!-- 正文「中号」：Fluent 排版阶梯无 16px 档（实测 WinUI 内置为
                 Caption 12 / Body 14 / BodyLarge 18 / Subtitle 20 / Title 28），
                 故按同一命名惯例补 BodyMedium 一档，填补 14 与 18 之间。
                 命名不绑定具体场景（各页面通用）。 -->
            <Style x:Key="BodyMediumTextBlockStyle"
                   TargetType="TextBlock">
                <Setter Property="FontSize"
                        Value="16"/>
            </Style>

            <!-- ④ 常量语义键：不随主题反转的固定配色，置于主题字典之外是有意为之。 -->

            <!-- 播放态卡片底色：纯黑不透明，与播放器页的舞台底色一致——
                 电影模式下的舞台恒为黑，不随主题反转。
                 播放态由代码后置覆盖到内容卡片上，退出播放时 ClearValue 回落到 Style 初值。 -->
            <SolidColorBrush x:Key="PixbianPlayerCardBackground"
                             Color="#FF000000"/>

            <!--
                ⑤ 系统键覆盖区：仅收「常量取值、有意偏离默认」的系统键。
                通用原则：覆盖前先查包内 generic.xaml（microsoft.windowsappsdk.winui/<版本>/
                lib/net6.0-windows10.0.17763.0/Microsoft.WinUI/Themes/generic.xaml）核实默认值，
                与默认同值不覆盖；取值随主题的键放主题字典（见 ②），不放此处。
            -->

            <!-- 导航栏与内容区背景转透明：让主窗口根布局底层的背景图透出。
                 仍按 NavigationView 模板的真实绑定设置，勿凭文档想当然：
                   ① 左栏 Pane 与内容并排时（VisualState PaneNotOverlaying），PaneBackground 被
                      显式改为 NavigationViewExpandedPaneBackground，故只改 DefaultPaneBackground
                      在最常见的并排形态下完全无效。但 Expanded/Top 两键的默认值本就是
                      SolidBackgroundFillColorTransparent（2.3.6 包内 generic.xaml 1580/1582 行，
                      透明 Color），无需覆盖，已回归默认。
                   ② 内容区底色由 ContentGrid 的 NavigationViewContentBackground 提供，
                      默认 LayerFillColorDefaultBrush（2455 行，半透明层色）会挡背景图，须转透明；
                      SplitView.Background（TemplateBinding 到 NavigationView 的 Background）
                      则是其下的底层，同样转透明，避免背景图被这层挡住。
                 NavigationViewPaneBackground / NavigationViewBackground 是死键，不要登记。 -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"
                             Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewContentBackground"
                             Color="Transparent"/>

            <!-- 内容区圆角归零：默认 8,0,0,0（32472 行）只对左上角做圆角，但它同时会对内容网格
                 施加圆角裁切，内容区卡片的阴影扩散到网格边界外时会被切掉一角。
                 卡片自身的圆角由卡片自己声明。 -->
            <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>

            <!-- 导航栏边框归零：左栏 Pane 与内容区之间不要任何分割线。
                   ① NavigationViewBorderThickness：RootSplitView 的外框（默认 1，四边，32447 行）。
                   ② NavigationViewContentGridBorderThickness：内容区边框（默认 1,1,0,0，32443 行），
                      其中「左 1」正是 Pane 与内容区之间那条竖线。
                 不要把 NavigationViewItemSeparatorForeground 改成透明画刷——那支画笔还被
                 Top 模式的 SeparatorLine 等元素复用，会误伤。 -->
            <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
        </ResourceDictionary>
    </Application.Resources>

</Application>
