<!--
    应用程序定义（M0 骨架）。
    合并 XamlControlsResources 是 WinUI 3 的必需步骤，用于加载 WinUI 控件样式与主题资源字典。
    M2 里程碑将在此追加应用级主题字典与共享样式。
-->
<Application
    x:Class="Pixbian.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    注意：不可设置 ControlsResourcesVersion 属性。
                    该属性自 Windows App SDK 1.7 起才可用，在 1.6 上会触发 WMC0011「Unknown member」编译错误。
                -->
                <controls:XamlControlsResources/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                全局颜色集中管理（单一入口）。
                分层：
                  ① Pixbian* 自定义语义键：项目专属的固定配色，浅色(Default)/深色(Dark)各一套，主题切换自动生效。
                  ② 抄录式状态键：把 NavigationView / TextControl 等系统控件的状态键在此登记，
                     取值用 StaticResource 指回 WinUI 3 默认语义键，视觉与系统一致、零变化，
                     仅作为“一处可查可改”的集中入口（改色时只需把 ResourceKey 换成 Pixbian* 即可）。
                不抄录未纳入管理诉求的系统键（如 TextFillColorPrimaryBrush），保持其系统默认直接提供。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- ① 自定义：栏（顶部标题栏 + 左侧导航）/ 主内容区 / 列表项蒙版 -->
                    <SolidColorBrush x:Key="PixbianPaneBrush"
                                     Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="PixbianContentBrush"
                                     Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="PixbianItemHover"
                                     Color="#000000"/>
                    <SolidColorBrush x:Key="PixbianItemPressed"
                                     Color="#000000"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PixbianPaneBrush"
                                     Color="#202020"/>
                    <SolidColorBrush x:Key="PixbianContentBrush"
                                     Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="PixbianItemHover"
                                     Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="PixbianItemPressed"
                                     Color="#FFFFFF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 导航栏背景：引用自定义栏配色（展开/折叠同色） -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"
                             Color="{ThemeResource PixbianPaneBrush}"/>
            <SolidColorBrush x:Key="NavigationViewPaneBackground"
                             Color="{ThemeResource PixbianPaneBrush}"/>
            <SolidColorBrush x:Key="NavigationViewContentBackground"
                             Color="{ThemeResource PixbianContentBrush}"/>

            <!-- ② 抄录 NavigationView 项状态键（取值=WinUI 3 默认语义键，集中可见、不改色） -->
            <StaticResource x:Key="NavigationViewItemBackground"
                            ResourceKey="SubtleFillColorTransparentBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundPointerOver"
                            ResourceKey="SubtleFillColorSecondaryBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundPressed"
                            ResourceKey="SubtleFillColorTertiaryBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundSelected"
                            ResourceKey="SubtleFillColorSecondaryBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver"
                            ResourceKey="SubtleFillColorTertiaryBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed"
                            ResourceKey="SubtleFillColorSecondaryBrush"/>
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedDisabled"
                            ResourceKey="SubtleFillColorSecondaryBrush"/>

            <!-- ② 抄录 TextControl 边框状态键（取值=WinUI 3 默认语义键） -->
            <StaticResource x:Key="TextControlBorderBrush"
                            ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="TextControlBorderBrushPointerOver"
                            ResourceKey="TextControlElevationBorderBrush"/>
            <StaticResource x:Key="TextControlBorderBrushFocused"
                            ResourceKey="TextControlElevationBorderFocusedBrush"/>
            <StaticResource x:Key="TextControlBorderBrushDisabled"
                            ResourceKey="ControlStrokeColorDefaultBrush"/>
        </ResourceDictionary>
    </Application.Resources>

</Application>
