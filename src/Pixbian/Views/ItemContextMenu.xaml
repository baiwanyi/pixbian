<!--
    图片右键上下文菜单的结构定义（仅承载 UI 结构，交互逻辑在 GalleryPage.xaml.cs 中按 x:Name 绑定）。

    复用约定：
    - 颜色集中管理于 App.xaml 的 ThemeDictionaries，只读信息项（大小/尺寸/日期/位置）统一引用
      ContextMenuInfoForeground 主题键，明暗主题自动切换，不在本文件硬编码色值。
    - 菜单项顺序与文案严格对应产品需求；新增/调整菜单项只需修改本文件。
    - 需要可点击的项（打开/复制/复制为路径/重命名/删除）通过 x:Name 暴露，由页面代码后置绑定 Click 事件，
      因此本资源字典不带 x:Class，避免与页面交互状态耦合。

    关键约束：
    - 只读信息项 Must 用 IsEnabled="False" 呈现（不可点、可见），前景色走 ContextMenuInfoForeground。
    - 分隔线使用 MenuFlyoutSeparator；顺序为 打开→复制→复制为路径→重命名→分隔线→(大小/尺寸/日期/位置)→分隔线→删除。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <MenuFlyout x:Key="ItemContextMenu">
        <MenuFlyoutItem x:Name="MenuOpen"
                        Text="打开"/>
        <MenuFlyoutItem x:Name="MenuCopy"
                        Text="复制"
                        KeyboardAcceleratorTextOverride="Ctrl+C"/>
        <MenuFlyoutItem x:Name="MenuCopyPath"
                        Text="复制为路径"/>
        <MenuFlyoutItem x:Name="MenuRename"
                        Text="重命名"/>
        <MenuFlyoutSeparator/>
        <MenuFlyoutItem x:Name="MenuSize"
                        Foreground="{ThemeResource ContextMenuInfoForeground}"
                        IsEnabled="False"
                        Text="大小："/>
        <MenuFlyoutItem x:Name="MenuDimensions"
                        Foreground="{ThemeResource ContextMenuInfoForeground}"
                        IsEnabled="False"
                        Text="尺寸："/>
        <MenuFlyoutItem x:Name="MenuDate"
                        Foreground="{ThemeResource ContextMenuInfoForeground}"
                        IsEnabled="False"
                        Text="日期："/>
        <MenuFlyoutItem x:Name="MenuLocation"
                        Foreground="{ThemeResource ContextMenuInfoForeground}"
                        IsEnabled="False"
                        Text="位置："/>
        <MenuFlyoutSeparator/>
        <MenuFlyoutItem x:Name="MenuDelete"
                        Text="删除"
                        KeyboardAcceleratorTextOverride="Delete"/>
    </MenuFlyout>
</ResourceDictionary>
