<!--
    分类规则管理页：分类与规则的增删改查、启停与批量重新匹配。
    行结构与设置页「媒体库」区块同构：单张卡片内三个行（分类管理 / 规则管理 /
    重新匹配），前两行以样式化 Expander 承载、展开后内嵌条目列表并互斥展开，
    末行固定负责重新匹配；两行副标题分别承载动态计数，重新匹配行承载操作反馈。
    新建与编辑共用页内表单面板（运行时移交给 ContentDialog），输入即时校验。
    作为设置页「分类」卡片的展开内容使用，留白由宿主承担，根布局不再自带内边距。
-->
<Page
    x:Class="Pixbian.Views.CategoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Pixbian.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pixbian.Core.Models"
    xmlns:vm="using:Pixbian.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility"
                IsInverted="True"/>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 单张卡片：与「媒体库」区块同构，行间以 1px 分隔线区隔。 -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel>

                <!-- 行：分类管理。Expander 融入外层卡片的资源覆盖与媒体库行同构：
                     边框归零、底色透明，展开箭头是唯一的可展开视觉提示。
                     列表禁用自身滚动，交给外层设置页统一滚动。 -->
                <Expander
                    x:Name="CategoriesSection"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="0"
                    Loaded="OnSectionExpanderLoaded"
                    Expanding="OnCategorySectionExpanding">
                    <Expander.Resources>
                        <Thickness x:Key="ExpanderBorderThickness">0</Thickness>
                        <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                        <Thickness x:Key="ExpanderChevronMargin">8,0,8,0</Thickness>
                        <StaticResource x:Key="ExpanderBorderBrush"
                                        ResourceKey="SubtleFillColorTransparentBrush"/>
                        <StaticResource x:Key="ExpanderHeaderBorderBrush"
                                        ResourceKey="SubtleFillColorTransparentBrush"/>
                        <StaticResource x:Key="ExpanderContentBorderBrush"
                                        ResourceKey="SubtleFillColorTransparentBrush"/>
                        <StaticResource x:Key="ExpanderHeaderBackground"
                                        ResourceKey="SubtleFillColorTransparentBrush"/>
                        <StaticResource x:Key="ExpanderContentBackground"
                                        ResourceKey="SubtleFillColorTransparentBrush"/>
                    </Expander.Resources>
                    <Expander.Header>
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 空心文件夹 ED25：与媒体库行统一。 -->
                            <FontIcon
                                Grid.Column="0"
                                Glyph="&#xED25;"
                                Style="{StaticResource SettingsRowIconStyle}"/>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="分类管理"/>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.CategoryCountText, Mode=OneWay}"/>
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="新建分类"
                                Click="OnNewCategoryClick"
                                Content="新建分类"/>
                        </Grid>
                    </Expander.Header>

                    <StackPanel>
                        <TextBlock
                            Margin="24,0,24,8"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="禁用分类只使其下规则退出自动匹配，左栏导航与已有归属不受影响。"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasCategories, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock
                            Margin="24,4,24,12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="暂无分类，点击右上角「新建分类」创建。"
                            Visibility="{x:Bind ViewModel.HasCategories, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}"/>

                        <ListView
                            ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <!-- 归零默认容器 Padding 与 MinHeight，与媒体库列表一致：
                                     条目行距由条目模板的 Padding 承担。 -->
                                <Style TargetType="ListViewItem"
                                        BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="Padding"
                                            Value="0"/>
                                    <Setter Property="MinHeight"
                                            Value="24"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Category">
                                    <Grid
                                        Padding="24,12"
                                        ColumnSpacing="12"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            IsOn 不做绑定：Category 是只读记录，变更通知无法回传，
                                            单向绑定会在加载时触发误写。初始状态在 Loaded 时按值设置，
                                            后续变更统一由 Toggled 事件驱动，状态一致视为回声直接忽略。
                                        -->
                                        <ToggleSwitch
                                            Grid.Column="0"
                                            MinWidth="0"
                                            Loaded="OnCategoryToggleLoaded"
                                            Toggled="OnCategoryToggled"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis"/>

                                        <Button
                                            Grid.Column="2"
                                            AutomationProperties.Name="编辑分类"
                                            Click="OnEditCategoryClick"
                                            Padding="6"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="重命名分类">
                                            <FontIcon
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="14"
                                                Glyph="&#xE70F;"/>
                                        </Button>

                                        <Button
                                            Grid.Column="3"
                                            AutomationProperties.Name="删除分类"
                                            Click="OnDeleteCategoryClick"
                                            Padding="6"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="删除分类（其下规则一并删除）">
                                            <FontIcon
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="14"
                                                Glyph="&#xE74D;"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Expander>

                <Border
                    Height="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- 行：规则管理。与分类管理互斥展开（见代码后置）。 -->
                <Expander
                    x:Name="RulesSection"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="0"
                    Loaded="OnSectionExpanderLoaded"
                    Expanding="OnRuleSectionExpanding">
                    <Expander.Resources>
                        <Thickness x:Key="ExpanderBorderThickness">0</Thickness>
                        <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                        <Thickness x:Key="ExpanderChevronMargin">8,0,8,0</Thickness>
                        <StaticResource x:Key="ExpanderBorderBrush"
                                        ResourceKey="SubtleFillColorTransparentBrush"/>
                        <StaticResource x:Key="ExpanderHeaderBorderBrush"
                                        ResourceKey="SubtleFillColorTransparentBrush"/>
                        <StaticResource x:Key="ExpanderContentBorderBrush"
                                        ResourceKey="SubtleFillColorTransparentBrush"/>
                        <StaticResource x:Key="ExpanderHeaderBackground"
                                        ResourceKey="SubtleFillColorTransparentBrush"/>
                        <StaticResource x:Key="ExpanderContentBackground"
                                        ResourceKey="SubtleFillColorTransparentBrush"/>
                    </Expander.Resources>
                    <Expander.Header>
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                Glyph="&#xE8FD;"
                                Style="{StaticResource SettingsRowIconStyle}"/>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="规则管理"/>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.RuleCountText, Mode=OneWay}"/>
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="新建规则"
                                Click="OnNewRuleClick"
                                Content="新建规则"/>
                        </Grid>
                    </Expander.Header>

                    <StackPanel>
                        <TextBlock
                            Margin="24,0,24,8"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="列表自上而下优先级递减；命中即停止匹配后续规则。"
                            TextWrapping="Wrap"/>

                        <ListView
                            ItemsSource="{x:Bind ViewModel.Rules, Mode=OneWay}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem"
                                        BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="Padding"
                                            Value="0"/>
                                    <Setter Property="MinHeight"
                                            Value="24"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:RuleDisplay">
                                    <Grid
                                        Padding="24,12"
                                        ColumnSpacing="12"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ToggleSwitch
                                            Grid.Column="0"
                                            MinWidth="0"
                                            Loaded="OnRuleToggleLoaded"
                                            Toggled="OnRuleToggled"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind Rule.Name}"
                                            TextTrimming="CharacterEllipsis"/>

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Rule.Pattern}"
                                            TextTrimming="CharacterEllipsis"/>

                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind CategoryName}"
                                            TextTrimming="CharacterEllipsis"/>

                                        <Button
                                            Grid.Column="4"
                                            AutomationProperties.Name="编辑规则"
                                            Click="OnEditRuleClick"
                                            Padding="6"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{x:Bind Rule}"
                                            ToolTipService.ToolTip="编辑规则">
                                            <FontIcon
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="14"
                                                Glyph="&#xE70F;"/>
                                        </Button>

                                        <Button
                                            Grid.Column="5"
                                            AutomationProperties.Name="删除规则"
                                            Click="OnDeleteRuleClick"
                                            Padding="6"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{x:Bind Rule}"
                                            ToolTipService.ToolTip="删除规则">
                                            <FontIcon
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="14"
                                                Glyph="&#xE74D;"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Expander>

                <Border
                    Height="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- 行：重新匹配。固定行，副标题承载操作反馈（匹配进度 / 结果）。 -->
                <Grid Style="{StaticResource SettingsRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 刷新 E72C -->
                    <FontIcon
                        Grid.Column="0"
                        Glyph="&#xE72C;"
                        Style="{StaticResource SettingsRowIconStyle}"/>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="重新匹配"/>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="OnApplyRulesClick"
                        IsEnabled="{x:Bind ViewModel.CanApplyRules, Mode=OneWay}"
                        Content="立即匹配"/>
                </Grid>
            </StackPanel>
        </Border>

        <!--
            新建/编辑分类表单：平时折叠，弹出对话框时作为 Content 移交（元素同属页面
            namescope，x:Bind 保持有效）。同一面板不可同时供两个对话框使用，顺序弹出安全。
        -->
        <Border
            x:Name="CategoryFormPanel"
            Grid.Row="1"
            Visibility="Collapsed">
            <StackPanel Spacing="12">
                <TextBox
                    Header="分类名称"
                    PlaceholderText="如 风景"
                    Text="{x:Bind ViewModel.NewCategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="OnFormCategoryNameChanged"/>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.NewCategoryValidationText, Mode=OneWay}"/>
            </StackPanel>
        </Border>

        <!-- 新建/编辑规则表单：同上，按编辑目标分流保存。 -->
        <Border
            x:Name="RuleFormPanel"
            Grid.Row="1"
            Visibility="Collapsed">
            <StackPanel Spacing="12">
                <TextBox
                    Header="规则名称（可选，留空则使用正则）"
                    PlaceholderText="如 twitter 前缀"
                    Text="{x:Bind ViewModel.NewRuleName, Mode=TwoWay}"/>
                <TextBox
                    Header="正则表达式"
                    PlaceholderText="如 ^(twitter_|TWI_|X_)"
                    Text="{x:Bind ViewModel.NewRulePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="OnFormPatternChanged"/>
                <ComboBox
                    Header="匹配目标"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{x:Bind NewRuleTargetIndex, Mode=TwoWay}"
                    SelectionChanged="OnFormTargetChanged">
                    <ComboBoxItem Content="文件名"/>
                    <ComboBoxItem Content="完整路径"/>
                    <ComboBoxItem Content="扩展名"/>
                </ComboBox>
                <ComboBox
                    Header="归入分类"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                    SelectedValue="{x:Bind ViewModel.NewRuleCategoryId, Mode=TwoWay}"
                    SelectedValuePath="Id"
                    SelectionChanged="OnFormCategoryChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Category">
                            <TextBlock Text="{x:Bind Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Content="区分大小写"
                        IsChecked="{x:Bind ViewModel.NewRuleCaseSensitive, Mode=TwoWay}"/>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.NewRuleValidationText, Mode=OneWay}"
                    TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
