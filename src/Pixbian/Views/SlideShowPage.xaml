<!--
    幻灯片放映页：由独立无边框窗口（SlideShowWindow）承载，舞台背景默认取当前照片的
    虚化放大图（关闭该设置或当前条目为视频时退化为纯黑）。
    图像铺满视口并 Stretch=Uniform 自适应；方向校正由显示旋转承担（平移→旋转声明顺序
    与查看器一致，保证变换语义）。图像分「当前帧」与「旧帧」两层：切换条目时旧帧留存
    到转场动画播完，并沿用上一轮的运动终态（旋转 / 放大 / 平移），避免切出瞬间回跳。
    两帧变换按用途分层：转场位移、方向旋转、画面扩大、转场缩放、画面平移各自独立，
    使转场动画与画面扩大动画互不覆盖（两层缩放相乘）；
    转场动画（滑动 / 淡出 / 溶解）由共享工厂构造、代码后置现场创建。
    底部浮动工具栏默认隐藏，点击画面显示，3 秒无操作自动淡出；关闭前内容整体淡出。
    窗口根元素不是 FrameworkElement，故一律使用传统 Binding（与图片查看器页同一约定）。
-->
<Page
    x:Class="Pixbian.Views.SlideShowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            进度条去圆角：ProgressBar 模板的 CornerRadius 引用主题键 ProgressBarCornerRadius
            （默认 1.5），覆盖为 0 使 2px 细条呈直角——与片段页同一处理。
        -->
        <CornerRadius x:Key="ProgressBarCornerRadius">0</CornerRadius>
    </Page.Resources>

    <!--
        舞台根层：底色为纯黑，虚化背景开启时由背景层覆盖；关闭时背景层淡出即回到纯黑。
        图片以 Uniform 铺满，黑边自然融入舞台。
        关闭放映时本层整体淡出后再关闭窗口。
    -->
    <Grid x:Name="RootLayer" Background="#FF000000">

        <!--
            背景层：当前照片经高斯模糊后的放大图填充舞台（渲染由 BackdropBlurRenderer 承担）。
            旧背景托底、新背景随转场淡入，源由代码后置赋值。
            宽度与舞台等宽、高度按图片比例自适应并居中——与前景图构图一致，
            超出舞台的上下部分由窗口裁掉，观感即「同一张照片的模糊放大版」。
        -->
        <Grid
            x:Name="BackdropLayer"
            IsHitTestVisible="False"
            Opacity="0"
            SizeChanged="OnBackdropLayerSizeChanged">
            <Image
                x:Name="PreviousBackdropElement"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stretch="Uniform"/>
            <Image
                x:Name="DisplayBackdropElement"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stretch="Uniform"/>
            <Grid Background="#66000000"/>
        </Grid>

        <!--
            帧层：接收指针输入（唤出工具栏）。新旧两帧变换分层同构：
            转场位移 → 方向旋转 → 画面扩大 → 转场缩放 → 画面平移。
            旧帧的旋转由代码后置沿用上一轮的终态（EXIF 方向已提前到新帧，不可读当前值），
            旧帧的放大与平移则在转场开始时从显示帧当前值移交，保证切出画面连续。
        -->
        <Grid
            x:Name="FrameHost"
            Background="Transparent"
            PointerReleased="OnFrameHostPointerReleased">
            <Image
                x:Name="PreviousFrameElement"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                RenderTransformOrigin="0.5,0.5"
                Source="{Binding PreviousImage}"
                Stretch="Uniform">
                <Image.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="PreviousFrameTransform"/>
                        <RotateTransform x:Name="PreviousFrameRotation"/>
                        <ScaleTransform x:Name="PreviousFrameZoomScale"/>
                        <ScaleTransform x:Name="PreviousFrameScale"/>
                        <TranslateTransform x:Name="PreviousFramePan"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <Image
                x:Name="DisplayFrameElement"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                RenderTransformOrigin="0.5,0.5"
                Source="{Binding DisplayImage}"
                Stretch="Uniform">
                <Image.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="DisplayFrameTransform"/>
                        <RotateTransform
                            x:Name="DisplayFrameRotation"
                            Angle="{Binding RotationDegrees}"/>
                        <ScaleTransform x:Name="DisplayFrameZoomScale"/>
                        <ScaleTransform x:Name="DisplayFrameScale"/>
                        <TranslateTransform x:Name="DisplayFramePan"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!--
                视频帧层：MediaPlayer 由代码后置懒创建注入（应用启动阶段构造会触发 WinRT 异常），
                换源即显示，无「解码就绪」事件；涉及视频的转场一律走淡入（不做滑动）。
            -->
            <MediaPlayerElement
                x:Name="VideoFrameElement"
                AutoPlay="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Stretch="Uniform"
                Visibility="Collapsed">
                <MediaPlayerElement.RenderTransform>
                    <TranslateTransform x:Name="VideoFrameTransform"/>
                </MediaPlayerElement.RenderTransform>
            </MediaPlayerElement>
        </Grid>

        <!--  无法加载时的提示；显隐由代码后置控制，加载期间静默（避免打开时闪现）  -->
        <StackPanel
            x:Name="FailedHint"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="40"
                Foreground="#99FFFFFF"
                Glyph="&#xEB9F;"/>
            <TextBlock
                Foreground="#99FFFFFF"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="无法加载该图片"/>
        </StackPanel>

        <!--
            底部浮动工具栏：深色半透明底，默认隐藏；按钮样式为应用级共享样式，
            深底上的悬停/按下反馈经 Border.Resources 主题键覆盖（与图片查看器页一致）。
        -->
        <Border
            x:Name="ToolbarRoot"
            Margin="0,0,0,28"
            Padding="12,4"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#AA000000"
            CornerRadius="8"
            IsHitTestVisible="False"
            Opacity="0"
            PointerEntered="OnToolbarPointerEntered"
            PointerExited="OnToolbarPointerExited">
            <Border.Resources>
                <!--  悬停/按下背景：15% 白薄层（深底上的提亮反馈）  -->
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                 Color="#26FFFFFF"/>
                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                 Color="#26FFFFFF"/>
                <!--  禁用：无背景 + 15% 白前景（弱化但不消失，与深底风格一致）  -->
                <SolidColorBrush x:Key="ButtonBackgroundDisabled"
                                 Color="Transparent"/>
                <SolidColorBrush x:Key="ButtonForegroundDisabled"
                                 Color="#26FFFFFF"/>
                <!--  放映开关（ToggleButton）选中/悬停反馈：白前景 + 15% 白底  -->
                <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver"
                                 Color="#FFFFFF"/>
                <SolidColorBrush x:Key="ToggleButtonForegroundPressed"
                                 Color="#FFFFFF"/>
                <SolidColorBrush x:Key="ToggleButtonForegroundChecked"
                                 Color="#FFFFFF"/>
                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver"
                                 Color="#FFFFFF"/>
                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed"
                                 Color="#FFFFFF"/>
                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver"
                                 Color="#26FFFFFF"/>
                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked"
                                 Color="#26FFFFFF"/>
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver"
                                 Color="#26FFFFFF"/>
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed"
                                 Color="#26FFFFFF"/>
            </Border.Resources>
            <StackPanel Orientation="Horizontal"
                        Spacing="2">

                <Button
                    Command="{Binding GoPreviousCommand}"
                    Style="{StaticResource ViewerToolButtonStyle}"
                    ToolTipService.ToolTip="上一张（←）">
                    <SymbolIcon Symbol="Back"/>
                </Button>
                <Button
                    Command="{Binding GoNextCommand}"
                    Style="{StaticResource ViewerToolButtonStyle}"
                    ToolTipService.ToolTip="下一张（→）">
                    <SymbolIcon Symbol="Forward"/>
                </Button>

                <Border
                    Width="1"
                    Height="20"
                    Margin="4,0"
                    Background="#26FFFFFF"/>

                <ToggleButton
                    x:Name="PlayToggle"
                    Checked="OnPlayToggleChecked"
                    IsChecked="{Binding IsPlaying, Mode=OneWay}"
                    Style="{StaticResource ViewerToolButtonStyle}"
                    ToolTipService.ToolTip="播放 / 暂停（空格）"
                    Unchecked="OnPlayToggleUnchecked">
                    <FontIcon Glyph="&#xE768;"/>
                </ToggleButton>

                <Border
                    Width="1"
                    Height="20"
                    Margin="4,0"
                    Background="#26FFFFFF"/>

                <TextBlock
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Foreground="#FFFFFF"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding PositionText}"/>

                <Border
                    Width="1"
                    Height="20"
                    Margin="4,0"
                    Background="#26FFFFFF"/>

                <!--  关闭：从右上角独立按钮移入工具栏；Esc 退出路径不变。  -->
                <Button
                    Click="OnCloseClick"
                    Style="{StaticResource ViewerToolButtonStyle}"
                    ToolTipService.ToolTip="退出放映（Esc）">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                         Color="#26FFFFFF"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                         Color="#40FFFFFF"/>
                    </Button.Resources>
                    <FontIcon FontSize="16"
                              Glyph="&#xE8BB;"/>
                </Button>
            </StackPanel>
        </Border>

        <!--
            底部放映进度：图片按放映间隔走停留时间进度，视频按播放进度（含截取片段区间）。
            2px 满宽贴画面底边，前景 50% 系统蓝（与片段页同一口径）；
            Value 由代码后置以动画 / 轮询补间驱动，不走绑定——绑定赋值会打断动画。
        -->
        <ProgressBar
            x:Name="ProgressFill"
            Height="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Foreground="#800078D4"
            Maximum="1"/>

    </Grid>
</Page>
