<!--
    分类规则管理页（M5）：新建分类、编辑正则规则、启停、优先级排序与批量重新匹配。
    正则合法性在输入时即时校验并给出中文提示，非法规则不允许保存。
    所有颜色均取自 ThemeResource，深浅主题切换时自动生效。
    页面根为 Page（FrameworkElement），可用 x:Bind。
    作为设置页「分类管理」卡片的展开内容使用，留白由宿主承担，根布局不再自带内边距。
-->
<Page
    x:Class="Pixbian.Views.CategoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Pixbian.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pixbian.Core.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility"
                IsInverted="True"/>
    </Page.Resources>

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：新增分类与批量匹配 -->
        <Border
            Grid.Row="0"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="分类管理"/>

                <TextBox
                    x:Name="CategoryNameBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    PlaceholderText="新分类名称"/>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="OnAddCategoryClick"
                    Content="添加分类"/>

                <Button
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Click="OnApplyRulesClick"
                    IsEnabled="{x:Bind ViewModel.CanApplyRules, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal"
                            Spacing="8">
                        <ProgressRing
                            Width="14"
                            Height="14"
                            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="重新匹配全部"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <!-- 新增规则 -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="新建规则"/>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                PlaceholderText="规则名称（可选）"
                                Text="{x:Bind ViewModel.NewRuleName, Mode=TwoWay}"/>

                            <TextBox
                                Grid.Column="1"
                                PlaceholderText="正则表达式，如 IMG_\d{4}"
                                Text="{x:Bind ViewModel.NewRulePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextChanged="OnPatternChanged"/>

                            <ComboBox
                                Grid.Column="2"
                                Header="匹配目标"
                                SelectedIndex="{x:Bind NewRuleTargetIndex, Mode=TwoWay}"
                                SelectionChanged="OnTargetChanged">
                                <ComboBoxItem Content="文件名"/>
                                <ComboBoxItem Content="完整路径"/>
                                <ComboBoxItem Content="扩展名"/>
                            </ComboBox>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                Grid.Column="0"
                                Header="归入分类"
                                ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                                SelectedValue="{x:Bind ViewModel.NewRuleCategoryId, Mode=TwoWay}"
                                SelectedValuePath="Id"
                                SelectionChanged="OnCategoryChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Category">
                                        <TextBlock Text="{x:Bind Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <CheckBox
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Content="区分大小写"
                                IsChecked="{x:Bind ViewModel.NewRuleCaseSensitive, Mode=TwoWay}"/>

                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.NewRuleValidationText, Mode=OneWay}"/>

                            <Button
                                Grid.Column="3"
                                VerticalAlignment="Bottom"
                                Click="OnAddRuleClick"
                                Content="添加规则"
                                IsEnabled="{x:Bind ViewModel.IsNewRuleValid, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="正则校验通过且已选择分类后才能保存"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 规则列表 -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="规则列表"/>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"/>
                        </Grid>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="列表自上而下优先级递减；命中即停止匹配后续规则。"
                            TextWrapping="Wrap"/>

                        <ListView
                            x:Name="RulesListView"
                            MinHeight="80"
                            ItemsSource="{x:Bind ViewModel.Rules, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CategoryRule">
                                    <Grid Padding="8,4"
                                            ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            IsOn 不做绑定：CategoryRule 是只读记录，变更通知无法回传，
                                            单向绑定会在加载时触发误写。初始状态在 Loaded 时按规则设置，
                                            后续变更统一由 Toggled 事件驱动。
                                        -->
                                        <ToggleSwitch
                                            Grid.Column="0"
                                            MinWidth="0"
                                            Loaded="OnRuleToggleLoaded"
                                            Toggled="OnRuleToggled"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis"/>

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Pattern}"
                                            TextTrimming="CharacterEllipsis"/>

                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Target}"/>

                                        <Button
                                            Grid.Column="4"
                                            Click="OnDeleteRuleClick"
                                            Content="删除"
                                            Tag="{x:Bind}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
