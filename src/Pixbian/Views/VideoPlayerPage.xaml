<!--
    视频播放器页（M4）：舞台 + 可自动隐藏的顶/底浮层控制条。
    播放区使用 MediaPlayerElement 铺满整个页面，传输控制由本页自绘，
    避免系统 MediaTransportControls 在 WinUI 3 非打包模式下的样式兼容问题。
    顶栏（返回 + 文件名）与底栏（播放/进度/音量/倍速/全屏）不再占据布局行，而是覆盖在画面之上：
    静置数秒后自动隐藏、指针移入舞台或单击画面即重新唤出，隐藏时画面真正撑满内容区。
    页面根为 Page（FrameworkElement），可用 x:Bind；但 MediaPlayer 需由代码创建并注入。
-->
<Page
    x:Class="Pixbian.Views.VideoPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Pixbian.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" IsInverted="True" />
    </Page.Resources>

    <!--
        舞台：单层网格，画面铺满整个窗口。层级自下而上为：画面 → 错误提示 → 顶栏 / 底栏。
        【性能关键】画面之上不得叠加任何铺满的透明层：覆盖在视频上的层会打断硬件覆盖
        （zero-copy）呈现路径，迫使每帧经合成器混合——2K/4K 下每帧几十 MB 的拷贝会把
        CPU 顶到 60% 以上（实测：同一文件用系统播放器播放明显更低）。
        因此「单击画面切换控制条」与「指针移动唤出」都由本层经事件冒泡接收：
        指针命中画面后冒泡到舞台根，MediaPlayerElement 自身不处理指针（未启用传输控件）。
        顶栏与底栏是必要的半透明覆盖层，但它们只占上下两条、且隐藏后不参与合成。
    -->
    <Grid
        x:Name="StageRoot"
        Background="Black"
        PointerMoved="OnStagePointerMoved"
        Tapped="OnStageTapped">

        <MediaPlayerElement
            x:Name="PlayerElement"
            AreTransportControlsEnabled="False"
            AutoPlay="False" />

        <!-- 错误提示 -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="40"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE783;" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>

        <!--
            顶栏：返回与文件名。播放态下本页铺满整个窗口，顶栏正好落在系统标题栏那 48px 内，
            与最小化/最大化/关闭按钮同排。
            背景由外层 Border 铺满整宽（含系统按钮区），内层 CommandBar 右留 140px 避让系统按钮——
            避让若写在 Border 上会连背景一起缩短，右侧 140px 将露出画面。
            顶栏整体位于非客户区，收不到指针事件（只有经 Passthrough 放行的返回按钮能收到点击），
            故此处不挂 PointerEntered/Exited——悬停保持由底栏与画面区域负责。
        -->
        <Border
            VerticalAlignment="Top"
            Background="{ThemeResource PixbianItemOverlayBrush}"
            Visibility="{x:Bind IsChromeVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <CommandBar
                x:Name="TopBar"
                Margin="0,0,140,0"
                Background="Transparent"
                DefaultLabelPosition="Right">
                <AppBarButton
                    x:Name="BackButton"
                    Click="OnCloseClick"
                    Icon="Back"
                    Label="返回" />
                <CommandBar.Content>
                    <TextBlock
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.CurrentItem.FileName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </CommandBar.Content>
            </CommandBar>
        </Border>

        <!-- 底栏：播放控制、进度、音量、倍速与全屏，覆盖在画面底部 -->
        <Grid
            x:Name="BottomBar"
            Padding="12"
            VerticalAlignment="Bottom"
            Background="{ThemeResource PixbianItemOverlayBrush}"
            PointerEntered="OnChromePointerEntered"
            PointerExited="OnChromePointerExited"
            Visibility="{x:Bind IsChromeVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 播放/暂停 -->
                <Button
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Click="OnTogglePlayPauseClick"
                    Style="{StaticResource AccentButtonStyle}">
                    <FontIcon Glyph="{x:Bind PlayPauseGlyph, Mode=OneWay}" />
                </Button>

                <!-- 进度条 -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Slider
                        x:Name="ProgressSlider"
                        Grid.Row="0"
                        IsEnabled="{x:Bind HasDuration, Mode=OneWay}"
                        Maximum="{x:Bind DurationSeconds, Mode=OneWay}"
                        ValueChanged="OnProgressValueChanged"
                        Value="{x:Bind PositionSeconds, Mode=OneWay}" />

                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                </Grid>

                <!-- 音量 -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button Click="OnToggleMuteClick">
                        <FontIcon Glyph="{x:Bind VolumeGlyph, Mode=OneWay}" />
                    </Button>
                    <Slider
                        Width="100"
                        VerticalAlignment="Center"
                        Maximum="1"
                        StepFrequency="0.05"
                        ValueChanged="OnVolumeChanged"
                        Value="{x:Bind ViewModel.Volume, Mode=OneWay}" />
                </StackPanel>

                <!-- 倍速：下拉展开期间不得自动隐藏控制条 -->
                <ComboBox
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    DropDownClosed="OnRateDropDownClosed"
                    DropDownOpened="OnRateDropDownOpened"
                    SelectedIndex="{x:Bind RateIndex, Mode=TwoWay}"
                    SelectionChanged="OnRateChanged">
                    <ComboBoxItem Content="0.25×" />
                    <ComboBoxItem Content="0.5×" />
                    <ComboBoxItem Content="1.0×" />
                    <ComboBoxItem Content="1.5×" />
                    <ComboBoxItem Content="2.0×" />
                </ComboBox>

                <!-- 全屏 -->
                <Button
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Click="OnFullScreenClick">
                    <FontIcon Glyph="&#xE740;" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
