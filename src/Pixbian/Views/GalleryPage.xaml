<!--
    图库页（M2）：页头（图标 + 名称 + 工具栏）/ 统计行 / 内容区三行布局。
    页头行左侧为导航目标图标与名称，右侧为普通工具栏；选择模式由独立的 SelectionHeaderGrid 整行
    替换页头：左为选择计数标题与页名副标题，右为取消 / 删除 / 收藏 / 播放 / 更多按钮组。
    工具栏为紧凑图标按钮组：仅「选择」带文本，其余为纯图标（靠 ToolTip 说明），带下拉菜单的按钮
    在图标后附一个小角标；排序菜单为「依据（随机 / 日期 / 大小 / 名字）+ 方向（升序 / 降序）」两组，
    随机时方向两项置灰。
    全选 / 取消选择提供 Ctrl+A、Ctrl+D、Esc 快捷键，与 Ctrl+C / Delete / F2 等一并走代码后置 KeyDown。
    工具栏溢出按规范 §2.3 用 AdaptiveTrigger + VisualState 声明（≥1008 宽松 / 640~1007 中等 / <640 紧凑），
    纯图标按钮一律带 AutomationProperties.Name（规范 §10【必须】）。
    统计行反映当前筛选结果的全量规模（非已加载页数），与列表共用 ViewModel 的查询条件。
    内容区左右边距统一为 48px；条目为纯平铺，不按日期分组；两种视图各用一个非分组 GridView，
    自适应视图的 ItemsPanel 为 JustifiedPanel，方形视图用内建 ItemsWrapGrid。
    注：WinUI 3 的 XamlCompiler 不支持 DataTemplate 内 RelativeSource AncestorType 绑定（会静默崩溃），
    故选择遮罩与复选框改由 ItemContainerStyle 的 ControlTemplate 承载：模板内 x:Bind 根为模板化控件
    （IsSelected 即容器选中，与 GridView 选择机制同步），页面属性须经 PageProxy 的传统 Binding 访问；
    遮罩 hover 态与复选框的 hover 浮现（普通模式 hover 显示复选框、点勾即进入选择模式）
    均由 ControlTemplate 的 VisualStateManager 驱动。
    条目右下角常显收藏按钮（空心白 / 实心红爱心，随 IsFavorite 切换），单击按钮与双击图片
    均切换收藏并播放图标弹跳动画；单击打开查看器延迟 300ms 判定，双击取消挂起打开。
-->
<Page
    x:Class="Pixbian.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixbian.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Pixbian.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pixbian.ViewModels"
    xmlns:converters="using:Pixbian.Converters"
    mc:Ignorable="d">

    <!-- 快捷键一律走代码后置的 KeyDown（见 OnGalleryPageKeyDown），不用 Page.KeyboardAccelerators：
         注册 accelerator 后，框架会按官方设计把按键组合追加到作用域内「所有控件」的 ToolTip 上
         （MenuFlyoutItem 除外），导致 hover 图片时文件名提示混入「Ctrl+A」。
         菜单项上的 KeyboardAcceleratorTextOverride 只负责显示提示文本，不受影响。 -->

    <Page.Resources>
        <!-- 工具栏按钮的悬停/按下底色：默认的 ButtonBackgroundPointerOver 铺在纯白内容区上
             几乎不可见，换成 Fluent 分层填充色（约 6% / 9% 覆盖）才有明确指向反馈。
             页面内使用 Button 的是工具栏与条目收藏按钮，覆盖在此对两者同时生效。 -->
        <StaticResource x:Key="ButtonBackgroundPointerOver"
                        ResourceKey="SubtleFillColorSecondaryBrush"/>
        <StaticResource x:Key="ButtonBackgroundPressed"
                        ResourceKey="SubtleFillColorTertiaryBrush"/>

        <!-- 模板内无法用 x:Bind 触达页面，经代理对象把页面实例作为绑定源暴露给容器模板。 -->
        <local:BindingProxy x:Key="PageProxy"
                            Data="{x:Bind}"/>

        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BoolToVisibilityConverter
            x:Key="InverseBoolToVisibility"
            IsInverted="True"/>

        <!-- 条目复选框常驻视觉树的显隐切换：普通模式 Opacity=0 且不参与命中测试，
             选择模式与 hover（VisualState Setter 覆盖）时显示并可点击。
             不用 Collapsed/Visible：批量显隐会触发所有可见条目全量重布局，造成进入选择模式卡顿。 -->
        <converters:BoolToValueConverter x:Key="BoolToSelectionOpacity"
                                         TrueValue="1"
                                         FalseValue="0"/>
        <converters:BoolToValueConverter x:Key="BoolToSelectionHitTest"
                                         TrueValue="True"
                                         FalseValue="False"/>

        <Style x:Key="ToolBarButtonStyle"
               TargetType="ButtonBase">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <!-- 取 ControlCornerRadius（4）：按钮属「内嵌控件」档，按界面设计规范 §5 只有 4 / 8 两档，
                 表面层级才用 8，不发明第三档。默认模板本就取 4，此处显式声明只为悬停底色的圆角可见。 -->
            <Setter Property="CornerRadius"
                    Value="4"/>
            <Setter Property="Height"
                    Value="32"/>
            <!-- 8：规范 §2.1【必须】所有边距/间距取 4 的倍数。 -->
            <Setter Property="Padding"
                    Value="8,0"/>
            <Setter Property="HorizontalAlignment"
                    Value="Left"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <!-- 条目右下角收藏按钮：纯图标透明底、右下贴角，图标字形与画刷由条目的
             FavoriteGlyph / FavoriteBrush 提供（未收藏空心 80% 白，已收藏实心 80% 红）。
             DoubleTapped 在按钮上就地标记已处理：按钮 Click 已完成切换，
             不能让双击冒泡到列表的双击处理再切一次。 -->
        <Style x:Key="ItemFavoriteButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="CornerRadius"
                    Value="4"/>
            <Setter Property="MinWidth"
                    Value="0"/>
            <Setter Property="MinHeight"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="4"/>
            <Setter Property="HorizontalAlignment"
                    Value="Right"/>
            <Setter Property="VerticalAlignment"
                    Value="Bottom"/>
            <Setter Property="Margin"
                    Value="0,0,4,4"/>
        </Style>

        <Style x:Key="DropDownChevronStyle"
               TargetType="FontIcon">
            <Setter Property="FontFamily"
                    Value="{ThemeResource SymbolThemeFontFamily}"/>
            <!-- 12：与 WinUI 官方一致（ExpanderChevronGlyphSize / DropDownButton 内 chevron 实测均 12）。 -->
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="Glyph"
                    Value="&#xE70D;"/>
            <Setter Property="Margin"
                    Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <!-- 网格视图条目模板 -->
        <DataTemplate x:Key="MediaItemTemplate"
                      x:DataType="models:MediaItemViewModel">
            <Border
                CornerRadius="4"
                ToolTipService.ToolTip="{x:Bind FileName}">
                <Grid>
                    <!-- 骨架屏 / 缩略图 / 错误占位三态由控件按 ThumbnailState 切换。
                         绑定都必须 OneWay：x:Bind 默认 OneTime 会停在首帧的 null。
                         AspectRatio 供控件把骨架裁成与图片相同的形状，避免淡入时形状跳变。
                         Stretch=None：方形格子不缩放图片，按图片当前尺寸显示并宽高双向居中，
                         长边超出格子的部分被裁剪（自适应视图仍用默认 Uniform）。
                         SkeletonFillsContainer：骨架填满整个 1:1 格子，与方形网格观感一致；
                         若按图片宽高比贴合，非正方形图片的骨架会缩成一条。 -->
                    <controls:ThumbnailPresenter
                        AspectRatio="{x:Bind AspectRatio, Mode=OneWay}"
                        Source="{x:Bind Thumbnail, Mode=OneWay}"
                        State="{x:Bind ThumbnailState, Mode=OneWay}"
                        Stretch="None"
                        SkeletonFillsContainer="True"/>

                    <Border
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="4"
                        Padding="4,2"
                        Background="{ThemeResource PixbianItemOverlayBrush}"
                        CornerRadius="4"
                        Visibility="{x:Bind IsVideo, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Foreground="{ThemeResource PixbianItemOverlayForegroundBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind DurationText}"/>
                    </Border>

                    <!-- 右下角收藏按钮：单击即切换收藏；双击按钮由 DoubleTapped 就地吃掉。
                         收藏切换时由代码后置对本按钮播放弹跳动画，故动画目标取整个按钮。 -->
                    <Button
                        x:Name="FavoriteButton"
                        AutomationProperties.Name="收藏"
                        Click="OnFavoriteButtonClick"
                        DoubleTapped="OnFavoriteButtonDoubleTapped"
                        Style="{StaticResource ItemFavoriteButtonStyle}"
                        ToolTipService.ToolTip="收藏">
                        <FontIcon
                            FontSize="16"
                            Foreground="{x:Bind FavoriteBrush, Mode=OneWay}"
                            Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 自适应视图条目模板（每组内嵌的非分组 GridView 使用） -->
        <DataTemplate x:Key="JustifiedItemTemplate"
                      x:DataType="models:MediaItemViewModel">
            <!-- 不带 Margin：间距由 JustifiedPanel 的 Spacing 承担，
                 否则内容区比分配尺寸少 8px，宽高比与位图失配，缩略图边缘会露出背景色。 -->
            <Border
                CornerRadius="4"
                ToolTipService.ToolTip="{x:Bind FileName}">
                <Grid>
                    <!-- 骨架屏 / 缩略图 / 错误占位三态由控件按 ThumbnailState 切换。
                         绑定都必须 OneWay：x:Bind 默认 OneTime 会停在首帧的 null。
                         AspectRatio 供控件把骨架裁成与图片相同的形状，避免淡入时形状跳变。 -->
                    <controls:ThumbnailPresenter
                        AspectRatio="{x:Bind AspectRatio, Mode=OneWay}"
                        Source="{x:Bind Thumbnail, Mode=OneWay}"
                        State="{x:Bind ThumbnailState, Mode=OneWay}"/>

                    <Border
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="4"
                        Padding="4,2"
                        Background="{ThemeResource PixbianItemOverlayBrush}"
                        CornerRadius="4"
                        Visibility="{x:Bind IsVideo, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Foreground="{ThemeResource PixbianItemOverlayForegroundBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind DurationText}"/>
                    </Border>

                    <!-- 右下角收藏按钮：单击即切换收藏；双击按钮由 DoubleTapped 就地吃掉。
                         收藏切换时由代码后置对本按钮播放弹跳动画，故动画目标取整个按钮。 -->
                    <Button
                        x:Name="FavoriteButton"
                        AutomationProperties.Name="收藏"
                        Click="OnFavoriteButtonClick"
                        DoubleTapped="OnFavoriteButtonDoubleTapped"
                        Style="{StaticResource ItemFavoriteButtonStyle}"
                        ToolTipService.ToolTip="收藏">
                        <FontIcon
                            FontSize="16"
                            Foreground="{x:Bind FavoriteBrush, Mode=OneWay}"
                            Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 页头行 / 统计行 / 内容区 -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 普通页头行：图标 + 名称在左，普通工具栏在右，统计行在下方副行；选择模式下整行让位给
             SelectionHeaderGrid。两个页头 Grid 的外框取值**完全相同**（Margin=16 + Padding="32,16"）：
             左右为 16+32，内容左缘对齐到内容区的 48；上下各为 16+16。行结构亦同为「主行 + 副行」两行
             Auto，故切换选择模式时 Row0 行盒高度不变、内容区零位移。 -->
        <Grid
            x:Name="HeaderGrid"
            Grid.Row="0"
            Margin="16,16,16,0"
            Padding="32,16"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            Visibility="{x:Bind IsSelectionMode, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                MinHeight="32"
                Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">
                <FontIcon
                    Style="{StaticResource PageHeaderIconStyle}"
                    Glyph="{x:Bind ViewModel.PageIconGlyph, Mode=OneWay}"/>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"/>
            </StackPanel>

            <!-- 工具栏宿主：占满剩余宽度。
                 宽度不足时按窗口断点把右侧按钮收进「更多」菜单，用 AdaptiveTrigger + VisualState
                 声明（规范 §2.3【必须】），不在 C# 里监听 SizeChanged 改布局参数。
                 断点取规范档位：≥1008 宽松全显；640~1007 中等收起选择/幻灯片；<640 紧凑再收起排序。 -->
            <Grid
                x:Name="ToolBarHost"
                Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Stretch">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="ToolBarOverflowStates">
                        <VisualState x:Name="WideToolBar">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1008"/>
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="MediumToolBar">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="640"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SelectButton.Visibility"
                                        Value="Collapsed"/>
                                <Setter Target="SlideShowButton.Visibility"
                                        Value="Collapsed"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="NarrowToolBar">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SelectButton.Visibility"
                                        Value="Collapsed"/>
                                <Setter Target="SlideShowButton.Visibility"
                                        Value="Collapsed"/>
                                <Setter Target="SortButton.Visibility"
                                        Value="Collapsed"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <!-- 普通模式工具栏 -->
                <!-- 三个下拉按钮的菜单项在每次 Opening 时按当前状态重建，故勾选态与可用态永远是最新的，
             不必再维护 x:Name 引用去反向同步；「更多」菜单按各按钮当前 Visibility 补齐被收起的命令。 -->
                <StackPanel
                    x:Name="NormalToolBar"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="SelectButton"
                        AutomationProperties.Name="选择"
                        Click="OnSelectClick"
                        Style="{StaticResource ToolBarButtonStyle}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <FontIcon FontSize="16"
                                      Glyph="&#xE73A;"/>
                            <TextBlock Text="选择"/>
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="SlideShowButton"
                        AutomationProperties.Name="幻灯片放映"
                        Click="OnSlideShowClick"
                        IsEnabled="{x:Bind HasItems, Mode=OneWay}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTipService.ToolTip="开始幻灯片放映（F5）">
                        <FontIcon FontSize="16"
                                  Glyph="&#xE786;"/>
                    </Button>

                    <Button
                        x:Name="SortButton"
                        AutomationProperties.Name="排序"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTipService.ToolTip="排序">
                        <Button.Flyout>
                            <MenuFlyout Opening="OnSortMenuOpening"/>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4">
                            <FontIcon FontSize="16"
                                      Glyph="&#xE174;"/>
                            <FontIcon Style="{StaticResource DropDownChevronStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="FilterButton"
                        AutomationProperties.Name="筛选"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTipService.ToolTip="筛选">
                        <Button.Flyout>
                            <MenuFlyout Opening="OnKindMenuOpening"/>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4">
                            <FontIcon FontSize="16"
                                      Glyph="&#xE71C;"/>
                            <FontIcon Style="{StaticResource DropDownChevronStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="ViewModeButton"
                        AutomationProperties.Name="显示和大小"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTipService.ToolTip="显示和大小">
                        <Button.Flyout>
                            <MenuFlyout Opening="OnViewMenuOpening"/>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4">
                            <FontIcon FontSize="16"
                                      Glyph="&#xECA5;"/>
                            <FontIcon Style="{StaticResource DropDownChevronStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="MoreButton"
                        AutomationProperties.Name="更多"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTipService.ToolTip="更多">
                        <Button.Flyout>
                            <MenuFlyout Opening="OnMoreMenuOpening"/>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4">
                            <FontIcon FontSize="16"
                                      Glyph="&#xE712;"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>

            <!-- 统计行（副行）：反映当前筛选结果（类型 / 收藏 / 搜索）的全量规模，而非已加载页数。
                 某一类为 0 时整项不显示，避免出现「0 个视频」这类无信息量的零值。
                 选择模式下随 HeaderGrid 整行隐藏（选择页头不展示统计）。
                 顶距 4 与选择页头副行一致（Grid 无行距属性，行距由副行 Margin 承担）。 -->
            <TextBlock
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,4,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.StatisticsText, Mode=OneWay}"/>
        </Grid>

        <!-- 选择模式工具栏：独占页头行，与普通页头整行 Visibility 互斥。
             卡片式外观与内容区卡片同一对画刷（80% 白底 + 淡描边，圆角取表面档 8）；
             BorderThickness 为内侧绘制、不占布局空间，与页头高度对称无关。
             外框取值与 HeaderGrid 完全相同（Margin=16 + Padding="32,16"）：上下各 16+16，
             左右 16 的外缩（Margin）形成浮层感，配合内部 32 的 Padding 使卡片内容左缘对齐到 48
             （与内容区 ScrollViewer 左右 Padding 一致）。
             切换选择模式时 Row0 行盒高度不变、内容区零位移、零抖动。
             左侧为选择计数标题（「选择项目」/「已选择 N 个项目」）与页名副标题；
             右侧为操作按钮组：删除把选中项移入回收站并经底部通知条展示进度与结果；
             窄窗口时「播放」按断点收进「更多」（含全选 / 取消选择）。 -->
        <Grid
            x:Name="SelectionHeaderGrid"
            Grid.Row="0"
            Margin="16,16,16,0"
            Padding="32,16"
            Background="{StaticResource PixbianContentCardBackground}"
            BorderBrush="{StaticResource PixbianContentCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{x:Bind IsSelectionMode, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                MinHeight="32"
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind SelectionCountText, Mode=OneWay}"/>

            <StackPanel
                x:Name="SelectionToolBar"
                Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="SelectionToolBarOverflowStates">
                        <VisualState x:Name="WideSelectionToolBar">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="640"/>
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="NarrowSelectionToolBar">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SelectionPlayButton.Visibility"
                                        Value="Collapsed"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Button
                    AutomationProperties.Name="取消选择"
                    Click="OnCancelSelectionClick"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTipService.ToolTip="取消选择">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon FontSize="16"
                                  Glyph="&#xE711;"/>
                        <TextBlock Text="取消"/>
                    </StackPanel>
                </Button>

                <Button
                    AutomationProperties.Name="删除"
                    Click="OnDeleteSelectionClick"
                    IsEnabled="{x:Bind HasSelection, Mode=OneWay}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTipService.ToolTip="删除">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon FontSize="16"
                                  Glyph="&#xE74D;"/>
                        <TextBlock Text="删除"/>
                    </StackPanel>
                </Button>

                <Button
                    AutomationProperties.Name="收藏"
                    Click="OnAddFavoriteClick"
                    IsEnabled="{x:Bind HasSelection, Mode=OneWay}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTipService.ToolTip="收藏">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon FontSize="16"
                                  Glyph="&#xE734;"/>
                        <TextBlock Text="收藏"/>
                    </StackPanel>
                </Button>

                <Button
                    x:Name="SelectionPlayButton"
                    AutomationProperties.Name="播放"
                    Click="OnSlideShowClick"
                    IsEnabled="{x:Bind HasSelection, Mode=OneWay}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTipService.ToolTip="播放选中项">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon FontSize="16"
                                  Glyph="&#xE93E;"/>
                        <TextBlock Text="播放"/>
                    </StackPanel>
                </Button>

                <Button
                    x:Name="SelectionMoreButton"
                    AutomationProperties.Name="更多"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTipService.ToolTip="更多">
                    <Button.Flyout>
                        <MenuFlyout Opening="OnSelectionMoreMenuOpening"/>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon FontSize="16"
                                  Glyph="&#xE712;"/>
                        <TextBlock Text="更多"/>
                        <FontIcon Style="{StaticResource DropDownChevronStyle}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 页名副标题（副行）：与普通页头的统计行同位同高（Margin 顶距一致），保证切换选择模式零抖动。 -->
            <TextBlock
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,4,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"/>
        </Grid>

        <!-- 自适应行式视图 -->
        <ScrollViewer
            x:Name="JustifiedView"
            Grid.Row="2"
            Tapped="OnItemTapped"
            Padding="48,0,48,16"
            Visibility="{x:Bind IsJustifiedView, Mode=OneWay}"
            ViewChanged="OnScrollViewChanged">
            <GridView
                x:Name="JustifiedGridView"
                ContainerContentChanging="OnContainerContentChanging"
                Tapped="OnItemTapped"
                DoubleTapped="OnItemDoubleTapped"
                IsItemClickEnabled="True"
                ItemClick="OnItemClick"
                ItemTemplate="{StaticResource JustifiedItemTemplate}"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                Loaded="OnJustifiedGridLoaded"
                RightTapped="OnItemRightTapped"
                SelectionChanged="OnSelectionChanged"
                SelectionMode="Extended"
                Unloaded="OnJustifiedGridUnloaded">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin"
                                Value="0"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewItem">
                                    <Grid>
                                        <ContentPresenter/>
                                        <Border
                                            x:Name="MaskBorder"
                                            Background="{ThemeResource PixbianItemHover}"
                                            CornerRadius="4"
                                            Opacity="0"/>
                                        <!-- 选中外框：绑容器 IsSelected（ControlTemplate 内 TemplatedParent 传统 Binding，
                                             运行时解析转换器、属性通知即时；模板内 x:Bind + Converter 会启动崩溃）。 -->
                                        <Border
                                            x:Name="SelectionRing"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="2"
                                            CornerRadius="4"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
                                        <!-- 复选框：两档白衬底画在勾选方框**内部**（覆盖方框填充主题键，未选中默认透明），
                                             右上角悬浮；普通模式 hover 浮现（VisualState 驱动），选择模式经绑定常显；
                                             框上 hover 时衬底由 60% 白加深为 80% 白（见 CheckBox.Resources）。 -->
                                        <CheckBox
                                            x:Name="SelectionCheck"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,4,4,0"
                                            MinWidth="0"
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                            Opacity="{Binding Data.IsSelectionMode, Source={StaticResource PageProxy}, Converter={StaticResource BoolToSelectionOpacity}, Mode=OneWay}"
                                            IsHitTestVisible="{Binding Data.IsSelectionMode, Source={StaticResource PageProxy}, Converter={StaticResource BoolToSelectionHitTest}, Mode=OneWay}">
                                            <CheckBox.Resources>
                                                <!-- 两档衬底：hover 图片浮现框时 60% 白常态；鼠标移到框上
                                                     （PointerOver/Pressed）加深到 80% 白提示可交互。 -->
                                                <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked"
                                                                ResourceKey="PixbianItemCheckBackdropSubtle"/>
                                                <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver"
                                                                ResourceKey="PixbianItemCheckBackdrop"/>
                                                <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPressed"
                                                                ResourceKey="PixbianItemCheckBackdrop"/>
                                            </CheckBox.Resources>
                                        </CheckBox>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="MaskBorder.Opacity"
                                                                Value="0.05"/>
                                                        <!-- State Setter 优先于本地绑定值：普通模式下复选框默认
                                                             透明且不参与命中测试，hover 时浮现并可点击；
                                                             选择模式下绑定值本就是显示与可点，Setter 同值无副作用。 -->
                                                        <Setter Target="SelectionCheck.Opacity"
                                                                Value="1"/>
                                                        <Setter Target="SelectionCheck.IsHitTestVisible"
                                                                Value="True"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="MaskBorder.Opacity"
                                                                Value="0.08"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Spacing 承担全部间距：条目模板不再带 Margin，内容区宽高比才与位图一致。 -->
                        <controls:JustifiedPanel Spacing="12"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>
        </ScrollViewer>

        <!-- 方形网格视图 -->
        <ScrollViewer
            x:Name="GridViewView"
            Grid.Row="2"
            Padding="48,0,48,16"
            Visibility="{x:Bind IsGridView, Mode=OneWay}"
            ViewChanged="OnScrollViewChanged">
            <GridView
                x:Name="GridViewControl"
                ContainerContentChanging="OnContainerContentChanging"
                DoubleTapped="OnItemDoubleTapped"
                IsItemClickEnabled="True"
                ItemClick="OnItemClick"
                RightTapped="OnItemRightTapped"
                Tapped="OnItemTapped"
                ItemTemplate="{StaticResource MediaItemTemplate}"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                SelectionChanged="OnSelectionChanged"
                SelectionMode="Extended">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin"
                                Value="0"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewItem">
                                    <Grid>
                                        <ContentPresenter/>
                                        <Border
                                            x:Name="MaskBorder"
                                            Background="Black"
                                            CornerRadius="4"
                                            Opacity="0"/>
                                        <!-- 选中外框：绑容器 IsSelected（ControlTemplate 内 TemplatedParent 传统 Binding，
                                             运行时解析转换器、属性通知即时；模板内 x:Bind + Converter 会启动崩溃）。 -->
                                        <Border
                                            x:Name="SelectionRing"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="2"
                                            CornerRadius="4"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
                                        <!-- 复选框：两档白衬底画在勾选方框**内部**（覆盖方框填充主题键，未选中默认透明），
                                             右上角悬浮；普通模式 hover 浮现（VisualState 驱动），选择模式经绑定常显；
                                             框上 hover 时衬底由 60% 白加深为 80% 白（见 CheckBox.Resources）。 -->
                                        <CheckBox
                                            x:Name="SelectionCheck"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,4,4,0"
                                            MinWidth="0"
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                            Opacity="{Binding Data.IsSelectionMode, Source={StaticResource PageProxy}, Converter={StaticResource BoolToSelectionOpacity}, Mode=OneWay}"
                                            IsHitTestVisible="{Binding Data.IsSelectionMode, Source={StaticResource PageProxy}, Converter={StaticResource BoolToSelectionHitTest}, Mode=OneWay}">
                                            <CheckBox.Resources>
                                                <!-- 两档衬底：hover 图片浮现框时 60% 白常态；鼠标移到框上
                                                     （PointerOver/Pressed）加深到 80% 白提示可交互。 -->
                                                <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked"
                                                                ResourceKey="PixbianItemCheckBackdropSubtle"/>
                                                <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver"
                                                                ResourceKey="PixbianItemCheckBackdrop"/>
                                                <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPressed"
                                                                ResourceKey="PixbianItemCheckBackdrop"/>
                                            </CheckBox.Resources>
                                        </CheckBox>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="MaskBorder.Opacity"
                                                                Value="0.05"/>
                                                        <!-- State Setter 优先于本地绑定值：普通模式下复选框默认
                                                             透明且不参与命中测试，hover 时浮现并可点击；
                                                             选择模式下绑定值本就是显示与可点，Setter 同值无副作用。 -->
                                                        <Setter Target="SelectionCheck.Opacity"
                                                                Value="1"/>
                                                        <Setter Target="SelectionCheck.IsHitTestVisible"
                                                                Value="True"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="MaskBorder.Opacity"
                                                                Value="0.08"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!--
                            方形网格用 SquarePanel：按目标边长（档位 + 间距）推导每行个数，
                            格子均匀放大到恰好填满行宽，条目恒为 1:1；间距由面板 Spacing 承担，
                            条目模板不带 Margin。目标边长经传统 Binding 取页面 DataContext；
                            面板不做虚拟化，条目规模由 ViewModel 分页增量加载控制。
                        -->
                        <controls:SquarePanel
                            ItemSize="{Binding GridItemWidth}"
                            Spacing="8"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>
        </ScrollViewer>

        <!-- 空 / 加载状态：与 MainWindow 的 LoadingOverlay 同构——外层 Grid 占满内容区行
             （Row 2，Height="*"），内层 StackPanel 双向 Center，窗口尺寸变化时自动居中。
             【关键前提】PageHost（MainWindow 的 ContentControl）必须显式
             VerticalAlignment/VerticalContentAlignment=Stretch——其默认值为 Top，
             会让整个 Page 按内容高度收缩（空目录时整页只有 ~190px，`*` 行塌缩，
             任何居中设置都无效——即此前「空状态贴顶不居中」的根因）。
             Foreground 必须是画刷（曾误填 Style 名 TitleTextBlockStyle 导致类型错误）；
             Style 只能用已定义的文本样式——TitleTextBlockFontSize / BodyTextBlockFontSize
             并非本项目资源，StaticResource 解析失败会让应用启动即崩。 -->
        <Grid Grid.Row="2"
              Visibility="{x:Bind ShowEmptyState, Mode=OneWay}">
            <!-- 三态由页面 ShowEmptyState / EmptyStateTitle 驱动（见 GalleryPage.xaml.cs）：
                 查询中 → 整区隐藏，由窗口层 LoadingOverlay 接管；真空目录 → 标题 + 副文案；
                 加载失败 → 标题切为「加载失败，请重试」，副文案隐藏。
                 本 Grid 声明在两个视图 ScrollViewer 之后（z 序更高）且背景透明，
                 缺可见性绑定会让空状态文字永久浮在列表上（已发生过的缺陷）。
                 对齐 Windows 照片应用的空状态观感：文字块位于内容区正中偏上；
                 对称 Margin 的下边距 128 使视觉中心从几何中心上移 64px，
                 窗口尺寸变化时偏移量恒定，仍属自动居中而非数值定位。 -->
            <StackPanel
                Margin="0,0,0,128"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical"
                Spacing="8">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind EmptyStateTitle, Mode=OneWay}"/>
                <TextBlock
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyMediumTextBlockStyle}"
                    Text="请选择一个文件夹，或调整「筛选器」以显示更多内容。"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ShowEmptySubtitle, Mode=OneWay}"/>
            </StackPanel>
        </Grid>

        <!-- 加载覆盖层已上移到窗口层（MainWindow.xaml 的 LoadingOverlay，PageHost 兄弟位）：
             页面内同格覆盖层会与 GridView 大重排在同一布局容器内交替失效，是历史 LayoutCycle
             的结构成因；窗口层与其彻底解耦，且撤层时机同为 IsQuerying（首屏就绪）。 -->

        <!-- 删除通知条：悬浮于内容区底部。进行中为「图标 + 文本 + 进度条 + 取消」，
             结束后切换为结果提示（5 秒自动消失，亦可手动关闭），整体可见性由 VM 聚合属性驱动。 -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,24"
            Padding="16,12"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{x:Bind ViewModel.IsDeleteNotificationVisible, Mode=OneWay}">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="16"
                    Glyph="&#xE74D;"/>

                <!-- 进度块 -->
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Vertical"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsDeleteInProgress, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.DeleteProgressText, Mode=OneWay}"/>
                    <ProgressBar
                        Width="280"
                        Maximum="{x:Bind ViewModel.DeleteProgressMaximum, Mode=OneWay}"
                        Value="{x:Bind ViewModel.DeleteProgressValue, Mode=OneWay}"/>
                </StackPanel>

                <!-- 结果块 -->
                <TextBlock
                    VerticalAlignment="Center"
                    MaxWidth="480"
                    TextWrapping="Wrap"
                    Text="{x:Bind ViewModel.DeleteResultText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsDeleteResultVisible, Mode=OneWay}"/>

                <Button
                    Click="OnCancelDeleteClick"
                    Content="取消"
                    Visibility="{x:Bind ViewModel.IsDeleteInProgress, Mode=OneWay}"/>
                <Button
                    AutomationProperties.Name="关闭"
                    Click="OnCloseDeleteResultClick"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTipService.ToolTip="关闭"
                    Visibility="{x:Bind ViewModel.IsDeleteResultVisible, Mode=OneWay}">
                    <FontIcon FontSize="16"
                              Glyph="&#xE711;"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
