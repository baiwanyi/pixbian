<!--
    图库页（M2）：页头（图标 + 名称 + 工具栏）/ 统计行 / 内容区三行布局。
    页头行左侧为导航目标图标与名称，右侧为普通工具栏；选择模式由独立的 SelectionHeaderGrid 整行
    替换页头：左为选择计数标题与页名副标题，右为取消 / 删除 / 收藏 / 播放 / 更多按钮组。
    工具栏为紧凑图标按钮组：仅「选择」带文本，其余为纯图标（靠 ToolTip 说明），带下拉菜单的按钮
    在图标后附一个小角标；排序菜单为「依据（随机 / 日期 / 大小 / 名字）+ 方向（升序 / 降序）」两组，
    随机时方向两项置灰。
    全选 / 取消选择提供 Ctrl+A、Ctrl+D、Esc 快捷键，与 Ctrl+C / Delete / F2 等一并走代码后置 KeyDown。
    工具栏溢出按规范 §2.3 用 AdaptiveTrigger + VisualState 声明（≥1008 宽松 / 640~1007 中等 / <640 紧凑），
    纯图标按钮一律带 AutomationProperties.Name（规范 §10【必须】）。
    统计行反映当前筛选结果的全量规模（非已加载页数），与列表共用 ViewModel 的查询条件。
    内容区左右边距统一为 48px；条目为纯平铺，不按日期分组；两种视图各用一个非分组 GridView，
    自适应视图的 ItemsPanel 为 JustifiedPanel（外层 ScrollViewer 滚动，P2 换 ItemsRepeater），
    方形视图用内建 ItemsWrapGrid（原生虚拟化，GridView 自滚，外层不包 ScrollViewer）。
    注：WinUI 3 的 XamlCompiler 不支持 DataTemplate 内 RelativeSource AncestorType 绑定（会静默崩溃），
    故选择遮罩与复选框改由 ItemContainerStyle 的 ControlTemplate 承载：模板内 x:Bind 根为模板化控件
    （IsSelected 即容器选中，与 GridView 选择机制同步），页面属性须经 PageProxy 的传统 Binding 访问；
    遮罩 hover 态与复选框的 hover 浮现（普通模式 hover 显示复选框、点勾即进入选择模式）
    均由 ControlTemplate 的 VisualStateManager 驱动。
    条目右下角常显收藏按钮（空心白 / 实心红爱心，随 IsFavorite 切换），单击按钮与双击图片
    均切换收藏并播放图标弹跳动画；单击打开查看器延迟 300ms 判定，双击取消挂起打开。
-->
<Page
    x:Class="Pixbian.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixbian.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Pixbian.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pixbian.ViewModels"
    xmlns:converters="using:Pixbian.Converters"
    mc:Ignorable="d">

    <!-- 快捷键一律走代码后置的 KeyDown（见 OnGalleryPageKeyDown），不用 Page.KeyboardAccelerators：
         注册 accelerator 后，框架会按官方设计把按键组合追加到作用域内「所有控件」的 ToolTip 上
         （MenuFlyoutItem 除外），导致 hover 图片时文件名提示混入「Ctrl+A」。
         菜单项上的 KeyboardAcceleratorTextOverride 只负责显示提示文本，不受影响。 -->

    <Page.Resources>
        <!-- 工具栏按钮的悬停/按下底色不在此处覆盖：早先用 StaticResource 把
             ButtonBackground* 重定向到 Subtle 令牌，StaticResource 只在启动主题解析一次，
             切到深色后仍钉死浅色画刷，深色下悬停反馈完全消失。现改在 App.xaml 的主题字典内
             按主题各写一份具体色值（深色 10% / 15% 白，浅色 8% / 12% 黑），随主题切换生效。 -->

        <!-- 模板内无法用 x:Bind 触达页面，经代理对象把页面实例作为绑定源暴露给容器模板。 -->
        <local:BindingProxy x:Key="PageProxy"
                            Data="{x:Bind}"/>

        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BoolToVisibilityConverter
            x:Key="InverseBoolToVisibility"
            IsInverted="True"/>

        <!-- 条目复选框常驻视觉树的显隐切换：普通模式 Opacity=0 且不参与命中测试，
             选择模式与 hover（VisualState Setter 覆盖）时显示并可点击。
             不用 Collapsed/Visible：批量显隐会触发所有可见条目全量重布局，造成进入选择模式卡顿。 -->
        <converters:BoolToValueConverter x:Key="BoolToSelectionOpacity"
                                         TrueValue="1"
                                         FalseValue="0"/>
        <converters:BoolToValueConverter x:Key="BoolToSelectionHitTest"
                                         TrueValue="True"
                                         FalseValue="False"/>
        <!-- 等高 Repeater 模板专用：x:Bind 下 BoolToValueConverter 触发 XamlCompiler 内部错误，
             须用同构 object 签名的专用转换器（见 BoolToOpacityConverter 文件头说明）。 -->
        <converters:BoolToOpacityConverter x:Key="BoolToSelectionOpacityXBind"
                                           TrueOpacity="1"
                                           FalseOpacity="0"/>

        <Style x:Key="ToolBarButtonStyle"
               BasedOn="{StaticResource PixbianIconButtonBaseStyle}"
               TargetType="ButtonBase">
            <Setter Property="Height"
                    Value="32"/>
            <!-- 左右 16：图标按钮点击区需 48 宽（16 + 图标 16 + 16），8 的点击区偏窄；
                 上下 0：高度已由 Height=32 固定，再加纵向内距会挤压图标。
                 16 也是规范 §2.1【必须】的 4 的倍数。 -->
            <Setter Property="Padding"
                    Value="16,0"/>
            <Setter Property="HorizontalAlignment"
                    Value="Left"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <!-- 删除按钮：前景取统一的删除色 PixbianDeleteForeground（浅色 #C42B1C / 深色 #FF99A4）。
             红色必须写在 Style Setter——写成元素本地值会压掉模板 VisualState，
             按钮禁用（无选中项）时仍是红而不再回落禁用灰。 -->
        <Style x:Key="ToolBarDeleteButtonStyle"
               BasedOn="{StaticResource ToolBarButtonStyle}"
               TargetType="ButtonBase">
            <Setter Property="Foreground"
                    Value="{ThemeResource PixbianDeleteForeground}"/>
        </Style>

        <!-- 条目右下角收藏按钮：纯图标透明底、右下贴角，图标字形与画刷由条目的
             FavoriteGlyph / FavoriteBrush 提供（未收藏空心 80% 白，已收藏实心 80% 红）。
             DoubleTapped 在按钮上就地标记已处理：按钮 Click 已完成切换，
             不能让双击冒泡到列表的双击处理再切一次。 -->
        <Style x:Key="ItemFavoriteButtonStyle"
               BasedOn="{StaticResource PixbianIconButtonBaseStyle}"
               TargetType="Button">
            <Setter Property="MinWidth"
                    Value="0"/>
            <Setter Property="MinHeight"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="4"/>
            <Setter Property="HorizontalAlignment"
                    Value="Right"/>
            <Setter Property="VerticalAlignment"
                    Value="Bottom"/>
            <Setter Property="Margin"
                    Value="0,0,4,4"/>
        </Style>

        <Style x:Key="DropDownChevronStyle"
               TargetType="FontIcon">
            <Setter Property="FontFamily"
                    Value="{ThemeResource SymbolThemeFontFamily}"/>
            <!-- 12：与 WinUI 官方一致（ExpanderChevronGlyphSize / DropDownButton 内 chevron 实测均 12）。 -->
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="Glyph"
                    Value="&#xE70D;"/>
            <Setter Property="Margin"
                    Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <!-- 网格视图条目模板 -->
        <DataTemplate x:Key="MediaItemTemplate"
                      x:DataType="models:MediaItemViewModel">
            <!-- 条目整体不挂 ToolTip：文件名提示在密集网格里每次 hover 都弹，纯属干扰；
                 文件名只在右键菜单与重命名对话框里呈现。 -->
            <Border
                CornerRadius="4">
                <Grid>
                    <!-- 骨架屏 / 缩略图 / 错误占位三态由控件按 ThumbnailState 切换。
                         绑定都必须 OneWay：x:Bind 默认 OneTime 会停在首帧的 null。
                         AspectRatio 供控件把骨架裁成与图片相同的形状，避免淡入时形状跳变。
                         Stretch=UniformToFill：方形格子把图片等比放大到铺满 1:1 格子，
                         长边溢出部分由画刷的 Center 对齐在两轴上对称裁掉（照片应用方形视图观感）。
                         不可用 None——None 按位图自然像素绘制（统一档位恒为 512），
                         格子随档位变化时只是换了裁剪窗口而非缩放，小档位会把图片放大数倍。
                         SkeletonFillsContainer：骨架填满整个 1:1 格子，与方形网格观感一致；
                         若按图片宽高比贴合，非正方形图片的骨架会缩成一条。 -->
                    <controls:ThumbnailPresenter
                        AspectRatio="{x:Bind AspectRatio, Mode=OneWay}"
                        Source="{x:Bind Thumbnail, Mode=OneWay}"
                        State="{x:Bind ThumbnailState, Mode=OneWay}"
                        Stretch="UniformToFill"
                        SkeletonFillsContainer="True"/>

                    <Border
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="4"
                        Padding="4,2"
                        Background="{ThemeResource PixbianItemOverlayBrush}"
                        CornerRadius="4"
                        Visibility="{x:Bind IsVideo, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Foreground="{ThemeResource PixbianItemOverlayForegroundBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind VideoBadgeText, Mode=OneWay}"/>
                    </Border>

                    <!-- 右下角收藏按钮：单击即切换收藏；双击按钮由 DoubleTapped 就地吃掉。
                         收藏切换时由代码后置对本按钮播放弹跳动画，故动画目标取整个按钮。 -->
                    <Button
                        x:Name="FavoriteButton"
                        AutomationProperties.Name="收藏"
                        Click="OnFavoriteButtonClick"
                        DoubleTapped="OnFavoriteButtonDoubleTapped"
                        Style="{StaticResource ItemFavoriteButtonStyle}"
                        ToolTipService.ToolTip="收藏">
                        <FontIcon
                            FontSize="16"
                            Foreground="{x:Bind FavoriteBrush, Mode=OneWay}"
                            Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 自适应视图条目模板（每组内嵌的非分组 GridView 使用） -->
        <DataTemplate x:Key="JustifiedRepeaterItemTemplate"
                      x:DataType="models:MediaItemViewModel">
            <!--
                等高虚拟化模板（ItemsRepeater 无容器机制，选择视觉从原 ItemContainerStyle 迁入）。
                根 Grid：Background=Transparent 保证整格命中测试；悬停 VSM 由根承载。
                IsSelected 直绑 VM（由 GallerySelectionService 回写），与方形视图的
                容器选择互相独立。DataTemplate 内 x:Bind + StaticResource Converter 安全
                （ControlTemplate 内才禁用）。
            -->
            <Grid
                Background="Transparent"
                CornerRadius="4">
                <!-- 缩略图内容层必须排在遮罩 / 选中框 / 复选框之前：同一 Grid 单元格内
                     后声明的元素覆盖先声明的，顺序颠倒会让三层浮层全被图片盖住
                     （hover 遮罩与复选框因此完全不可见；方形视图容器模板的
                     「ContentPresenter → 遮罩 → 外框 → 复选框」即正确顺序）。 -->
                <Border
                    CornerRadius="4">
                    <Grid>
                        <!-- 骨架屏 / 缩略图 / 错误占位三态由控件按 ThumbnailState 切换。
                             绑定都必须 OneWay：x:Bind 默认 OneTime 会停在首帧的 null。
                             AspectRatio 供控件把骨架裁成与图片相同的形状，避免淡入时形状跳变。 -->
                        <controls:ThumbnailPresenter
                            AspectRatio="{x:Bind AspectRatio, Mode=OneWay}"
                            Source="{x:Bind Thumbnail, Mode=OneWay}"
                            State="{x:Bind ThumbnailState, Mode=OneWay}"/>

                        <Border
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="4"
                            Padding="4,2"
                            Background="{ThemeResource PixbianItemOverlayBrush}"
                            CornerRadius="4"
                            Visibility="{x:Bind IsVideo, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                Foreground="{ThemeResource PixbianItemOverlayForegroundBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind VideoBadgeText, Mode=OneWay}"/>
                        </Border>

                        <!-- 右下角收藏按钮：单击即切换收藏；双击按钮由 DoubleTapped 就地吃掉。
                             收藏切换时由代码后置对本按钮播放弹跳动画，故动画目标取整个按钮。 -->
                        <Button
                            x:Name="FavoriteButton"
                            AutomationProperties.Name="收藏"
                            Click="OnFavoriteButtonClick"
                            DoubleTapped="OnFavoriteButtonDoubleTapped"
                            Style="{StaticResource ItemFavoriteButtonStyle}"
                            ToolTipService.ToolTip="收藏">
                            <FontIcon
                                FontSize="16"
                                Foreground="{x:Bind FavoriteBrush, Mode=OneWay}"
                                Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}"/>
                        </Button>
                    </Grid>
                </Border>

                <Border
                    x:Name="MaskBorder"
                    Background="{ThemeResource PixbianItemHover}"
                    CornerRadius="4"
                    Opacity="0"/>
                <!-- 选中外框：直绑 VM.IsSelected（服务为真源）。 -->
                <Border
                    x:Name="SelectionRing"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="4"
                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                <!-- 复选框：右上角悬浮；普通模式透明不可点、hover 时浮现，选择模式常显可点。
                     显隐一律由 Opacity / IsHitTestVisible 承担，**不得再绑 Visibility**：
                     ① 条目属性（IsSelectionCheckVisible）只反映选择模式，绑 Visibility 会让
                        普通模式恒为 Collapsed，hover 写 Opacity 也永远看不见；
                     ② Repeater 元素在布局 pass 内 realize，运行期改 Visibility 会触发
                        XAML fail-fast（0xc000027b），只能写渲染属性。
                     页面级属性仍不可达（x:Bind 根为条目 VM；PageProxy 传统 Binding 在
                     Repeater 容器中触发 fail-fast），故选择模式由 SyncJustifiedCheckVisibility
                     批量写条目属性、hover 由代码后置写元素本地值。
                     配色（未选中态衬底/描边）不在此处用元素级 Resources 覆盖——那会让
                     {ThemeResource} 在元素 realize（布局 pass 内）时解析并触发 fail-fast；
                     同名键定义在页面根 Grid 的主题字典里，由资源查找链命中。 -->
                <CheckBox
                    x:Name="SelectionCheck"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,4,4,0"
                    MinWidth="0"
                    Click="OnJustifiedCheckClick"
                    IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                    IsHitTestVisible="{x:Bind IsSelectionCheckVisible, Mode=OneWay}"
                    Opacity="0"/>

                <!--
                    悬停视觉不再用 VisualStateManager：状态切换由 Control 的 GoToState 驱动，
                    而本模板根是 Grid（非 Control），PointerOver / Pressed 永不生效。
                    改由根 Grid 的指针进出事件写回条目属性，遮罩与复选框显隐都由 x:Bind 跟随。
                -->
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!-- 列表项复选框（压在图片内容上）的配色：只有本页有复选框，故不下沉到 App.xaml。
             只放 Color 键，画刷由条目的 CheckBox.Resources 现场构造并绑定——直接用 SolidColorBrush
             会被 StaticResource 别名钉死在启动主题，切主题后不刷新。
             必须显式包一层 ResourceDictionary：Grid.Resources 下直接写 ThemeDictionaries
             属性元素会报 WMC9997。 -->
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <!-- 衬底两档：常态 60% 白；鼠标移到框本身（PointerOver/Pressed）加深到 80% 白。
                             描边取系统浅色默认值 #72000000——深灰框配白衬底，对比最清晰。 -->
                        <Color x:Key="PixbianItemCheckBackdropSubtleColor">#99FFFFFF</Color>
                        <Color x:Key="PixbianItemCheckBackdropColor">#CCFFFFFF</Color>
                        <Color x:Key="PixbianItemCheckStrokeColor">#72000000</Color>

                        <!-- 复选框未选中态的衬底与描边（常态 / PointerOver / Pressed 三态）。
                             必须放在**页面级主题字典**由资源查找链命中，绝不能放回条目模板里
                             元素级 CheckBox.Resources：等高视图（ItemsRepeater）的元素在布局
                             pass 内 realize，元素级 Resources 里的 {ThemeResource} 在此时解析会
                             触发 XAML fail-fast（0xc000027b，无托管堆栈，实测启动即崩）。 -->
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked"
                                         Color="#99FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver"
                                         Color="#CCFFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed"
                                         Color="#CCFFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked"
                                         Color="#72000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver"
                                         Color="#72000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed"
                                         Color="#72000000"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <!-- 深色改暗底：衬底常态 30% 黑，hover 到框本身加深到 50% 黑
                             （浅色是白衬底，深色用黑衬底才不刺眼）；描边恒 60% 白——底变暗后
                             由白描边勾出方框轮廓，且比系统默认的 #8BFFFFFF 更明确。 -->
                        <Color x:Key="PixbianItemCheckBackdropSubtleColor">#4D000000</Color>
                        <Color x:Key="PixbianItemCheckBackdropColor">#80000000</Color>
                        <Color x:Key="PixbianItemCheckStrokeColor">#99FFFFFF</Color>

                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked"
                                         Color="#4D000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver"
                                         Color="#80000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed"
                                         Color="#80000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked"
                                         Color="#99FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver"
                                         Color="#99FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed"
                                         Color="#99FFFFFF"/>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <!-- 页头行 / 统计行 / 内容区 -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 普通页头行：图标 + 名称在左，普通工具栏在右，统计行在下方副行；选择模式下整行让位给
             SelectionHeaderGrid。两个页头 Grid 的外框取值**完全相同**（Margin=16 + Padding="32,16"）：
             左右为 16+32，内容左缘对齐到内容区的 48；上下各为 16+16。行结构亦同为「主行 + 副行」两行
             Auto，故切换选择模式时 Row0 行盒高度不变、内容区零位移。 -->
        <Grid
            x:Name="HeaderGrid"
            Grid.Row="0"
            Margin="16"
            Padding="32,16"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            Visibility="{x:Bind IsSelectionMode, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                MinHeight="32"
                Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">
                <FontIcon
                    Style="{StaticResource PageHeaderIconStyle}"
                    Glyph="{x:Bind ViewModel.PageIconGlyph, Mode=OneWay}"/>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"/>
            </StackPanel>

            <!-- 工具栏宿主：占满剩余宽度。
                 宽度不足时按窗口断点把右侧按钮收进「更多」菜单，用 AdaptiveTrigger + VisualState
                 声明（规范 §2.3【必须】），不在 C# 里监听 SizeChanged 改布局参数。
                 断点取规范档位：≥1008 宽松全显；640~1007 中等收起选择/幻灯片；<640 紧凑再收起排序。 -->
            <Grid
                x:Name="ToolBarHost"
                Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Stretch">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="ToolBarOverflowStates">
                        <VisualState x:Name="WideToolBar">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1008"/>
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="MediumToolBar">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="640"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SelectButton.Visibility"
                                        Value="Collapsed"/>
                                <Setter Target="SlideShowButton.Visibility"
                                        Value="Collapsed"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="NarrowToolBar">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SelectButton.Visibility"
                                        Value="Collapsed"/>
                                <Setter Target="SlideShowButton.Visibility"
                                        Value="Collapsed"/>
                                <Setter Target="SortButton.Visibility"
                                        Value="Collapsed"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <!-- 普通模式工具栏 -->
                <!-- 三个下拉按钮的菜单项在每次 Opening 时按当前状态重建，故勾选态与可用态永远是最新的，
             不必再维护 x:Name 引用去反向同步；「更多」菜单按各按钮当前 Visibility 补齐被收起的命令。 -->
                <StackPanel
                    x:Name="NormalToolBar"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="SelectButton"
                        AutomationProperties.Name="选择"
                        Click="OnSelectClick"
                        Style="{StaticResource ToolBarButtonStyle}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <FontIcon FontSize="16"
                                      Glyph="&#xE73A;"/>
                            <TextBlock Text="选择"/>
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="SlideShowButton"
                        AutomationProperties.Name="幻灯片放映"
                        Click="OnSlideShowClick"
                        IsEnabled="{x:Bind HasItems, Mode=OneWay}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTipService.ToolTip="开始幻灯片放映（F5）">
                        <FontIcon FontSize="16"
                                  Glyph="&#xE786;"/>
                    </Button>

                    <Button
                        x:Name="SortButton"
                        AutomationProperties.Name="排序"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTipService.ToolTip="排序">
                        <Button.Flyout>
                            <MenuFlyout Opening="OnSortMenuOpening"/>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4">
                            <FontIcon FontSize="16"
                                      Glyph="&#xE174;"/>
                            <FontIcon Style="{StaticResource DropDownChevronStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="FilterButton"
                        AutomationProperties.Name="筛选"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTipService.ToolTip="筛选">
                        <Button.Flyout>
                            <MenuFlyout Opening="OnKindMenuOpening"/>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4">
                            <FontIcon FontSize="16"
                                      Glyph="&#xE71C;"/>
                            <FontIcon Style="{StaticResource DropDownChevronStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="ViewModeButton"
                        AutomationProperties.Name="显示和大小"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTipService.ToolTip="显示和大小">
                        <Button.Flyout>
                            <MenuFlyout Opening="OnViewMenuOpening"/>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4">
                            <FontIcon FontSize="16"
                                      Glyph="&#xECA5;"/>
                            <FontIcon Style="{StaticResource DropDownChevronStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="MoreButton"
                        AutomationProperties.Name="更多"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTipService.ToolTip="更多">
                        <Button.Flyout>
                            <MenuFlyout Opening="OnMoreMenuOpening"/>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4">
                            <FontIcon FontSize="16"
                                      Glyph="&#xE712;"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>

            <!-- 统计行（副行）：反映当前筛选结果（类型 / 收藏 / 搜索）的全量规模，而非已加载页数。
                 某一类为 0 时整项不显示，避免出现「0 个视频」这类无信息量的零值。
                 选择模式下随 HeaderGrid 整行隐藏（选择页头不展示统计）。
                 顶距 4 与选择页头副行一致（Grid 无行距属性，行距由副行 Margin 承担）。 -->
            <TextBlock
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,4,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.StatisticsText, Mode=OneWay}"/>
        </Grid>

        <!-- 选择模式工具栏：独占页头行，与普通页头整行 Visibility 互斥。
             卡片式外观与内容区卡片同一对画刷（80% 白底 + 淡描边，圆角取表面档 8）；
             BorderThickness 为内侧绘制、不占布局空间，与页头高度对称无关。
             外框取值与 HeaderGrid 完全相同（Margin=16 + Padding="32,16"）：上下各 16+16，
             左右 16 的外缩（Margin）形成浮层感，配合内部 32 的 Padding 使卡片内容左缘对齐到 48
             （与内容区 ScrollViewer 左右 Padding 一致）。
             切换选择模式时 Row0 行盒高度不变、内容区零位移、零抖动。
             左侧为选择计数标题（「选择项目」/「已选择 N 个项目」）与页名副标题；
             右侧为操作按钮组：删除把选中项移入回收站并经底部通知条展示进度与结果；
             窄窗口时「播放」按断点收进「更多」（含全选 / 取消选择）。 -->
        <Grid
            x:Name="SelectionHeaderGrid"
            Grid.Row="0"
            Margin="16"
            Padding="32,16"
            Background="{ThemeResource PixbianContentCardBackground}"
            BorderBrush="{ThemeResource PixbianContentCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{x:Bind IsSelectionMode, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                MinHeight="32"
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind SelectionCountText, Mode=OneWay}"/>

            <StackPanel
                x:Name="SelectionToolBar"
                Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="SelectionToolBarOverflowStates">
                        <VisualState x:Name="WideSelectionToolBar">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="640"/>
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="NarrowSelectionToolBar">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SelectionPlayButton.Visibility"
                                        Value="Collapsed"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Button
                    AutomationProperties.Name="取消选择"
                    Click="OnCancelSelectionClick"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTipService.ToolTip="取消选择">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon FontSize="16"
                                  Glyph="&#xE711;"/>
                        <TextBlock Text="取消"/>
                    </StackPanel>
                </Button>

                <Button
                    AutomationProperties.Name="删除"
                    Click="OnDeleteSelectionClick"
                    IsEnabled="{x:Bind HasSelection, Mode=OneWay}"
                    Style="{StaticResource ToolBarDeleteButtonStyle}"
                    ToolTipService.ToolTip="删除">
                    <FontIcon FontSize="16"
                              Glyph="&#xE74D;"/>
                </Button>

                <Button
                    AutomationProperties.Name="收藏"
                    Click="OnAddFavoriteClick"
                    IsEnabled="{x:Bind HasSelection, Mode=OneWay}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTipService.ToolTip="收藏">
                    <FontIcon FontSize="16"
                              Glyph="&#xEB51;"/>
                </Button>

                <Button
                    x:Name="SelectionPlayButton"
                    AutomationProperties.Name="播放"
                    Click="OnSlideShowClick"
                    IsEnabled="{x:Bind HasSelection, Mode=OneWay}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTipService.ToolTip="开始幻灯片放映（F5）">
                    <FontIcon FontSize="16"
                              Glyph="&#xE786;"/>
                </Button>

                <Button
                    x:Name="SelectionMoreButton"
                    AutomationProperties.Name="更多"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTipService.ToolTip="更多">
                    <Button.Flyout>
                        <MenuFlyout Opening="OnSelectionMoreMenuOpening"/>
                    </Button.Flyout>
                    <FontIcon FontSize="16"
                              Glyph="&#xE712;"/>
                </Button>
            </StackPanel>

            <!-- 页名副标题（副行）：与普通页头的统计行同位同高（Margin 顶距一致），保证切换选择模式零抖动。 -->
            <TextBlock
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,4,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"/>
        </Grid>

        <!-- 自适应行式视图：ItemsRepeater + JustifiedVirtualizingLayout（P2 虚拟化）。
             外层 ScrollViewer 提供视口（Repeater 的 RealizationRect 依赖它，与 GridView 相反不可删）；
             行几何表一次建表 O(n)，只 realize 视口覆盖的行——切换与滚动成本 O(视口)。
             无内建选择机制：选择由 GallerySelectionService 经 VM.IsSelected 驱动模板视觉。 -->
        <ScrollViewer
            x:Name="JustifiedView"
            Grid.Row="2"
            Tapped="OnItemTapped"
            Padding="48,0,48,16"
            Visibility="{x:Bind IsJustifiedView, Mode=OneWay}"
            ViewChanged="OnScrollViewChanged">
            <ItemsRepeater
                x:Name="JustifiedRepeater"
                VerticalAlignment="Top"
                ElementPrepared="OnJustifiedElementPrepared"
                DoubleTapped="OnItemDoubleTapped"
                RightTapped="OnItemRightTapped"
                PointerMoved="OnJustifiedPointerMoved"
                PointerExited="OnJustifiedPointerExited"
                ItemTemplate="{StaticResource JustifiedRepeaterItemTemplate}"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <controls:JustifiedVirtualizingLayout
                        x:Name="JustifiedLayout"
                        Spacing="12"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- 方形网格视图：GridView 自滚（ItemsWrapGrid 原生虚拟化），外层不再包 ScrollViewer。
             GridView 默认是「横向滚动列表」（项垂直流动成列），必须显式翻转：
             ItemsWrapGrid.Orientation=Horizontal（行式排列、纵向换行）+ 滚动改为纵向。
             格子边长由代码后置按视口宽度动态计算（ItemsWrapGrid.ItemWidth），
             「滚动条出现/消失 ↔ 宽度变化」震荡以每行个数（perRow）门控阻断。 -->
        <GridView
            x:Name="GridViewControl"
            Grid.Row="2"
            Padding="48,0,48,16"
            Visibility="{x:Bind IsGridView, Mode=OneWay}"
            Loaded="OnGridViewControlLoaded"
            ScrollViewer.HorizontalScrollMode="Disabled"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollMode="Enabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ContainerContentChanging="OnContainerContentChanging"
            DoubleTapped="OnItemDoubleTapped"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            RightTapped="OnItemRightTapped"
            Tapped="OnItemTapped"
            ItemTemplate="{StaticResource MediaItemTemplate}"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Extended">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin"
                            Value="0"/>
                    <Setter Property="Padding"
                            Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridViewItem">
                                <!-- Margin 承担条目间距（ItemsWrapGrid 无间距属性）：相邻容器 4+4=8px，
                                         与原 SquarePanel Spacing 一致；外缘 4px 并入 Padding 的视觉余量。 -->
                                <Grid Margin="4">
                                    <ContentPresenter/>
                                    <Border
                                        x:Name="MaskBorder"
                                        Background="Black"
                                        CornerRadius="4"
                                        Opacity="0"/>
                                    <!-- 选中外框：绑容器 IsSelected（ControlTemplate 内 TemplatedParent 传统 Binding，
                                             运行时解析转换器、属性通知即时；模板内 x:Bind + Converter 会启动崩溃）。 -->
                                    <Border
                                        x:Name="SelectionRing"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="2"
                                        CornerRadius="4"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
                                    <!-- 复选框：两档白衬底画在勾选方框**内部**（覆盖方框填充主题键，未选中默认透明），
                                             右上角悬浮；普通模式 hover 浮现（VisualState 驱动），选择模式经绑定常显；
                                             衬底与描边取值随主题（浅色白衬底 / 深色黑衬底 + 白描边，见 CheckBox.Resources）。 -->
                                    <CheckBox
                                        x:Name="SelectionCheck"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,4,4,0"
                                        MinWidth="0"
                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                        Opacity="{Binding Data.IsSelectionMode, Source={StaticResource PageProxy}, Converter={StaticResource BoolToSelectionOpacity}, Mode=OneWay}"
                                        IsHitTestVisible="{Binding Data.IsSelectionMode, Source={StaticResource PageProxy}, Converter={StaticResource BoolToSelectionHitTest}, Mode=OneWay}">
                                        <CheckBox.Resources>
                                            <!-- 衬底常态与描边三态：用「SolidColorBrush + ThemeResource Color」
                                                     而非 StaticResource 别名——别名只在加载（启动主题）解析一次，
                                                     切换主题后仍钉死旧画刷（深色下曾因此看不到边框）。
                                                     三档 Color 键定义在本页根 Grid 的主题字典，随主题重新求值：
                                                     浅色 衬底 60%/80% 白 + 描边 45% 黑；深色 衬底 30%/50% 黑 + 描边 60% 白。
                                                     描边三态同值：按下时反馈由衬底加深承担，描边若按系统默认淡下去会闪断。 -->
                                            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked"
                                                             Color="{ThemeResource PixbianItemCheckBackdropSubtleColor}"/>
                                            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver"
                                                             Color="{ThemeResource PixbianItemCheckBackdropColor}"/>
                                            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed"
                                                             Color="{ThemeResource PixbianItemCheckBackdropColor}"/>
                                            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked"
                                                             Color="{ThemeResource PixbianItemCheckStrokeColor}"/>
                                            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver"
                                                             Color="{ThemeResource PixbianItemCheckStrokeColor}"/>
                                            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed"
                                                             Color="{ThemeResource PixbianItemCheckStrokeColor}"/>
                                        </CheckBox.Resources>
                                    </CheckBox>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="MaskBorder.Opacity"
                                                            Value="0.05"/>
                                                    <!-- State Setter 优先于本地绑定值：普通模式下复选框默认
                                                             透明且不参与命中测试，hover 时浮现并可点击；
                                                             选择模式下绑定值本就是显示与可点，Setter 同值无副作用。 -->
                                                    <Setter Target="SelectionCheck.Opacity"
                                                            Value="1"/>
                                                    <Setter Target="SelectionCheck.IsHitTestVisible"
                                                            Value="True"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="MaskBorder.Opacity"
                                                            Value="0.08"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--
                            方形网格用内建 ItemsWrapGrid：原生 UI 虚拟化，容器数恒定。
                            Orientation=Horizontal 为行式排列（横向填满一行后纵向换行）——
                            GridView 默认 Vertical 是列式（横向滚动），必须显式覆盖。
                            边长（ItemWidth/ItemHeight）由页面按视口宽度动态计算写入；
                            间距由容器模板 Margin 承担（ItemsWrapGrid 无间距属性），
                            条目模板不带 Margin，内容区宽高比才与位图一致。
                        -->
                    <ItemsWrapGrid Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>

        <!-- 空 / 加载状态：与 MainWindow 的 LoadingOverlay 同构——外层 Grid 占满内容区行
             （Row 2，Height="*"），内层 StackPanel 双向 Center，窗口尺寸变化时自动居中。
             【关键前提】PageHost（MainWindow 的 ContentControl）必须显式
             VerticalAlignment/VerticalContentAlignment=Stretch——其默认值为 Top，
             会让整个 Page 按内容高度收缩（空目录时整页只有 ~190px，`*` 行塌缩，
             任何居中设置都无效——即此前「空状态贴顶不居中」的根因）。
             Foreground 必须是画刷（曾误填 Style 名 TitleTextBlockStyle 导致类型错误）；
             Style 只能用已定义的文本样式——TitleTextBlockFontSize / BodyTextBlockFontSize
             并非本项目资源，StaticResource 解析失败会让应用启动即崩。 -->
        <Grid Grid.Row="2"
              Visibility="{x:Bind ShowEmptyState, Mode=OneWay}">
            <!-- 三态由页面 ShowEmptyState / EmptyStateTitle 驱动（见 GalleryPage.xaml.cs）：
                 查询中 → 整区隐藏，由窗口层 LoadingOverlay 接管；真空目录 → 标题 + 副文案；
                 加载失败 → 标题切为「加载失败，请重试」，副文案隐藏。
                 本 Grid 声明在两个视图 ScrollViewer 之后（z 序更高）且背景透明，
                 缺可见性绑定会让空状态文字永久浮在列表上（已发生过的缺陷）。
                 对齐 Windows 照片应用的空状态观感：文字块位于内容区正中偏上；
                 对称 Margin 的下边距 128 使视觉中心从几何中心上移 64px，
                 窗口尺寸变化时偏移量恒定，仍属自动居中而非数值定位。 -->
            <StackPanel
                Margin="0,0,0,128"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical"
                Spacing="8">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind EmptyStateTitle, Mode=OneWay}"/>
                <TextBlock
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyMediumTextBlockStyle}"
                    Text="请选择一个文件夹，或调整「筛选器」以显示更多内容。"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ShowEmptySubtitle, Mode=OneWay}"/>
            </StackPanel>
        </Grid>

        <!-- 加载覆盖层已上移到窗口层（MainWindow.xaml 的 LoadingOverlay，PageHost 兄弟位）：
             页面内同格覆盖层会与 GridView 大重排在同一布局容器内交替失效，是历史 LayoutCycle
             的结构成因；窗口层与其彻底解耦，且撤层时机同为 IsQuerying（首屏就绪）。 -->

        <!-- 删除通知条：悬浮于内容区底部。进行中为「图标 + 文本 + 进度条 + 取消」，
             结束后切换为结果提示（5 秒自动消失，亦可手动关闭），整体可见性由 VM 聚合属性驱动。 -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,24"
            Padding="16,12"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{x:Bind ViewModel.IsDeleteNotificationVisible, Mode=OneWay}">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="16"
                    Glyph="&#xE74D;"/>

                <!-- 进度块 -->
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Vertical"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsDeleteInProgress, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.DeleteProgressText, Mode=OneWay}"/>
                    <ProgressBar
                        Width="280"
                        Maximum="{x:Bind ViewModel.DeleteProgressMaximum, Mode=OneWay}"
                        Value="{x:Bind ViewModel.DeleteProgressValue, Mode=OneWay}"/>
                </StackPanel>

                <!-- 结果块 -->
                <TextBlock
                    VerticalAlignment="Center"
                    MaxWidth="480"
                    TextWrapping="Wrap"
                    Text="{x:Bind ViewModel.DeleteResultText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsDeleteResultVisible, Mode=OneWay}"/>

                <Button
                    Click="OnCancelDeleteClick"
                    Content="取消"
                    Visibility="{x:Bind ViewModel.IsDeleteInProgress, Mode=OneWay}"/>
                <Button
                    AutomationProperties.Name="关闭"
                    Click="OnCloseDeleteResultClick"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTipService.ToolTip="关闭"
                    Visibility="{x:Bind ViewModel.IsDeleteResultVisible, Mode=OneWay}">
                    <FontIcon FontSize="16"
                              Glyph="&#xE711;"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
