<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Pixbian.Data</RootNamespace>
    <AssemblyName>Pixbian.Data</AssemblyName>
    <Description>Pixbian 数据访问层：SQLite 连接管理、Schema 迁移与仓储实现，全部使用参数化查询。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="$(SqliteVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pixbian.Core\Pixbian.Core.csproj" />
  </ItemGroup>

</Project>
