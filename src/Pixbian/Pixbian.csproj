<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- 兼容基线：Windows 10 1809 (Build 17763) -->
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <!--
      CsWinRT 用 CsWinRTWindowsMetadata 定位 Windows SDK 元数据（默认取 WindowsSDKVersion，
      即 TFM 里的 26100），并读取其 Platforms\UAP\<版本>\Platform.xml。本机只安装了
      10.0.19041.0 的 Windows SDK，26100 的 Platform.xml 不存在 → cswinrt.exe 以退出码 1 失败，
      并连锁引发一批 XAML 假错误。此处显式指向已安装的版本（该属性为空时才会被默认值覆盖，
      故项目内赋值有效）。TFM 与兼容基线（17763）均不变；安装 Windows SDK 26100 后可删除本行。
    -->
    <CsWinRTWindowsMetadata>10.0.19041.0</CsWinRTWindowsMetadata>

    <!--
      将中间输出目录基址改为项目目录绝对路径。默认 BaseIntermediateOutputPath=obj\ 为相对路径，
      在 dotnet Core 宿主多进程构建下，MarkupCompilePass1 的 Exec 调用 XamlCompiler.exe 时工作目录
      为仓库根目录而非项目目录，导致相对路径 obj\x64\...\input.json 找不到而静默退出码 1（MSB3073）。
      绝对化后所有派生的 XAML 编译器 JSON 路径不再依赖进程工作目录。
    -->
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\</BaseIntermediateOutputPath>

    <!--
      WindowsAppSDK 自包含要求明确的 Windows 架构，默认的 AnyCPU 会直接报
      "WindowsAppSDKSelfContained requires a supported Windows architecture"。
      此处把 AnyCPU 重定向到 x64，使 dotnet run / dotnet build 不带参数即可正常工作；
      构建 ARM64 时仍可用 -p:Platform=ARM64 覆盖。
      注意：这行必须写在 csproj 内。Directory.Build.props 先于 SDK 设置默认 Platform 导入，
      写在那里会被后续的默认值覆盖而失效。
    -->
    <Platform Condition="'$(Platform)' == 'AnyCPU'">x64</Platform>

    <!--
      FFmpegInteropX 的 FFmpegInteropX.dll 与 avcodec/avformat/avutil 等原生库位于包的
      runtimes\<rid>\native\ 下，只有在项目具有 RID 时才会被复制进输出并被运行期解析到；
      缺失时 FFmpeg 解码会在运行期静默失败（回退系统解码器）。故按平台显式指定 RID
      （构建 ARM64 时用 -p:Platform=ARM64 覆盖，与上方 Platform 重定向一致）。
    -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RootNamespace>Pixbian</RootNamespace>
    <AssemblyName>Pixbian</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe 内嵌图标：资源管理器、任务栏等场景使用，由编译期嵌入 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- WinUI 3 启用 -->
    <UseWinUI>true</UseWinUI>

    <!--
      在 dotnet（Core 宿主）构建下，WindowsAppSDK 会启动 net472 的 XamlCompiler.exe。
      2.x 将 XAML 编译器拆到 Microsoft.WindowsAppSDK.WinUI 组件包，旧的 PkgMicrosoft_WindowsAppSDK
      属性已不再生成（取值为空），沿用会拼出不存在的路径并静默失败。此处改用组件包的路径属性。
      net10 SDK 起 Exec 的工作目录是构建启动目录而非项目目录，而 XAML 页面以项目相对路径传入
      编译器（按 CWD 解析）——从仓库根构建 sln 时所有页面解析失败（WMC0001/WMC9999）。
      故把 XamlCompilerExePath 指向生成的包装脚本：先 cd 到项目目录再启动真实编译器，
      使页面解析与构建启动目录解耦（真机路径由 GenerateXamlCompilerWrapper target 写入）。
    -->
    <_RealXamlCompilerExePath>$(PkgMicrosoft_WindowsAppSDK_WinUI)\tools\net472\XamlCompiler.exe</_RealXamlCompilerExePath>
    <XamlCompilerExePath>$(BaseIntermediateOutputPath)XamlCompilerWrapper.cmd</XamlCompilerExePath>

    <!-- 非打包自包含发布：无需 MSIX 签名证书，可直接 dotnet run 与 xcopy 部署 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>

    <!-- 自包含模式下 RID 相关提示属于预期行为 -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
    <!--
      MVVMTK0045 建议把 [ObservableProperty] 从字段改为 partial property，以适配 WinRT 场景下的
      AOT 封送代码生成。partial property（C# 13）在 LangVersion 升 13 后已可编译，但需逐一改造
      全部 [ObservableProperty] 字段。本应用未启用 AOT 发布，该提示不影响运行，
      在完成迁移前先关闭（迁移完成后移除本豁免）。
    -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
    <!--
      CsWinRT1028：要求实现 WinRT 接口的自定义类型标记 partial，仅服务于 trimming 与 AOT 兼容。
      本应用未启用 AOT 发布（与上方 MVVMTK0045 同一前提）；满足它需给 SquarePanel、JustifiedPanel、
      ThumbnailPresenter、两个转换器与 ThinAcrylicBackdrop 共 6 处声明加 partial，属无功能收益的
      机械改动，故在此豁免。该诊断是引入 FFmpegInteropX（新增 winmd 输入）后 CsWinRT 开始
      检查项目内类型才出现的。若日后启用 AOT/ trimming，应移除本行并补齐 partial。
    -->
    <NoWarn>$(NoWarn);CsWinRT1028</NoWarn>
  </PropertyGroup>

  <!--
    标题栏图标（AppWindow.Icon）由代码按磁盘路径加载，故 app.ico 必须随构建复制到输出目录。
  -->
  <ItemGroup>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      稀疏包清单按「输出目录下的相对路径」引用徽标 PNG（外部位置解析），故 PNG 必须随构建复制。
      通配只取 png：psd 属设计源文件，进输出目录只会徒增体积。
    -->
    <Content Include="Assets\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 调度器的提交节拍器抽象走 internal 构造，仅供 UI 测试项目注入假节拍器。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="Pixbian.UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFmpegInteropX" Version="2.1.0.81200" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSdkVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(CommunityToolkitMvvmVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(DependencyInjectionVersion)" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="$(CachingMemoryVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(LoggingAbstractionsVersion)" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="$(ProtectedDataVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pixbian.Core\Pixbian.Core.csproj" />
    <ProjectReference Include="..\Pixbian.Data\Pixbian.Data.csproj" />
    <ProjectReference Include="..\Pixbian.Imaging\Pixbian.Imaging.csproj" />
    <ProjectReference Include="..\Pixbian.Media\Pixbian.Media.csproj" />
    <ProjectReference Include="..\Pixbian.WebServer\Pixbian.WebServer.csproj" />
  </ItemGroup>

  <!--
    unpackaged WinUI 3 的 dotnet publish 不会复制应用资源索引（$(AssemblyName).pri），
    缺失时运行期所有 StaticResource（如 TitleTextBlockStyle）解析失败直接崩溃，
    而 Debug 构建不受影响（bin 输出含 PRI），极具迷惑性。此处显式纳入发布清单。
  -->
  <Target Name="IncludeProjectPriInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(OutDir)$(AssemblyName).pri">
        <RelativePath>$(AssemblyName).pri</RelativePath>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    生成 XAML 编译器包装脚本（内容见 XamlCompilerExePath 属性处注释）：
    %22 转义引号、%25 转义 %，保证 %* 原样透传给真实编译器。
    BeforeTargets 列出 XAML 编译全部入口（不存在的目标名会被 MSBuild 静默忽略）。
  -->
  <ItemGroup>
    <_XamlCompilerWrapperLine Include="@echo off" />
    <_XamlCompilerWrapperLine Include="cd /d %22$(MSBuildProjectDirectory)%22" />
    <_XamlCompilerWrapperLine Include="%22$(_RealXamlCompilerExePath)%22 %25*">
      <Visible>false</Visible>
    </_XamlCompilerWrapperLine>
  </ItemGroup>
  <Target Name="GenerateXamlCompilerWrapper"
          BeforeTargets="DesignTimeMarkupCompilationCT;MarkupCompilePass1;MarkupCompilePass2">
    <MakeDir Directories="$(BaseIntermediateOutputPath)"/>
    <WriteLinesToFile File="$(XamlCompilerExePath)"
                      Lines="@(_XamlCompilerWrapperLine)"
                      Overwrite="true"
                      Encoding="ascii"/>
  </Target>

</Project>
