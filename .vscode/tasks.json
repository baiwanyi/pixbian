{
    // 构建任务：使用本机绝对 dotnet 路径（PATH 未包含 dotnet 时回退），避免依赖 shell 环境。
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "C:\\Program Files\\dotnet\\dotnet.exe",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/Pixbian/Pixbian.csproj",
                "-c",
                "Debug",
                "--nologo"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
